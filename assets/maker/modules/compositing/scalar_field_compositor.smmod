{
  "schema_version": 1,
  "id": "screenshaver.compositing.scalar_field_compositor",
  "name": "Scalar Field Compositor",
  "category": "Compositing",
  "created_by": "Screenshaver",
  "description": "Combines two scalar fields using selectable arithmetic operations.",
  "uses": "Field layering, mask intersections, procedural blending, and modulation.",
  "notes": "Modes are Add, Multiply, Maximum, Minimum, and Subtract (A-B). Clamp Output limits the result to 0..1.",
  "header_color": "#429F91",
  "inputs": [
    {
      "id": "field_a",
      "name": "Field A",
      "type": "float",
      "default": "maker_uv.x"
    },
    {
      "id": "field_b",
      "name": "Field B",
      "type": "float",
      "default": "maker_uv.y"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Combined Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "mode",
      "name": "Operation",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 4,
      "options": [
        "Add",
        "Multiply",
        "Maximum",
        "Minimum",
        "Subtract"
      ]
    },
    {
      "id": "clamp_output",
      "name": "Clamp Output",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "No",
        "Yes"
      ]
    }
  ],
  "helpers": "float maker_comp_scalar(float a,float b,float mode,float clamp_output){\n float v=a+b;\n if(mode>=0.5&&mode<1.5)v=a*b;\n else if(mode>=1.5&&mode<2.5)v=max(a,b);\n else if(mode>=2.5&&mode<3.5)v=min(a,b);\n else if(mode>=3.5)v=a-b;\n return clamp_output>=0.5?clamp(v,0.0,1.0):v;\n}",
  "terminal": false,
  "glsl": "maker_comp_scalar({field_a},{field_b},{mode},{clamp_output})"
}
