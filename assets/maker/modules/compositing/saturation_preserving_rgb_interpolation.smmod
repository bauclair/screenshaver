{
  "schema_version": 1,
  "id": "screenshaver.compositing.saturation_preserving_rgb_interpolation",
  "name": "Saturation-Preserving RGB Interpolation",
  "category": "Compositing",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Blend RGB with optional saturation restoration.",
  "uses": "Blend RGB with optional saturation restoration.",
  "notes": "Inputs are clamped to display RGB. Achromatic blends stay neutral. Luminance preservation limits correction to the RGB gamut. Endpoints remain unchanged within display range.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "color_a",
      "name": "Color A",
      "type": "vec3",
      "default": "vec3(1.0,0.0,0.0)",
      "semantic_role": "color"
    },
    {
      "id": "color_b",
      "name": "Color B",
      "type": "vec3",
      "default": "vec3(0.0,0.0,1.0)",
      "semantic_role": "color"
    },
    {
      "id": "blend",
      "name": "Blend Factor",
      "type": "float",
      "default": "0.5"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Blended Color",
      "type": "vec3",
      "semantic_role": "color"
    },
    {
      "id": "conventional",
      "name": "Conventional Blend",
      "type": "vec3",
      "semantic_role": "color"
    },
    {
      "id": "saturation",
      "name": "Resulting Saturation",
      "type": "float"
    },
    {
      "id": "loss",
      "name": "Saturation Loss",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "strength",
      "name": "Preservation Strength",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "id": "target",
      "name": "Saturation Target",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "Interpolated",
        "Maximum"
      ]
    },
    {
      "id": "brightness",
      "name": "Brightness Preservation",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "Value",
        "Luminance"
      ]
    },
    {
      "id": "response",
      "name": "Blend Response",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "Linear",
        "Smooth"
      ]
    }
  ],
  "helpers": "struct MakerSPI {vec3 color;vec3 conventional;float saturation;float loss;};\nfloat maker_spi_sat(vec3 c){float hi=max(c.r,max(c.g,c.b));return (hi-min(c.r,min(c.g,c.b)))/max(hi,1e-8);}\nMakerSPI maker_spi(vec3 a,vec3 b,float t,float strength,float target,float brightness,float response){\n if(any(isnan(a))||any(isinf(a))||any(isnan(b))||any(isinf(b))||isnan(t)||isinf(t))return MakerSPI(vec3(0),vec3(0),0.,0.);\n a=clamp(a,0.,1.);b=clamp(b,0.,1.);t=clamp(t,0.,1.);if(response>.5)t=t*t*(3.-2.*t);\n vec3 c=mix(a,b,t);float sat=maker_spi_sat(c),goal=target<.5?mix(maker_spi_sat(a),maker_spi_sat(b),t):max(maker_spi_sat(a),maker_spi_sat(b));float loss=max(0.,goal-sat);vec3 outc=c;\n if(t>0.&&t<1.&&sat>1e-6){float desired=sat+strength*loss;float hi=max(c.r,max(c.g,c.b));vec3 v=vec3(hi)-(vec3(hi)-c)*(desired/sat);\n if(brightness>.5){vec3 weights=vec3(.2126,.7152,.0722);float l=dot(c,weights);vec3 delta=v-vec3(dot(v,weights));float k=1.;for(int i=0;i<3;i++){if(delta[i]>0.)k=min(k,(1.-l)/delta[i]);else if(delta[i]<0.)k=min(k,-l/delta[i]);}v=vec3(l)+k*delta;}outc=clamp(v,0.,1.);}\n return MakerSPI(outc,c,maker_spi_sat(outc),loss);\n}",
  "glsl_outputs": {
    "color": "maker_spi({color_a},{color_b},{blend},{strength},{target},{brightness},{response}).color",
    "conventional": "maker_spi({color_a},{color_b},{blend},{strength},{target},{brightness},{response}).conventional",
    "saturation": "maker_spi({color_a},{color_b},{blend},{strength},{target},{brightness},{response}).saturation",
    "loss": "maker_spi({color_a},{color_b},{blend},{strength},{target},{brightness},{response}).loss"
  }
}
