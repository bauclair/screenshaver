{
  "schema_version": 1,
  "id": "screenshaver.test.reference_color",
  "name": "Reference Color Pattern",
  "category": "Test",
  "created_by": "Screenshaver",
  "header_color": "#537D89",
  "description": "Known RGB calibration pattern.",
  "uses": "Test color transforms, channel mapping, clipping and contrast.",
  "notes": "Spatial patterns use centered Maker UV. RGB gradients are bounded to 0..1. All patterns are stationary.",
  "inputs": [],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3",
      "semantic_role": "color"
    }
  ],
  "parameters": [
    {
      "id": "pattern",
      "name": "Pattern",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 3,
      "options": [
        "RGB Gradient",
        "Grayscale Ramp",
        "Color Bars",
        "Checkerboard"
      ]
    },
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 4,
      "min": 1,
      "max": 24
    }
  ],
  "helpers": "vec3 maker_test_color(vec2 uv,float pattern,float frequency){vec2 p=clamp(uv+0.5,0.0,1.0);if(pattern<0.5)return vec3(p.x,p.y,1.0-p.x);if(pattern<1.5)return vec3(p.x);if(pattern<2.5){float k=floor(clamp(p.x,0.0,0.999999)*6.0);return k<0.5?vec3(1,0,0):k<1.5?vec3(0,1,0):k<2.5?vec3(0,0,1):k<3.5?vec3(1,1,0):k<4.5?vec3(0,1,1):vec3(1,0,1);}float k=mod(floor(p.x*frequency)+floor(p.y*frequency),2.0);return vec3(k);}",
  "glsl": "maker_test_color(maker_uv,{pattern},{frequency})",
  "terminal": false
}
