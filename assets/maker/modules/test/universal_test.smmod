{
  "schema_version": 1,
  "id": "screenshaver.test.universal_test",
  "name": "Universal Test",
  "category": "Test",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#537D89",
  "description": "Universal diagnostic module with adjustable sampling and independent callable 2D/3D producers.",
  "uses": "Use position reference to test normal estimation, or connect callable Field 2D / Field 3D outputs to other diagnostic instances for deterministic field sampling.",
  "notes": "X/Y/Z and UV X/Y parameters are adjustable. Callable 2D/3D inputs are optional and default to a deterministic radial/circular field. The preview prioritizes Field 3D, Field 2D, then the original diagnostic inputs. Position Reference uses configured sample position rather than screen coordinates. Callable producer outputs are independent: 2D evaluates length(p)-1.0; 3D evaluates length(p)-1.0. Output Color is the bottom connector.",
  "inputs": [
    {
      "id": "scalar",
      "name": "Scalar Result",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "vector2",
      "name": "Vector 2D Result",
      "type": "vec2",
      "default": "vec2(0.0)"
    },
    {
      "id": "vector3",
      "name": "Vector 3D Result",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "color",
      "name": "Color Result",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "color"
    },
    {
      "id": "distance",
      "name": "Distance Result",
      "type": "float",
      "default": "0.0",
      "semantic_role": "distance"
    },
    {
      "id": "field2d",
      "name": "Field 2D",
      "type": "field2d",
      "default": "maker_universal_field2d_fallback"
    },
    {
      "id": "field3d",
      "name": "Field 3D",
      "type": "field3d",
      "default": "maker_universal_field3d_fallback"
    }
  ],
  "outputs": [
    {
      "id": "scalar_ref",
      "name": "Scalar Reference",
      "type": "float",
      "semantic_role": "intensity"
    },
    {
      "id": "uv_ref",
      "name": "UV Reference",
      "type": "vec2",
      "semantic_role": "uv"
    },
    {
      "id": "position_ref",
      "name": "3D Position Reference",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "color_ref",
      "name": "Color Reference",
      "type": "vec3",
      "semantic_role": "color"
    },
    {
      "id": "distance_ref",
      "name": "Distance Reference",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "preview_color",
      "name": "Output Color",
      "type": "vec3",
      "semantic_role": "color"
    },
    {
      "id": "sample2d",
      "name": "Field 2D Sample",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "sample3d",
      "name": "Field 3D Sample",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "producer2d",
      "name": "Callable Field 2D",
      "type": "field2d"
    },
    {
      "id": "producer3d",
      "name": "Callable Field 3D",
      "type": "field3d"
    }
  ],
  "parameters": [
    {
      "id": "sample_x",
      "name": "Sample X",
      "type": "float",
      "default": 1.0,
      "min": -4.0,
      "max": 4.0
    },
    {
      "id": "sample_y",
      "name": "Sample Y",
      "type": "float",
      "default": 0.0,
      "min": -4.0,
      "max": 4.0
    },
    {
      "id": "sample_z",
      "name": "Sample Z",
      "type": "float",
      "default": 0.0,
      "min": -4.0,
      "max": 4.0
    },
    {
      "id": "uv_x",
      "name": "Sample UV X",
      "type": "float",
      "default": 1.0,
      "min": -4.0,
      "max": 4.0
    },
    {
      "id": "uv_y",
      "name": "Sample UV Y",
      "type": "float",
      "default": 0.0,
      "min": -4.0,
      "max": 4.0
    }
  ],
  "helpers": "float maker_universal_scalar(vec2 uv){return 0.5+0.5*sin(uv.x*12.566370614359172);}\nvec3 maker_universal_color(vec2 uv){return vec3(clamp(uv.x+0.5,0.0,1.0),clamp(uv.y+0.5,0.0,1.0),maker_universal_scalar(uv));}\nvec3 maker_universal_signed(float v){return v<0.0?vec3(0.05,0.18,0.65)*clamp(-v,0.0,1.0):vec3(0.95,0.48,0.07)*clamp(v,0.0,1.0);}\nfloat maker_universal_field2d_fallback(vec2 p){return length(p)-1.0;}\nfloat maker_universal_field3d_fallback(vec3 p){return length(p)-1.0;}\n",
  "glsl_outputs": {
    "scalar_ref": "maker_universal_scalar(maker_uv)",
    "uv_ref": "vec2({uv_x},{uv_y})",
    "position_ref": "vec3({sample_x},{sample_y},{sample_z})",
    "color_ref": "maker_universal_color(maker_uv)",
    "distance_ref": "length(vec3(maker_uv,0.0)-vec3(0.0,0.0,1.0))-0.65",
    "preview_color": "maker_universal_color(maker_uv)",
    "sample2d": "{field2d}(vec2({uv_x},{uv_y}))",
    "sample3d": "{field3d}(vec3({sample_x},{sample_y},{sample_z}))",
    "producer2d": "maker_universal_field2d_fallback",
    "producer3d": "maker_universal_field3d_fallback"
  },
  "terminal": false
}
