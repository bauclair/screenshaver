{
  "schema_version": 1,
  "id": "screenshaver.test.vector_display",
  "name": "Vector Display",
  "category": "Test",
  "created_by": "Screenshaver",
  "header_color": "#537D89",
  "description": "Fixed-scale vector component visualization.",
  "uses": "Inspect signed 3D vectors and directional transformations.",
  "notes": "Displays X/Y/Z as R/G/B. Default offset 0.5 maps zero to middle gray; clipping is visible at Output Color.",
  "inputs": [
    {
      "id": "vector",
      "name": "Vector",
      "type": "vec3"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3",
      "semantic_role": "color"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "offset",
      "name": "Offset",
      "type": "float",
      "default": 0.5,
      "min": -2,
      "max": 2
    }
  ],
  "helpers": "",
  "glsl": "vec3({offset})+{vector}*{scale}",
  "terminal": false
}
