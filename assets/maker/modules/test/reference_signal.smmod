{
  "schema_version": 1,
  "id": "screenshaver.test.reference_signal",
  "name": "Reference Signal Generator",
  "category": "Test",
  "created_by": "Screenshaver",
  "header_color": "#537D89",
  "description": "Deterministic spatial or temporal calibration waveform.",
  "uses": "Feed known signals into scalar processors and compare their responses.",
  "notes": "Waveforms are bipolar before amplitude and offset. Time Rate=0 freezes the signal. Frequency is cycles per Maker UV unit. Ramp is a centered linear ramp; sawtooth repeats.",
  "inputs": [],
  "outputs": [
    {
      "id": "signal",
      "name": "Signal",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "wave",
      "name": "Waveform",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 5,
      "options": [
        "Sine",
        "Triangle",
        "Square",
        "Sawtooth",
        "Ramp",
        "Constant"
      ]
    },
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 2,
      "min": 0,
      "max": 12
    },
    {
      "id": "amplitude",
      "name": "Amplitude",
      "type": "float",
      "default": 0.4,
      "min": 0,
      "max": 2
    },
    {
      "id": "phase",
      "name": "Phase (Degrees)",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "offset",
      "name": "Offset",
      "type": "float",
      "default": 0.5,
      "min": -2,
      "max": 2
    },
    {
      "id": "time_rate",
      "name": "Time Rate",
      "type": "float",
      "default": 0,
      "min": -5,
      "max": 5
    }
  ],
  "helpers": "float maker_test_signal(float x,float wave,float freq,float amp,float phase,float offset,float time_shift){float q=x*freq+phase/360.0+time_shift;float f=fract(q);float s=sin(6.283185307179586*q);float tri=1.0-4.0*abs(f-0.5);float sq=(f<0.5?1.0:-1.0);float saw=2.0*f-1.0;float ramp=2.0*q-1.0;float v=wave<0.5?s:wave<1.5?tri:wave<2.5?sq:wave<3.5?saw:wave<4.5?ramp:1.0;return offset+amp*v;}",
  "glsl": "maker_test_signal(maker_uv.x,{wave},{frequency},{amplitude},{phase},{offset},u_time*{time_rate})",
  "terminal": false
}
