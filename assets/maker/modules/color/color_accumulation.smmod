{
  "schema_version": 1,
  "id": "screenshaver.color.field_accumulation",
  "name": "Color Accumulation",
  "category": "Color",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#A27660",
  "description": "Adjusts brightness and contrast of accumulated procedural light.",
  "uses": "Convert traversal illumination into vivid, controllable colors.",
  "notes": "General gain/contrast or squared illumination. In squared mode Gain=3 and Contrast=1.3 are neutral; both remain adjustable.",
  "inputs": [
    {
      "id": "light",
      "name": "Light",
      "type": "vec3",
      "default": "vec3(0.0)"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "gain",
      "name": "Gain",
      "type": "float",
      "default": 3.0,
      "min": 0.0,
      "max": 12.0
    },
    {
      "id": "contrast",
      "name": "Contrast",
      "type": "float",
      "default": 1.3,
      "min": 0.25,
      "max": 3.0
    },
    {
      "id": "mode",
      "name": "Processing Mode",
      "type": "choice",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "options": [
        "Gain / contrast",
        "Squared light"
      ]
    }
  ],
  "helpers": "",
  "glsl": "mix(pow(max({light}*{gain},vec3(0.0)),vec3({contrast})),pow(max(({light}*{light})/500.0*({gain}/3.0),vec3(0.0)),vec3({contrast}/1.3)),step(0.5,{mode}))",
  "terminal": false
}
