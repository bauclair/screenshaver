{
  "schema_version": 1,
  "id": "screenshaver.color.weighted_rgb_colorizer",
  "name": "Weighted RGB Colorizer",
  "category": "Color",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#B46A35",
  "description": "Maps a scalar value to a configurable RGB gradient using channel-dependent weights.",
  "uses": "Gold-like plasma coloration, tinted scalar fields, and nonperiodic color mapping.",
  "notes": "Independent color-gradient implementation, not the 24K weighted subtraction formula. The base color, two channel weights and intensity remain configurable.",
  "inputs": [
    {
      "id": "value",
      "name": "Value",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "base_color",
      "name": "Base Color",
      "type": "color3",
      "default": [
        0.299,
        0.587,
        0.114
      ]
    },
    {
      "id": "red_green",
      "name": "Red: Green Weight",
      "type": "float",
      "default": 2,
      "min": 0,
      "max": 5
    },
    {
      "id": "green_blue",
      "name": "Green: Blue Weight",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 5
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 5
    }
  ],
  "helpers": "vec3 maker_weighted_gradient(float v,vec3 base,float rg,float gb,float intensity){float x=clamp(0.5+0.5*tanh(v),0.0,1.0);vec3 target=vec3(clamp(base.r+0.15*rg,0.0,1.0),clamp(base.g+0.15*gb,0.0,1.0),clamp(base.b+0.12*(rg+gb),0.0,1.0));return clamp(mix(base,target,x)*intensity,0.0,1.0);}",
  "glsl": "maker_weighted_gradient({value},{base_color},{red_green},{green_blue},{intensity})",
  "terminal": false
}
