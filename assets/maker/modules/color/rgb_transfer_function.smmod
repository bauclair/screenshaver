{
  "schema_version": 1,
  "id": "screenshaver.color.rgb_transfer_function",
  "name": "RGB Transfer Function",
  "category": "Color",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Explicit per-channel linear-light and encoded RGB conversion.",
  "uses": "Explicit per-channel linear-light and encoded RGB conversion.",
  "notes": "Clamp mode restricts inputs to [0,1]. Extended mode preserves sign and allows HDR values up to magnitude 10000. No automatic renderer conversion. Gamma Encode uses reciprocal gamma.",
  "header_color": "#A07652",
  "terminal": false,
  "inputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3",
      "semantic_role": "color",
      "default": "vec3(0.5)"
    }
  ],
  "outputs": [
    {
      "id": "converted",
      "name": "Converted Color",
      "type": "vec3",
      "semantic_role": "color"
    }
  ],
  "parameters": [
    {
      "id": "mode",
      "name": "Transfer Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Linear to sRGB",
        "sRGB to Linear",
        "Gamma Encode",
        "Gamma Decode",
        "Pass Through"
      ]
    },
    {
      "id": "gamma",
      "name": "Gamma",
      "type": "float",
      "default": 2.2,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "range",
      "name": "Input Range Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Clamp 0–1",
        "Signed Extended"
      ]
    }
  ],
  "helpers": "float maker_rgbtf_channel(float x,float m,float g,float r){if(isnan(x)||isinf(x))return 0.0;x=r<0.5?clamp(x,0.0,1.0):clamp(x,-10000.0,10000.0);float a=abs(x),v=a;if(m<0.5)v=a<=0.0031308?12.92*a:1.055*pow(a,1.0/2.4)-0.055;else if(m<1.5)v=a<=0.04045?a/12.92:pow((a+0.055)/1.055,2.4);else if(m<2.5)v=pow(a,1.0/g);else if(m<3.5)v=pow(a,g);return sign(x)*min(v,1e20);}\nvec3 maker_rgbtf(vec3 c,float m,float g,float r){return vec3(maker_rgbtf_channel(c.x,m,g,r),maker_rgbtf_channel(c.y,m,g,r),maker_rgbtf_channel(c.z,m,g,r));}",
  "glsl": "maker_rgbtf({color},{mode},{gamma},{range})"
}
