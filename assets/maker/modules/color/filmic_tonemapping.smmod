{
  "schema_version": 1,
  "id": "screenshaver.color.filmic_tonemapping",
  "name": "Filmic Tone Mapping",
  "category": "Color",
  "created_by": "Screenshaver",
  "header_color": "#A27660",
  "description": "Independent luminance-preserving filmic highlight compression.",
  "uses": "Color grading of accumulated field illumination.",
  "notes": "",
  "inputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3",
      "default": "vec3(0.0)"
    }
  ],
  "outputs": [
    {
      "id": "mapped",
      "name": "Mapped",
      "type": "vec3"
    }
  ],
  "parameters": [],
  "helpers": "vec3 maker_filmic_independent(vec3 rgb){vec3 c=max(rgb,vec3(0.0));float lum=dot(c,vec3(0.2126,0.7152,0.0722));float mapped=lum/(1.0+lum);float factor=mapped/max(lum,0.000001);return clamp(c*factor,0.0,1.0);}",
  "glsl": "maker_filmic_independent({color})",
  "terminal": false
}
