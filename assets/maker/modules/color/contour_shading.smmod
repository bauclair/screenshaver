{
  "schema_version": 1,
  "id": "screenshaver.color.contour_shading",
  "name": "Contour Shading",
  "category": "Color",
  "created_by": "Screenshaver",
  "header_color": "#A27660",
  "description": "Applies adjustable dark contour bands based on a scalar field.",
  "uses": "Stylized stripes, contour masks and curvature-derived shading once curvature is available.",
  "notes": "This draws periodic bands from an arbitrary scalar signal. It does not calculate geometric curvature; a separate curvature sampler will be needed for true curvature contours.",
  "inputs": [
    {
      "id": "base",
      "name": "Base Color",
      "type": "vec3",
      "default": "vec3(0.5)"
    },
    {
      "id": "signal",
      "name": "Contour Signal",
      "type": "float",
      "default": "maker_uv.y"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 12,
      "min": 0.1,
      "max": 100
    },
    {
      "id": "width",
      "name": "Line Width",
      "type": "float",
      "default": 0.12,
      "min": 0.01,
      "max": 0.49
    },
    {
      "id": "strength",
      "name": "Line Strength",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1
    }
  ],
  "helpers": "",
  "glsl": "({base} * (1.0-{strength}*(1.0-smoothstep({width}*0.5,{width},abs(fract(({signal})*{frequency})-0.5)))))",
  "terminal": false
}
