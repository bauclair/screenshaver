{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.lighting.curvature_shading",
  "name": "Curvature Shading",
  "category": "Lighting",
  "header_color": "#6D8293",
  "description": "Darken or emphasize edges using a signed curvature signal.",
  "uses": "Combine with SDF Ray March outputs or other scalar/vector sources.",
  "notes": "Works with ordinary typed ports; no texture dependencies.",
  "inputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3",
      "default": "vec3(0.65,0.75,0.9)"
    },
    {
      "id": "curvature",
      "name": "Curvature",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "strength",
      "name": "Strength",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 4
    },
    {
      "id": "edge_width",
      "name": "Edge Width",
      "type": "float",
      "default": 0.2,
      "min": 0.01,
      "max": 1
    }
  ],
  "helpers": "",
  "glsl": "({color} * (1.0 - clamp(abs({curvature}) * {strength} / max({edge_width},0.001),0.0,1.0)))"
}
