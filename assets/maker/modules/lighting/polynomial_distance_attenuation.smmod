{
  "schema_version": 1,
  "id": "screenshaver.lighting.polynomial_distance_attenuation",
  "name": "Polynomial Distance Attenuation",
  "category": "Lighting",
  "created_by": "Screenshaver",
  "description": "Applies bounded reciprocal polynomial falloff to a scalar distance.",
  "uses": "Reusable procedural illumination and material shading.",
  "notes": "Negative distances use their magnitude. NaN distance produces zero response; infinite or extreme distances are bounded to 1e15. Normalized Attenuation is Attenuation clamped to [0,1]. Nonnegative coefficients, a positive denominator floor and a maximum response prevent singularities.",
  "header_color": "#477D9A",
  "inputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "default": "1.0",
      "semantic_role": "distance"
    }
  ],
  "outputs": [
    {
      "id": "attenuation",
      "name": "Attenuation",
      "type": "float",
      "semantic_role": "intensity"
    },
    {
      "id": "normalized",
      "name": "Normalized Attenuation",
      "type": "float",
      "semantic_role": "intensity"
    }
  ],
  "parameters": [
    {
      "id": "constant",
      "name": "Constant Coefficient",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 16
    },
    {
      "id": "linear",
      "name": "Linear Coefficient",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 16
    },
    {
      "id": "quadratic",
      "name": "Quadratic Coefficient",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 16
    },
    {
      "id": "intensity",
      "name": "Intensity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 32
    },
    {
      "id": "denominator_floor",
      "name": "Denominator Floor",
      "type": "float",
      "default": 0.0001,
      "min": 1e-06,
      "max": 1
    },
    {
      "id": "maximum_response",
      "name": "Maximum Response",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 32
    }
  ],
  "helpers": "float maker_polynomial_attenuation(float distanceValue,float c,float l,float q,float intensity,float floorValue,float cap){\n    if(isnan(distanceValue)) return 0.0;\n    float d=min(abs(distanceValue),1e15);\n    float denom=max(max(floorValue,1e-6),max(c,0.0)+d*(max(l,0.0)+max(q,0.0)*d));\n    return min(max(cap,0.0),max(intensity,0.0)/denom);\n}",
  "glsl_outputs": {
    "attenuation": "maker_polynomial_attenuation({distance},{constant},{linear},{quadratic},{intensity},{denominator_floor},{maximum_response})",
    "normalized": "clamp(maker_polynomial_attenuation({distance},{constant},{linear},{quadratic},{intensity},{denominator_floor},{maximum_response}),0.0,1.0)"
  },
  "terminal": false
}
