{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.animation.particle_lifetime_envelope",
  "name": "Particle Lifetime Envelope",
  "category": "Animation",
  "header_color": "#B477C7",
  "description": "Smoothly attenuates an effect between two normalized lifetime thresholds.",
  "uses": "Particle fading, timed opacity and staged effect decay.",
  "notes": "Progress normally ranges from zero to one; thresholds are clamped and ordered to avoid a degenerate smoothstep.",
  "inputs": [
    {
      "id": "progress",
      "name": "Lifetime Progress",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "envelope",
      "name": "Lifetime Envelope",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "fade_start",
      "name": "Fade Start",
      "type": "float",
      "default": 0.12,
      "min": 0,
      "max": 1
    },
    {
      "id": "fade_end",
      "name": "Fade End",
      "type": "float",
      "default": 0.85,
      "min": 0,
      "max": 1
    }
  ],
  "helpers": "",
  "glsl": "1.0-smoothstep(min({fade_start},{fade_end}),max(max({fade_start},{fade_end}),min({fade_start},{fade_end})+0.00001),({progress}))"
}
