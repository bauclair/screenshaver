{
  "schema_version": 1,
  "id": "screenshaver.animation.cyclic_scalar_spline",
  "name": "Cyclic Scalar Spline",
  "category": "Animation",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Closed time-parameterized Hermite spline with optional linear interpolation.",
  "uses": "Closed time-parameterized Hermite spline with optional linear interpolation.",
  "notes": "Uniform segment time; cubic overshoot is intentional. Derivative is with respect to input time, not playback wall time. Linear derivatives can jump at knots.",
  "header_color": "#B477C7",
  "terminal": false,
  "inputs": [
    {
      "id": "time",
      "name": "Time",
      "type": "float",
      "default": "u_time",
      "semantic_role": "time"
    }
  ],
  "outputs": [
    {
      "id": "value",
      "name": "Value",
      "type": "float"
    },
    {
      "id": "rate",
      "name": "Rate of Change",
      "type": "float"
    },
    {
      "id": "segment_index",
      "name": "Segment Index",
      "type": "float"
    },
    {
      "id": "segment_progress",
      "name": "Segment Progress",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "duration",
      "name": "Cycle Duration",
      "type": "float",
      "default": 20,
      "min": 0.1,
      "max": 300
    },
    {
      "id": "offset",
      "name": "Time Offset",
      "type": "float",
      "default": 0,
      "min": -300,
      "max": 300
    },
    {
      "id": "count",
      "name": "Control Point Count",
      "type": "float",
      "default": 8,
      "min": 4,
      "max": 8
    },
    {
      "id": "point_1",
      "name": "Control Point 1",
      "type": "float",
      "default": 0,
      "min": -100,
      "max": 100
    },
    {
      "id": "point_2",
      "name": "Control Point 2",
      "type": "float",
      "default": 1,
      "min": -100,
      "max": 100
    },
    {
      "id": "point_3",
      "name": "Control Point 3",
      "type": "float",
      "default": 0.5,
      "min": -100,
      "max": 100
    },
    {
      "id": "point_4",
      "name": "Control Point 4",
      "type": "float",
      "default": -0.5,
      "min": -100,
      "max": 100
    },
    {
      "id": "point_5",
      "name": "Control Point 5",
      "type": "float",
      "default": -1,
      "min": -100,
      "max": 100
    },
    {
      "id": "point_6",
      "name": "Control Point 6",
      "type": "float",
      "default": 0,
      "min": -100,
      "max": 100
    },
    {
      "id": "point_7",
      "name": "Control Point 7",
      "type": "float",
      "default": 0.5,
      "min": -100,
      "max": 100
    },
    {
      "id": "point_8",
      "name": "Control Point 8",
      "type": "float",
      "default": -0.5,
      "min": -100,
      "max": 100
    },
    {
      "id": "tension",
      "name": "Tension",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "id": "interpolation",
      "name": "Interpolation",
      "type": "choice",
      "default": 1,
      "options": [
        "Linear",
        "Cubic"
      ]
    }
  ],
  "helpers": "float maker_cyclic_scalar(float t,float duration,float offset,float count,float tension,float mode,float p0,float p1,float p2,float p3,float p4,float p5,float p6,float p7,int outputMode){\n int n=int(clamp(floor(count+0.5),4.0,8.0)); float dur=max(duration,0.1); float x=mod(mod(t,dur)+offset,dur)/dur*float(n); int j=min(int(floor(x)),n-1); float u=clamp(x-float(j),0.0,1.0); float points[8]=float[8](p0,p1,p2,p3,p4,p5,p6,p7);\n float a=points[(j+n-1)%n],b=points[j],c=points[(j+1)%n],d=points[(j+2)%n]; float m=(1.0-clamp(tension,0.0,1.0))*0.5*(c-a),k=(1.0-clamp(tension,0.0,1.0))*0.5*(d-b);\n float v=mix(b,c,u),dv=c-b; if(mode>=0.5){v=(2.0*u*u*u-3.0*u*u+1.0)*b+(u*u*u-2.0*u*u+u)*m+(-2.0*u*u*u+3.0*u*u)*c+(u*u*u-u*u)*k; dv=(6.0*u*u-6.0*u)*b+(3.0*u*u-4.0*u+1.0)*m+(-6.0*u*u+6.0*u)*c+(3.0*u*u-2.0*u)*k;} dv*=float(n)/dur;\n return outputMode==1?dv:(outputMode==2?float(float(j)):(outputMode==3?float(u):v));\n}",
  "glsl_outputs": {
    "value": "maker_cyclic_scalar({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},{point_7},{point_8},0)",
    "rate": "maker_cyclic_scalar({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},{point_7},{point_8},1)",
    "segment_index": "maker_cyclic_scalar({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},{point_7},{point_8},2)",
    "segment_progress": "maker_cyclic_scalar({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},{point_7},{point_8},3)"
  }
}
