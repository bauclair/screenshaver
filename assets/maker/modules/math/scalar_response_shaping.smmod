{
  "schema_version": 1,
  "id": "screenshaver.math.scalar_response_shaping",
  "name": "Scalar Response Shaping",
  "category": "Math",
  "created_by": "Screenshaver",
  "description": "Applies selectable scalar transfer functions with gain, bias and optional animated phase.",
  "uses": "Noise shaping, ridges, density masks and procedural materials.",
  "notes": "Normalized Value maps signed Direct and Sinusoidal results from [-1,1] to [0,1]; other modes clamp directly to [0,1]. Threshold endpoints are sorted; equal endpoints produce a step. Frequency is cycles per input unit, phase is degrees and speed is cycles per second. Sawtooth, Triangle and Periodic Gate use the same phase in cycles as Sinusoidal and return [0,1] directly. Gate is active from phase zero to Duty Cycle; softness is a transition half-width in cycles. Hyperbolic Tangent is signed and normalized by mapping [-1,1] to [0,1]. Reciprocal and Reciprocal Tanh use a positive denominator floor. Power uses absolute magnitude; powered magnitude is capped at 1e30 to avoid overflow for extreme finite inputs. New modes ignore wave and threshold parameters. Normalized outputs clamp to [0,1].",
  "header_color": "#65758B",
  "inputs": [
    {
      "id": "value",
      "name": "Scalar Value",
      "type": "float",
      "default": "maker_uv.x"
    },
    {
      "id": "time",
      "name": "Time",
      "type": "float",
      "default": "u_time",
      "semantic_role": "time"
    }
  ],
  "outputs": [
    {
      "id": "shaped",
      "name": "Shaped Value",
      "type": "float"
    },
    {
      "id": "normalized",
      "name": "Normalized Value",
      "type": "float",
      "semantic_role": "intensity"
    }
  ],
  "parameters": [
    {
      "id": "mode",
      "name": "Response Mode",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 11,
      "options": [
        "Direct",
        "Absolute",
        "Ridge",
        "Smooth Threshold",
        "Sinusoidal",
        "Sawtooth",
        "Triangle",
        "Periodic Gate",
        "Hyperbolic Tangent",
        "Reciprocal",
        "Reciprocal Tanh",
        "Power"
      ]
    },
    {
      "id": "gain",
      "name": "Input Gain",
      "type": "float",
      "default": 1,
      "min": -10,
      "max": 10
    },
    {
      "id": "bias",
      "name": "Input Bias",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    },
    {
      "id": "lower",
      "name": "Lower Threshold",
      "type": "float",
      "default": -0.5,
      "min": -10,
      "max": 10
    },
    {
      "id": "upper",
      "name": "Upper Threshold",
      "type": "float",
      "default": 0.5,
      "min": -10,
      "max": 10
    },
    {
      "id": "frequency",
      "name": "Wave Frequency",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 32
    },
    {
      "id": "phase",
      "name": "Phase Offset",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    },
    {
      "id": "duty_cycle",
      "name": "Duty Cycle",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "gate_softness",
      "name": "Gate Softness",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 0.5
    },
    {
      "id": "response_exponent",
      "name": "Response Exponent",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "response_floor",
      "name": "Response Floor",
      "type": "float",
      "default": 0.01,
      "min": 0.0001,
      "max": 1
    },
    {
      "id": "response_strength",
      "name": "Response Strength",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 10
    }
  ],
  "helpers": "float maker_scalar_response(float v,float t,float mode,float gain,float bias,float lo,float hi,float freq,float phase,float speed){\n float x=v*gain+bias; int m=int(clamp(floor(mode+0.5),0.0,4.0));\n if(m==1)return abs(x); if(m==2)return max(0.0,1.0-abs(x));\n if(m==3){float a=min(lo,hi),b=max(lo,hi);return b-a<1e-6?step(a,x):smoothstep(a,b,x);}\n if(m==4)return sin(6.28318530718*(x*freq+t*speed+phase/360.0));\n return x;\n}\nfloat maker_scalar_response_normalize(float v,float mode){\n int m=int(clamp(floor(mode+0.5),0.0,4.0));return clamp((m==0||m==4)?0.5*v+0.5:v,0.0,1.0);\n}\nfloat maker_extended_scalar_response(float v,float t,float mode,float gain,float bias,float lo,float hi,float freq,float phase,float speed,float duty,float softness){\n if(mode<4.5)return maker_scalar_response(v,t,mode,gain,bias,lo,hi,freq,phase,speed);\n float f=fract((v*gain+bias)*freq+t*speed+phase/360.0);\n if(mode<5.5)return f;\n if(mode<6.5)return 1.0-abs(2.0*f-1.0);\n float d=clamp(duty,0.0,1.0);\n if(d<=0.0)return 0.0;\n if(d>=1.0)return 1.0;\n float w=min(max(softness,0.0),0.5*min(d,1.0-d));\n if(w<=0.0)return f<d?1.0:0.0;\n float dist=abs(fract(f-0.5*d+0.5)-0.5);\n return 1.0-smoothstep(0.5*d-w,0.5*d+w,dist);\n}\nfloat maker_nonlinear_scalar_response(float v,float t,float mode,float gain,float bias,float lo,float hi,float freq,float phase,float speed,float duty,float softness,float exponent,float responseFloor,float strength){\n if(mode<7.5)return maker_extended_scalar_response(v,t,mode,gain,bias,lo,hi,freq,phase,speed,duty,softness);\n float x=v*gain+bias,k=max(strength,0.0);\n if(mode<8.5)return tanh(k*x);\n if(k==0.0)return 0.0;\n float e=clamp(exponent,0.1,8.0),eps=max(responseFloor,0.0001);\n float mag=abs(x);\n // Limit extreme powers to a finite HDR ceiling, avoiding overflow.\n float p=mag==0.0?0.0:exp(min(e*log(mag),log(1e30)));\n if(mode<9.5)return k/max(p,eps);\n if(mode<10.5)return k/max(tanh(p),eps);\n return k*p;\n}\nfloat maker_nonlinear_scalar_normalize(float v,float mode){\n if(mode<4.5)return maker_scalar_response_normalize(v,mode);\n return clamp(mode>=7.5&&mode<8.5?0.5*v+0.5:v,0.0,1.0);\n}",
  "glsl_outputs": {
    "shaped": "maker_nonlinear_scalar_response({value},{time},{mode},{gain},{bias},{lower},{upper},{frequency},{phase},{speed},{duty_cycle},{gate_softness},{response_exponent},{response_floor},{response_strength})",
    "normalized": "maker_nonlinear_scalar_normalize(maker_nonlinear_scalar_response({value},{time},{mode},{gain},{bias},{lower},{upper},{frequency},{phase},{speed},{duty_cycle},{gate_softness},{response_exponent},{response_floor},{response_strength}),{mode})"
  },
  "terminal": false
}
