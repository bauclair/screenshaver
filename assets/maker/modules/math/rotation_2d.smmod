{
  "schema_version": 1,
  "id": "screenshaver.math.rotation2d",
  "name": "2D Rotation",
  "category": "Math",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#688B82",
  "description": "Rotates a 2D vector by an angle in radians.",
  "uses": "Spatial transformation and animated patterns.",
  "notes": "Standard planar rotation using sine and cosine; angle is in radians.",
  "inputs": [
    {
      "id": "vector",
      "name": "Vector",
      "type": "vec2",
      "default": "maker_uv"
    },
    {
      "id": "angle",
      "name": "Angle",
      "type": "float",
      "default": "u_time"
    }
  ],
  "outputs": [
    {
      "id": "rotated",
      "name": "Rotated",
      "type": "vec2"
    }
  ],
  "parameters": [],
  "helpers": "vec2 maker_rotate_2d(vec2 v, float angle) {\n    float c = cos(angle);\n    float s = sin(angle);\n    return vec2(c * v.x - s * v.y, s * v.x + c * v.y);\n}",
  "glsl": "maker_rotate_2d({vector},{angle})",
  "terminal": false
}
