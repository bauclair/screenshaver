{
  "schema_version": 1,
  "id": "screenshaver.fields.iterative_trigonometric_proximity_field_2d",
  "name": "Iterative Trigonometric Proximity Field 2D",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Bounded periodic feedback and proximity accumulation; normalized field is weighted mean before gain.",
  "uses": "Iterative Trigonometric Proximity Field 2D",
  "notes": "Bounded periodic feedback and proximity accumulation; normalized field is weighted mean before gain.",
  "header_color": "#348F8B",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
