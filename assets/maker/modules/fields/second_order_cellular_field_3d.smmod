{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.fields.second_order_cellular_field_3d",
  "name": "Second-Order Cellular Field 3D",
  "category": "Fields",
  "header_color": "#348F8B",
  "description": "Computes nearest and second-nearest 3D feature distances from a deterministic jittered cubic lattice.",
  "uses": "Cell interiors, borders, bevel-like patterns, mineral and organic surface detail.",
  "notes": "Independent F1/F2 lattice-neighbor search, distinct from existing 3D Cellular Tile Field (which measures cubic tile edges). A procedural alternative inspired by general cellular mathematics, not a copy of Biomine cellular expressions. Compact mode selects eight neighboring cell centers before jitter; approximate. Distances in lattice units; positions and displacement in world units.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "nearest",
      "name": "Nearest Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "second",
      "name": "Second Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "boundary",
      "name": "Boundary Difference",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "distance_gap",
      "name": "Distance Gap",
      "type": "float"
    },
    {
      "id": "cell_identifier",
      "name": "Cell Identifier",
      "type": "vec3"
    },
    {
      "id": "feature_position",
      "name": "Feature Position",
      "type": "vec3"
    },
    {
      "id": "feature_displacement",
      "name": "Feature Displacement",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Cell Density",
      "type": "float",
      "default": 4,
      "min": 0.1,
      "max": 20
    },
    {
      "id": "jitter",
      "name": "Site Jitter",
      "type": "float",
      "default": 0.65,
      "min": 0,
      "max": 1
    },
    {
      "id": "edge_width",
      "name": "Boundary Width",
      "type": "float",
      "default": 0.2,
      "min": 0.001,
      "max": 1
    },
    {
      "id": "evaluation_mode",
      "name": "Evaluation Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Existing Neighborhood",
        "Compact Eight Sites"
      ]
    }
  ],
  "helpers": "vec3 maker_bio_site(vec3 cell){\n return fract(sin(vec3(dot(cell,vec3(127.1,311.7,74.7)),dot(cell,vec3(269.5,183.3,246.1)),dot(cell,vec3(113.5,271.9,124.6))))*43758.5453);\n}\nvec2 maker_bio_cell_f12(vec3 p,float scale,float jitter){\n vec3 q=p*max(scale,0.001);vec3 cell=floor(q);vec3 f=fract(q);\n float first=1e8;float second=1e8;\n for(int z=-1;z<=1;z++)for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){\n  vec3 o=vec3(float(x),float(y),float(z));\n  vec3 site=o+vec3(0.5)+max(0.0,min(jitter,1.0))*(maker_bio_site(cell+o)-vec3(0.5));\n  float d=length(site-f);\n  if(d<first){second=first;first=d;}else if(d<second){second=d;}\n }\n return vec2(first,second);\n}\nfloat maker_bio_cell_border(vec3 p,float scale,float jitter,float edgeWidth){\n vec2 f=maker_bio_cell_f12(p,scale,jitter);\n return 1.0-smoothstep(0.0,max(edgeWidth,0.001),f.y-f.x);\n}\nstruct Maker407Cell {float nearest;float second;float boundary;float distance_gap;vec3 cell_identifier;vec3 feature_position;vec3 feature_displacement;};\nMaker407Cell maker_cell407(vec3 p,float scale,float jitter,float edge_width,float evaluation_mode){vec3 q=p*max(scale,.001),cell=floor(q),f=fract(q),win=vec3(0.),point=vec3(0.);float first=1e8,second=1e8;vec3 start=step(vec3(.5),f)-vec3(1.);for(int z=-1;z<=1;z++)for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){vec3 o=vec3(x,y,z);if(evaluation_mode>.5&&(any(lessThan(o,start))||any(greaterThan(o,start+vec3(1.)))))continue;vec3 site=o+vec3(.5)+clamp(jitter,0.,1.)*(maker_bio_site(cell+o)-vec3(.5));float dd=length(site-f);if(dd<first){second=first;first=dd;win=cell+o;point=cell+site;}else if(dd<second)second=dd;}float gap=second-first;return Maker407Cell(first,second,1.-smoothstep(0.,max(edge_width,.001),gap),gap,win,point/max(scale,.001),(point-q)/max(scale,.001));}",
  "glsl_outputs": {
    "nearest": "maker_cell407({position},{scale},{jitter},{edge_width},{evaluation_mode}).nearest",
    "second": "maker_cell407({position},{scale},{jitter},{edge_width},{evaluation_mode}).second",
    "boundary": "maker_cell407({position},{scale},{jitter},{edge_width},{evaluation_mode}).boundary",
    "distance_gap": "maker_cell407({position},{scale},{jitter},{edge_width},{evaluation_mode}).distance_gap",
    "cell_identifier": "maker_cell407({position},{scale},{jitter},{edge_width},{evaluation_mode}).cell_identifier",
    "feature_position": "maker_cell407({position},{scale},{jitter},{edge_width},{evaluation_mode}).feature_position",
    "feature_displacement": "maker_cell407({position},{scale},{jitter},{edge_width},{evaluation_mode}).feature_displacement"
  }
}
