{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.fields.procedural_spectrum_envelope",
  "name": "Procedural Spectrum Envelope",
  "category": "Fields",
  "header_color": "#4B9A86",
  "description": "Generates an animated pseudo-spectrum from low-frequency emphasis, a moving mid-band peak and high-frequency modulation.",
  "uses": "Audio-reactive-looking graphics without an audio input, abstract equalizers and radial frequency patterns.",
  "notes": "This is synthetic modulation, not an audio spectrum. Frequency coordinate is normalized to zero through one.",
  "inputs": [
    {
      "id": "frequency",
      "name": "Frequency Coordinate",
      "type": "float",
      "default": "0.5"
    },
    {
      "id": "time",
      "name": "Time",
      "type": "float",
      "default": "u_time"
    },
    {
      "id": "pulse",
      "name": "Pulse",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "intensity",
      "name": "Spectrum Intensity",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "low_weight",
      "name": "Low Band Weight",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 3
    },
    {
      "id": "mid_weight",
      "name": "Mid Band Weight",
      "type": "float",
      "default": 0.55,
      "min": 0,
      "max": 3
    },
    {
      "id": "high_weight",
      "name": "High Band Weight",
      "type": "float",
      "default": 0.12,
      "min": 0,
      "max": 3
    },
    {
      "id": "motion_speed",
      "name": "Motion Speed",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 10
    }
  ],
  "helpers": "float maker_synthetic_spectrum(float f,float time,float pulse,float low,float mid,float high,float speed){float x=clamp(f,0.0,1.0);float t=time*speed;float bass=pow(1.0-x,1.5)*low+max(pulse,0.0)*exp(-9.0*x)*low;float center=0.4+0.17*sin(t*0.8);float middle=mid*exp(-pow((x-center)/0.09,2.0))*(0.6+0.4*sin(t*5.0+x*35.0));float treble=high*x*(0.5+0.5*sin(t*13.0+x*75.0));return clamp(bass+middle+treble,0.0,1.0);}",
  "glsl": "maker_synthetic_spectrum({frequency},{time},{pulse},{low_weight},{mid_weight},{high_weight},{motion_speed})"
}
