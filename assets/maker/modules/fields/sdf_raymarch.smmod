{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.fields.sdf_raymarch",
  "name": "SDF Ray March",
  "category": "Fields",
  "header_color": "#477D9A",
  "description": "Ray marches a callable signed-distance field with selectable internal or external perspective camera, surface shading, and proximity glow.",
  "uses": "Corridors, caves and other procedural signed-distance geometry.",
  "notes": "Color, hit normal, ambient occlusion and signed curvature are calculated from the same ray-march hit. AO=1 is unoccluded; curvature is scaled and clamped to [-1,1]. No texture dependencies. Glow is accumulated during the same march; falloff is applied per sample. External Camera uses connected Ray Origin and Ray Direction; existing internal camera remains the default. External direction is normalized; zero-length external direction falls back to the internal camera.",
  "inputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "camera_offset",
      "name": "Camera Offset",
      "type": "vec2",
      "default": "vec2(0.0)"
    },
    {
      "id": "ray_origin",
      "name": "Ray Origin",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "ray_direction",
      "name": "Ray Direction",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "direction3d"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3"
    },
    {
      "id": "normal",
      "name": "Surface Normal",
      "type": "vec3"
    },
    {
      "id": "ao",
      "name": "Ambient Occlusion",
      "type": "float"
    },
    {
      "id": "curvature",
      "name": "Curvature",
      "type": "float"
    },
    {
      "id": "glow",
      "name": "Ray Glow",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "speed",
      "name": "Camera Speed",
      "type": "float",
      "default": 3.0,
      "min": 0.0,
      "max": 12.0
    },
    {
      "id": "max_distance",
      "name": "Maximum Distance",
      "type": "float",
      "default": 55.0,
      "min": 5.0,
      "max": 150.0
    },
    {
      "id": "epsilon",
      "name": "Hit Threshold",
      "type": "float",
      "default": 0.005,
      "min": 0.001,
      "max": 0.05
    },
    {
      "id": "step_scale",
      "name": "Step Multiplier",
      "type": "float",
      "default": 0.75,
      "min": 0.2,
      "max": 1.0
    },
    {
      "id": "fov",
      "name": "Field of View",
      "type": "float",
      "default": 1.2,
      "min": 0.4,
      "max": 2.0
    },
    {
      "id": "glow_falloff",
      "name": "Glow Falloff",
      "type": "float",
      "default": 7.0,
      "min": 0.2,
      "max": 25.0
    },
    {
      "id": "glow_gain",
      "name": "Glow Gain",
      "type": "float",
      "default": 0.06,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "camera_source",
      "name": "Camera Source",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "Internal Camera",
        "External Camera"
      ]
    }
  ],
  "helpers": "",
  "glsl": "vec3(0.0)",
  "glsl_outputs": {
    "color": "vec3(0.0)",
    "normal": "vec3(0.0)",
    "ao": "0.0",
    "curvature": "0.0",
    "glow": "0.0"
  }
}
