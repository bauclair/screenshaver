{
  "schema_version": 1,
  "id": "screenshaver.fields.lightweight_active_matter_field",
  "name": "Lightweight Active Matter Field",
  "category": "Fields",
  "created_by": "Screenshaver",
  "header_color": "#5A78A8",
  "description": "Bounded animated 2D harmonic field with a small number of inexpensive coupled wave layers.",
  "uses": "Liquid-like procedural textures, luminous interference patterns and animated color signals.",
  "notes": "Independently designed 2D harmonic accumulation, not a copy or simplification of the source kal_march raymarcher. One evaluation, no startup fade. Defaults: 8 outer and 3 inner iterations; hard caps: 12 and 4. Output is a scalar, not a full volumetric render.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "outer_iterations",
      "name": "Outer Layers",
      "type": "float",
      "default": 8,
      "min": 1,
      "max": 12
    },
    {
      "id": "inner_iterations",
      "name": "Inner Waves",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 4
    },
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 3,
      "min": 0.1,
      "max": 20
    },
    {
      "id": "warp",
      "name": "Warp Strength",
      "type": "float",
      "default": 0.35,
      "min": 0,
      "max": 2
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 5
    }
  ],
  "helpers": "float maker_light_matter(vec2 position,float time,float outerCount,float innerCount,float frequency,float warp,float speed){int layers=clamp(int(floor(outerCount+0.5)),1,12);int waves=clamp(int(floor(innerCount+0.5)),1,4);vec2 q=position*max(frequency,0.001);float t=time*speed;float sum=0.0;float norm=0.0;for(int i=0;i<12;i++){if(i>=layers)break;float fi=float(i)+1.0;float v=0.0;for(int j=0;j<4;j++){if(j>=waves)break;float fj=float(j)+1.0;vec2 axis=vec2(cos(fi*1.17+fj*2.03),sin(fi*1.17+fj*2.03));v+=sin(dot(q,axis)*(0.7+0.35*fj)+t*(0.3+0.12*fi)+fi*fj*0.41);}v/=float(waves);float weight=1.0/(1.0+0.6*float(i));sum+=weight*v;norm+=weight;vec2 offset=warp*0.12*vec2(cos(q.y+t+fi),sin(q.x-t*0.7+fi));q=mat2(0.8660254,-0.5,0.5,0.8660254)*(q+offset);}return 0.5+0.5*sum/max(norm,0.001);}",
  "glsl": "maker_light_matter({position},u_time,{outer_iterations},{inner_iterations},{frequency},{warp},{speed})",
  "terminal": false
}
