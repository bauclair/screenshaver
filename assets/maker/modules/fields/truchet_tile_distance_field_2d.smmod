    },
    {
      "id": "cell_identifier",
      "name": "Cell Identifier",
      "type": "vec2",
      "default": "floor(maker_uv*8.0)"
    },
    {
      "id": "width_multiplier",
      "name": "Width Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
