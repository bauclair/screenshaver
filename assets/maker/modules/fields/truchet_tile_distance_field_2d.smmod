      "name": "Interruption Mask",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "pattern_type",
      "name": "Pattern Type",
      "type": "choice",
      "default": 0,
      "options": [
        "Circular Arcs",
        "Diagonals",
        "Combined",
        "Random Mix",
        "Rounded Orthogonal Paths",
        "Interrupted Rounded Paths"
      ]
    },
    {
      "id": "tile_size",
      "name": "Tile Size",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "arc_radius",
      "name": "Arc Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.001,
      "max": 2
    },
    {
      "id": "line_width",
      "name": "Line Width",
      "type": "float",
      "default": 0.04,
      "min": 0.0001,
      "max": 1
    },
    {
      "id": "edge_softness",
      "name": "Edge Softness",
      "type": "float",
      "default": 0.005,
      "min": 0,
      "max": 1
    },
    {
      "id": "diagonal_probability",
      "name": "Diagonal Probability",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "orientation_mode",
      "name": "Orientation Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Randomized",
        "Fixed",
        "Alternating"
      ]
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 65535
    },
    {
      "id": "interior_inversion",
      "name": "Interior Inversion",
      "type": "choice",
      "default": 0,
      "options": [
        "Disabled",
        "Enabled"
      ]
    },
    {
      "id": "corner_radius",
      "name": "Corner Radius",
      "type": "float",
      "default": 0.2,
      "min": 0.01,
      "max": 0.5
    },
    {
      "id": "interruption_width",
      "name": "Interruption Width",
      "type": "float",
      "default": 0.08,
      "min": 0,
      "max": 0.25
    },
    {
      "id": "interruption_probability",
      "name": "Interruption Probability",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 1
    },
    {
      "id": "temporal_orientation",
      "name": "Temporal Orientation",
      "type": "choice",
      "default": 0,
      "options": [
        "Off",
        "Synchronized",
        "Staggered"
      ]
    },
    {
      "id": "change_frequency",
      "name": "Change Frequency",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 20
