  "creator_email": "screenshaver@proton.me",
  "description": "Truchet Tile Distance Field 2D",
  "uses": "Truchet Tile Distance Field 2D",
  "notes": "Centered normalized tile coordinates; mixed-resolution edges not guaranteed to connect.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "local_position",
