{
  "schema_version": 1,
  "id": "screenshaver.fields.truchet_tile_distance_field_2d",
  "name": "Truchet Tile Distance Field 2D",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Truchet Tile Distance Field 2D",
  "uses": "Truchet Tile Distance Field 2D",
  "notes": "Centered normalized tile coordinates; mixed-resolution edges not guaranteed to connect.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "local_position",
      "name": "Local Position",
      "type": "vec2",
      "default": "fract(maker_uv*8.0)-0.5"
    },
    {
      "id": "cell_identifier",
      "name": "Cell Identifier",
      "type": "vec2",
      "default": "floor(maker_uv*8.0)"
    },
    {
      "id": "width_multiplier",
      "name": "Width Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "pattern_distance",
      "name": "Pattern Distance",
      "type": "float"
    },
    {
      "id": "pattern_mask",
      "name": "Pattern Mask",
      "type": "float"
    },
    {
      "id": "arc_distance",
      "name": "Arc Distance",
      "type": "float"
    },
    {
      "id": "diagonal_distance",
      "name": "Diagonal Distance",
      "type": "float"
    },
    {
      "id": "tile_boundary_distance",
      "name": "Tile Boundary Distance",
      "type": "float"
    },
    {
      "id": "tile_orientation",
      "name": "Tile Orientation",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "pattern_type",
      "name": "Pattern Type",
      "type": "choice",
      "default": 0,
      "options": [
        "Circular Arcs",
        "Diagonals",
        "Combined",
        "Random Mix"
      ]
    },
    {
      "id": "tile_size",
      "name": "Tile Size",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "arc_radius",
      "name": "Arc Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.001,
      "max": 2
    },
    {
      "id": "line_width",
      "name": "Line Width",
      "type": "float",
      "default": 0.04,
      "min": 0.0001,
      "max": 1
    },
    {
      "id": "edge_softness",
      "name": "Edge Softness",
      "type": "float",
      "default": 0.005,
      "min": 0,
      "max": 1
    },
    {
      "id": "diagonal_probability",
      "name": "Diagonal Probability",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "orientation_mode",
      "name": "Orientation Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Randomized",
        "Fixed",
        "Alternating"
      ]
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 65535
    },
    {
      "id": "interior_inversion",
      "name": "Interior Inversion",
      "type": "choice",
      "default": 0,
      "options": [
        "Disabled",
        "Enabled"
      ]
    }
  ],
  "helpers": "\nstruct MakerB330TruchetTileDistanceField2D {float pattern_distance;float pattern_mask;float arc_distance;float diagonal_distance;float tile_boundary_distance;float tile_orientation;};\nMakerB330TruchetTileDistanceField2D maker_b330_truchet_tile_distance_field_2d(vec2 local_position,vec2 cell_identifier,float width_multiplier,float pattern_type,float tile_size,float arc_radius,float line_width,float edge_softness,float diagonal_probability,float orientation_mode,float seed,float interior_inversion,float tm){\nfloat r=fract(sin(dot(cell_identifier,vec2(127.1,311.7))+seed*19.19)*43758.5453);float flip=orientation_mode<.5?step(.5,r):(orientation_mode<1.5?0.:mod(cell_identifier.x+cell_identifier.y,2.));vec2 q=clamp(local_position,-.5,.5);if(flip>.5)q.x=-q.x;float a=min(abs(length(q-vec2(.5)) -arc_radius),abs(length(q+vec2(.5))-arc_radius));float d=abs(q.x-q.y)*.70710678;float v=pattern_type<.5?a:(pattern_type<1.5?d:(pattern_type<2.5?min(a,d):(r<diagonal_probability?d:a)));float w=max(0.,line_width*width_multiplier);float mask=1.-smoothstep(w,w+max(edge_softness,1e-6),v);if(interior_inversion>.5)mask=1.-mask;return MakerB330TruchetTileDistanceField2D((v-w)*tile_size,mask,a*tile_size,d*tile_size,(.5-max(abs(q.x),abs(q.y)))*tile_size,flip);\n}",
  "glsl_outputs": {
    "pattern_distance": "maker_b330_truchet_tile_distance_field_2d({local_position},{cell_identifier},{width_multiplier},{pattern_type},{tile_size},{arc_radius},{line_width},{edge_softness},{diagonal_probability},{orientation_mode},{seed},{interior_inversion},u_time).pattern_distance",
    "pattern_mask": "maker_b330_truchet_tile_distance_field_2d({local_position},{cell_identifier},{width_multiplier},{pattern_type},{tile_size},{arc_radius},{line_width},{edge_softness},{diagonal_probability},{orientation_mode},{seed},{interior_inversion},u_time).pattern_mask",
    "arc_distance": "maker_b330_truchet_tile_distance_field_2d({local_position},{cell_identifier},{width_multiplier},{pattern_type},{tile_size},{arc_radius},{line_width},{edge_softness},{diagonal_probability},{orientation_mode},{seed},{interior_inversion},u_time).arc_distance",
    "diagonal_distance": "maker_b330_truchet_tile_distance_field_2d({local_position},{cell_identifier},{width_multiplier},{pattern_type},{tile_size},{arc_radius},{line_width},{edge_softness},{diagonal_probability},{orientation_mode},{seed},{interior_inversion},u_time).diagonal_distance",
    "tile_boundary_distance": "maker_b330_truchet_tile_distance_field_2d({local_position},{cell_identifier},{width_multiplier},{pattern_type},{tile_size},{arc_radius},{line_width},{edge_softness},{diagonal_probability},{orientation_mode},{seed},{interior_inversion},u_time).tile_boundary_distance",
    "tile_orientation": "maker_b330_truchet_tile_distance_field_2d({local_position},{cell_identifier},{width_multiplier},{pattern_type},{tile_size},{arc_radius},{line_width},{edge_softness},{diagonal_probability},{orientation_mode},{seed},{interior_inversion},u_time).tile_orientation"
  }
}
