{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.fields.four_wave_plasma_field",
  "name": "Four-Wave Plasma Field",
  "category": "Fields",
  "header_color": "#5A78A8",
  "description": "Four directional travelling waves combined into a normalized plasma field.",
  "uses": "Animated plasma and interference patterns.",
  "notes": "Independent directions, frequencies and relative phases; no reuse of Abstraction wave constants.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 3
    }
  ],
  "helpers": "float maker_four_wave_independent(vec2 p,float t){vec2 a=vec2(0.8660254,0.5);vec2 b=vec2(-0.3420201,0.9396926);float v=sin(dot(p,a)*1.7+t*0.7)+cos(dot(p,b)*2.3-t*1.3)+sin(dot(p,a+b)*1.1-t*0.4)+cos(length(p+vec2(0.2,-0.4))*2.7+t*0.9);return clamp(0.5+0.125*v,0.0,1.0);}",
  "glsl": "maker_four_wave_independent({position}*{scale},u_time*{speed})"
}
