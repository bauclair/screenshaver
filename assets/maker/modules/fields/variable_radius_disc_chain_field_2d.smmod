{
  "schema_version": 1,
  "id": "screenshaver.fields.variable_radius_disc_chain_field_2d",
  "name": "Variable-Radius Disc Chain Field 2D",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Bounded local union of 17 discs. Radius limited to three spacings, height to two spacings; local field is not a global exact distance far from the chain.",
  "uses": "Variable-Radius Disc Chain Field 2D",
  "notes": "Bounded local union of 17 discs. Radius limited to three spacings, height to two spacings; local field is not a global exact distance far from the chain.",
  "header_color": "#627FC2",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "position2d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec2",
      "default": "vec2(0.0)"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0",
      "semantic_role": "time"
    }
  ],
  "outputs": [
    {
      "id": "union_field",
      "name": "Union Field",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "coverage_mask",
      "name": "Coverage Mask",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "nearest_disc_index",
      "name": "Nearest Disc Index",
      "type": "float"
    },
    {
      "id": "local_radius",
      "name": "Local Radius",
      "type": "float"
    },
    {
      "id": "centerline_height",
      "name": "Centerline Height",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "spacing",
      "name": "Spacing",
      "type": "float",
      "default": 0.3,
      "min": 0.01,
      "max": 5
    },
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 0.2,
      "min": 0.001,
      "max": 5
    },
    {
      "id": "radius_variation",
      "name": "Radius Variation",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "height_amplitude",
      "name": "Height Amplitude",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 5
    },
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 10
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.5,
      "min": -5,
      "max": 5
    },
    {
      "id": "orientation",
      "name": "Orientation",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1000
    },
    {
      "id": "variation_mode",
      "name": "Variation Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Harmonic",
        "Random"
      ]
    }
  ],
  "helpers": "struct MakerDiscResult{float field;float idx;float radius;float height;};\nMakerDiscResult maker_variable_radius_disc_chain_field_2d(vec2 p,vec2 c,float t,float spacing,float radius,float variation,float height,float freq,float speed,float angle,float seed,float mode){float a=radians(angle);p-=c;p=vec2(dot(p,vec2(cos(a),sin(a))),dot(p,vec2(-sin(a),cos(a))));float s=max(spacing,.01);float base=floor(p.x/s+.5),best=1e20,bi=0.0,br=0.0,bh=0.0;for(int j=-8;j<=8;j++){float i=base+float(j),ph=i*freq+(u_time+t)*speed+seed;float v=mode<.5?sin(ph):2.0*fract(sin(i*127.1+seed)*43758.5453)-1.0;float r=clamp(radius*(1.0+variation*v),.001,3.0*s);float y=clamp(height,0.0,2.0*s)*sin(ph+1.5707963);float d=length(p-vec2(i*s,y))-r;if(d<best){best=d;bi=i;br=r;bh=y;}}return MakerDiscResult(best,bi,br,bh);}",
  "glsl_outputs": {
    "union_field": "maker_variable_radius_disc_chain_field_2d({position},{center},{time_offset},{spacing},{radius},{radius_variation},{height_amplitude},{frequency},{speed},{orientation},{seed},{variation_mode}).field",
    "coverage_mask": "step(maker_variable_radius_disc_chain_field_2d({position},{center},{time_offset},{spacing},{radius},{radius_variation},{height_amplitude},{frequency},{speed},{orientation},{seed},{variation_mode}).field,0.0)",
    "nearest_disc_index": "maker_variable_radius_disc_chain_field_2d({position},{center},{time_offset},{spacing},{radius},{radius_variation},{height_amplitude},{frequency},{speed},{orientation},{seed},{variation_mode}).idx",
    "local_radius": "maker_variable_radius_disc_chain_field_2d({position},{center},{time_offset},{spacing},{radius},{radius_variation},{height_amplitude},{frequency},{speed},{orientation},{seed},{variation_mode}).radius",
    "centerline_height": "maker_variable_radius_disc_chain_field_2d({position},{center},{time_offset},{spacing},{radius},{radius_variation},{height_amplitude},{frequency},{speed},{orientation},{seed},{variation_mode}).height"
  }
}
