{
  "schema_version": 1,
  "id": "screenshaver.fields.morphing",
  "name": "Morphing Field",
  "category": "Fields",
  "created_by": "Screenshaver",
  "header_color": "#5A78A8",
  "description": "Animated scalar field built from smooth 3D value noise and independent sinusoidal modulation.",
  "uses": "Organic animated patterns and field-guided effects.",
  "notes": "General mode blends noise and waves; Layered mode adds a second wave octave. Both modes are original generic procedural constructions.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 2.0,
      "min": 0.1,
      "max": 12.0
    },
    {
      "id": "strength",
      "name": "Strength",
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "mode",
      "name": "Processing Mode",
      "type": "choice",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "options": [
        "General",
        "Layered waves"
      ]
    }
  ],
  "helpers": "float maker_morph_hash(vec3 p) {\n    return fract(sin(dot(p, vec3(41.37, 89.13, 157.61))) * 24634.6345);\n}\nfloat maker_morph_noise(vec3 p) {\n    vec3 cell = floor(p);\n    vec3 f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    float result = 0.0;\n    for (int z = 0; z < 2; ++z) {\n        for (int y = 0; y < 2; ++y) {\n            for (int x = 0; x < 2; ++x) {\n                vec3 corner = vec3(float(x), float(y), float(z));\n                vec3 w = mix(vec3(1.0) - f, f, corner);\n                result += maker_morph_hash(cell + corner) * w.x * w.y * w.z;\n            }\n        }\n    }\n    return result;\n}\nfloat maker_morph_field(vec3 position, float scale, float strength, float speed, float mode) {\n    float t = u_time * speed;\n    float a = 0.25 * t;\n    float c = cos(a);\n    float s = sin(a);\n    vec3 p = position;\n    p.xy = vec2(c * p.x - s * p.y, s * p.x + c * p.y);\n    float f = max(scale, 0.001);\n    float noisePart = maker_morph_noise(p * f + vec3(0.0, 0.0, 0.35 * t)) - 0.5;\n    float wave = sin(f * p.x + t) * cos(0.8 * f * p.y - 0.7 * t);\n    float layered = sin(1.7 * f * p.z - 0.45 * t) * cos(1.3 * f * p.x + t);\n    return strength * (0.65 * noisePart + 0.25 * wave + step(0.5, mode) * 0.15 * layered);\n}\nfloat maker_morph_field(vec3 position, float scale, float strength, float speed) {\n    return maker_morph_field(position, scale, strength, speed, 0.0);\n}",
  "glsl": "maker_morph_field({position},{scale},{strength},{speed},{mode})",
  "terminal": false
}
