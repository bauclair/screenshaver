{
  "schema_version": 1,
  "id": "screenshaver.fields.morphing",
  "name": "Morphing Field",
  "category": "Fields",
  "created_by": "Screenshaver",
  "header_color": "#5A78A8",
  "description": "An animated 3D procedural field combining coordinate rotation, waves, and smooth noise. Original-style mode reproduces the Frostbyte distance field.",
  "uses": "Organic animated patterns and field-guided effects.",
  "notes": "General or Original-style field. In Original-style mode Scale=2, Strength=0.7 and Speed=0.5 reproduce the reference field; each slider remains active.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 2.0,
      "min": 0.1,
      "max": 12.0
    },
    {
      "id": "strength",
      "name": "Strength",
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 2.0
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "mode",
      "name": "Processing Mode",
      "type": "choice",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "options": [
        "General",
        "Original-style"
      ]
    }
  ],
  "helpers": "float maker_morph_dot_noise_3d(vec3 p){const float PHI=1.618033988;const mat3 GOLD=mat3(-0.571464913,0.814921382,0.096597072,-0.278044873,-0.303026659,0.911518454,0.772087367,0.494042493,0.399753815);return dot(cos(GOLD*p),sin(PHI*p*GOLD));}\nfloat maker_morph_hash(vec3 p){return fract(sin(dot(p,vec3(127.1,311.7,74.7)))*43758.5453);}\nfloat maker_morph_noise(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);float a=mix(maker_morph_hash(i),maker_morph_hash(i+vec3(1,0,0)),f.x);float b=mix(maker_morph_hash(i+vec3(0,1,0)),maker_morph_hash(i+vec3(1,1,0)),f.x);float c=mix(maker_morph_hash(i+vec3(0,0,1)),maker_morph_hash(i+vec3(1,0,1)),f.x);float d=mix(maker_morph_hash(i+vec3(0,1,1)),maker_morph_hash(i+vec3(1,1,1)),f.x);return mix(mix(a,b,f.y),mix(c,d,f.y),f.z);}\nfloat maker_morph_field(vec3 p,float scale,float strength,float speed){float t=u_time*speed;float angle=t+0.6*p.z;mat2 rot=mat2(cos(angle),-sin(angle),sin(angle),cos(angle));p.xy=rot*p.xy;float n=maker_morph_noise(p*scale+vec3(0.0,0.0,t*0.3));float wave=sin(p.x*scale*0.8+t)*cos(p.y*scale*0.7-t*0.6);return (n-0.5)*strength+0.25*wave*strength;} \nfloat maker_original_distance(vec3 p,float scale,float strength,float speed){p*=scale/2.0;vec3 b=p;float t=u_time*(speed/0.5);b.xy=sin(b.xy*0.25);float angle=t*0.5+b.z*2.0;float cs=cos(angle),sn=sin(angle);b.xy=mat2(cs,-sn,sn,cs)*b.xy;float s=0.001+abs(maker_morph_dot_noise_3d(b*20.0)/20.0-maker_morph_dot_noise_3d(b))*0.7;s+=abs(p.y*0.2+sin(p.z*2.0+abs(p.x)*0.5))*0.5;return max(s*(strength/0.7),0.0001);}",
  "glsl": "mix(maker_morph_field({position},{scale},{strength},{speed}),maker_original_distance({position},{scale},{strength},{speed}),step(0.5,{mode}))",
  "terminal": false
}
