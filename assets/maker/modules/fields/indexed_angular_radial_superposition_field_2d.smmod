  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Normalized response is signed mean divided by total absolute response weights. Contributions are sums.",
  "uses": "Indexed Angular-Radial Superposition Field 2D",
