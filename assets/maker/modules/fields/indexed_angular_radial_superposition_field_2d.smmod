      "max": 10
    },
    {
      "id": "motion_y",
      "name": "Motion Y",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 10
    },
    {
      "id": "motion_frequency",
      "name": "Motion Frequency",
