      "type": "float",
      "default": 3,
      "min": 0,
      "max": 32
    },
    {
      "id": "orientation_progression",
      "name": "Orientation Progression",
      "type": "float",
      "default": 0.5,
      "min": -6.28,
      "max": 6.28
    },
    {
      "id": "radial_frequency",
      "name": "Radial Frequency",
      "type": "float",
      "default": 8,
      "min": 0,
      "max": 64
