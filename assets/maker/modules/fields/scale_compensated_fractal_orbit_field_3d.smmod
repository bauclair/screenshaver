{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.fields.scale_compensated_fractal_orbit_field_3d",
  "name": "Scale-Compensated Fractal Orbit Field 3D",
  "category": "Fields",
  "header_color": "#557C9C",
  "description": "Measures minimum nominal scale-compensated proximity to a geometric orbit trap.",
  "uses": "Fractal structures, orbit coloring and procedural distance fields.",
  "notes": "Unsigned heuristic distance estimator, not an exact SDF or guaranteed safe step bound. Closest iteration is one-based; ties retain the earliest iteration. Scale is nominal under regularization and clamping.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv,0.35)"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Orbit Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "closest_iteration",
      "name": "Closest Iteration",
      "type": "float"
    },
    {
      "id": "log_scale",
      "name": "Logarithmic Scale",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "iterations",
      "name": "Iterations",
      "type": "float",
      "default": 8,
      "min": 1,
      "max": 16
    },
    {
      "id": "fold_center",
      "name": "Fold Center",
      "type": "float",
      "default": 0.35,
      "min": -3,
      "max": 3
    },
    {
      "id": "gain",
      "name": "Inversion Gain",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 3
    },
    {
      "id": "guard",
      "name": "Singularity Guard",
      "type": "float",
      "default": 0.1,
      "min": 0.001,
      "max": 2
    },
    {
      "id": "translation_x",
      "name": "Translation X",
      "type": "float",
      "default": 0.5,
      "min": -3,
      "max": 3
    },
    {
      "id": "translation_y",
      "name": "Translation Y",
      "type": "float",
      "default": 0.5,
      "min": -3,
      "max": 3
    },
    {
      "id": "translation_z",
      "name": "Translation Z",
      "type": "float",
      "default": 0.5,
      "min": -3,
      "max": 3
    },
    {
      "id": "trap",
      "name": "Trap Geometry",
      "type": "choice",
      "default": 1,
      "options": [
        "Sphere",
        "Axis",
        "Plane"
      ]
    },
    {
      "id": "axis",
      "name": "Trap Axis",
      "type": "choice",
      "default": 1,
      "options": [
        "X",
        "Y",
        "Z"
      ]
    },
    {
      "id": "radius",
      "name": "Trap Radius",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 5
    },
    {
      "id": "distance_gain",
      "name": "Distance Gain",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    }
  ],
  "helpers": "vec3 maker_scaled_orbit_trap(vec3 p,float count,float center,float gain,float guard,vec3 shift,float trap,float axis,float radius,float distance_gain){\n vec3 q=clamp(p,vec3(-10000.0),vec3(10000.0));\n float ls=0.0;float best=1e38;float best_i=1.0;float best_ls=0.0;\n for(int i=0;i<16;i++){\n  if(float(i)>=floor(count+0.5))break;\n  vec3 folded=abs(q-vec3(center));\n  float factor=max(gain,0.01)/max(dot(folded,folded),max(guard*guard,1e-6));\n  ls+=log(factor);\n  q=clamp(folded*factor-shift,vec3(-10000.0),vec3(10000.0));\n  float axial=axis<0.5?q.x:(axis<1.5?q.y:q.z);\n  vec2 radial=axis<0.5?q.yz:(axis<1.5?q.xz:q.xy);\n  float t=trap<0.5?abs(length(q)-radius):(trap<1.5?abs(length(radial)-radius):abs(axial));\n  float d=t==0.0?0.0:exp(clamp(log(t)-ls+log(max(distance_gain,0.01)),-80.0,80.0));\n  if(d<best){best=d;best_i=float(i+1);best_ls=ls;}\n }\n return vec3(best,best_i,best_ls);\n}",
  "glsl_outputs": {
    "distance": "maker_scaled_orbit_trap({position},{iterations},{fold_center},{gain},{guard},vec3({translation_x},{translation_y},{translation_z}),{trap},{axis},{radius},{distance_gain}).x",
    "closest_iteration": "maker_scaled_orbit_trap({position},{iterations},{fold_center},{gain},{guard},vec3({translation_x},{translation_y},{translation_z}),{trap},{axis},{radius},{distance_gain}).y",
    "log_scale": "maker_scaled_orbit_trap({position},{iterations},{fold_center},{gain},{guard},vec3({translation_x},{translation_y},{translation_z}),{trap},{axis},{radius},{distance_gain}).z"
  }
}
