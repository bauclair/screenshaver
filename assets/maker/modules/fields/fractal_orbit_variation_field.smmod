{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.fields.fractal_orbit_variation_field",
  "name": "Fractal Orbit Variation Field",
  "category": "Fields",
  "header_color": "#557C9C",
  "description": "Evaluates a regularized folded-inversion orbit and accumulates its changing radius into a bounded scalar signal.",
  "uses": "Fractal density masks, orbit-driven emission and procedural coloring.",
  "notes": "Independent orbit-variation formulation using normalized radius changes and weighted accumulation. Self-contained because Maker cannot reevaluate arbitrary connected transforms inside an iteration.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv,0.35)"
    }
  ],
  "outputs": [
    {
      "id": "variation",
      "name": "Orbit Variation",
      "type": "float",
      "semantic_role": "intensity"
    },
    {
      "id": "stability",
      "name": "Orbit Stability",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "parameters": [
    {
      "id": "iterations",
      "name": "Iterations",
      "type": "float",
      "default": 7,
      "min": 1,
      "max": 16
    },
    {
      "id": "inversion",
      "name": "Inversion Gain",
      "type": "float",
      "default": 0.9,
      "min": 0,
      "max": 3
    },
    {
      "id": "radius_floor",
      "name": "Radius Floor",
      "type": "float",
      "default": 0.18,
      "min": 0.001,
      "max": 2
    },
    {
      "id": "offset",
      "name": "Offset",
      "type": "float",
      "default": 0.65,
      "min": -3,
      "max": 3
    },
    {
      "id": "sensitivity",
      "name": "Sensitivity",
      "type": "float",
      "default": 3,
      "min": 0.1,
      "max": 15
    },
    {
      "id": "decay",
      "name": "Accumulation Decay",
      "type": "float",
      "default": 0.84,
      "min": 0.1,
      "max": 1
    }
  ],
  "helpers": "vec2 maker_bcc_orbit_signal(vec3 p,float count,float gain,float radius_floor,float offset,float sensitivity,float decay){\n vec3 q=p;float last=length(q);float total=0.0;float weight=1.0;float weights=0.0;\n for(int i=0;i<16;i++){\n  if(float(i)>=floor(count+0.5))break;\n  vec3 f=abs(q+vec3(0.21,-0.17,0.09));\n  float r2=max(dot(f,f),radius_floor*radius_floor);\n  q=clamp(gain*f/r2-vec3(offset,offset*0.61,offset*1.13),vec3(-10000.0),vec3(10000.0));\n  float current=length(q);\n  float change=abs(current-last)/(1.0+current+last);\n  total+=weight*(1.0-exp(-sensitivity*change));\n  weights+=weight;\n  weight*=clamp(decay,0.1,1.0);\n  last=current;\n }\n float v=clamp(total/max(weights,0.00001),0.0,1.0);\n return vec2(v,1.0-v);\n}",
  "glsl_outputs": {
    "variation": "maker_bcc_orbit_signal({position},{iterations},{inversion},{radius_floor},{offset},{sensitivity},{decay}).x",
    "stability": "maker_bcc_orbit_signal({position},{iterations},{inversion},{radius_floor},{offset},{sensitivity},{decay}).y"
  }
}
