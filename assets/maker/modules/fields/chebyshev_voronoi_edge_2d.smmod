{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.fields.chebyshev_voronoi_edge_2d",
  "name": "Chebyshev Voronoi Edge Field 2D",
  "category": "Fields",
  "header_color": "#348F8B",
  "description": "Nearest and second-nearest feature-site distances under the Chebyshev metric, with a soft cell-boundary mask.",
  "uses": "Angular cellular boundaries, square-like networks, animated procedural line patterns, and scalar masks.",
  "notes": "Independent implementation of standard Chebyshev metric and nearest/second-nearest distance statistics. Sites use a deterministic cell hash; optional bounded periodic motion. No third-party shader code is included. Density changes coordinate units; output distances are in scaled cell units.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv"
    }
  ],
  "outputs": [
    {
      "id": "nearest",
      "name": "Nearest Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "second",
      "name": "Second Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "boundary",
      "name": "Boundary Difference",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "mask",
      "name": "Edge Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "parameters": [
    {
      "id": "density",
      "name": "Cell Density",
      "type": "float",
      "default": 5.0,
      "min": 0.1,
      "max": 30.0
    },
    {
      "id": "jitter",
      "name": "Site Jitter",
      "type": "float",
      "default": 0.65,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "motion",
      "name": "Motion Amplitude",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "speed",
      "name": "Motion Speed",
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 5.0
    },
    {
      "id": "width",
      "name": "Edge Width",
      "type": "float",
      "default": 0.12,
      "min": 0.001,
      "max": 1.0
    }
  ],
  "helpers": "vec2 maker_cv2_hash(vec2 cell) {\n    vec2 a = vec2(dot(cell, vec2(19.19, 83.17)), dot(cell, vec2(47.23, 11.71)));\n    return fract(sin(a) * vec2(15427.37, 9237.13));\n}\nvec2 maker_cv2_f12(vec2 position, float density, float jitter, float motion, float speed) {\n    vec2 q = position * max(density, 0.001);\n    vec2 base = floor(q);\n    vec2 f = fract(q);\n    float first = 1e6;\n    float second = 1e6;\n    float j = clamp(jitter, 0.0, 1.0);\n    float a = clamp(motion, 0.0, 1.0) * 0.22;\n    for (int y = -1; y <= 1; ++y) {\n        for (int x = -1; x <= 1; ++x) {\n            vec2 cellOffset = vec2(float(x), float(y));\n            vec2 h = maker_cv2_hash(base + cellOffset);\n            vec2 phase = 6.28318530718 * h;\n            vec2 drift = a * sin(vec2(u_time * speed) + phase);\n            vec2 site = cellOffset + vec2(0.5) + j * (h - vec2(0.5)) + drift;\n            vec2 delta = abs(site - f);\n            float d = max(delta.x, delta.y);\n            if (d < first) { second = first; first = d; }\n            else if (d < second) { second = d; }\n        }\n    }\n    return vec2(first, second);\n}\n",
  "glsl_outputs": {
    "nearest": "maker_cv2_f12({position},{density},{jitter},{motion},{speed}).x",
    "second": "maker_cv2_f12({position},{density},{jitter},{motion},{speed}).y",
    "boundary": "(maker_cv2_f12({position},{density},{jitter},{motion},{speed}).y-maker_cv2_f12({position},{density},{jitter},{motion},{speed}).x)",
    "mask": "(1.0-smoothstep(0.0,max({width},0.0001),maker_cv2_f12({position},{density},{jitter},{motion},{speed}).y-maker_cv2_f12({position},{density},{jitter},{motion},{speed}).x))"
  }
}
