{
  "schema_version": 1,
  "id": "screenshaver.fields.adaptive_procedural_ray_traversal",
  "name": "Adaptive Procedural Ray Traversal",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#477D9A",
  "description": "Traverses a connected position-dependent 3D scalar field with bounded adaptive steps and opacity-weighted response accumulation.",
  "uses": "Procedural volumetric structures, glow paths, tunnels and non-SDF scalar fields.",
  "notes": "Requires a connected callable Field 3D. The field is sampled anew at each ray position. Response is exp(-abs(field)*Response Sharpness); positive step lengths vary between Minimum Step and Maximum Step. Accumulation uses exponential opacity and transmittance, not SDF surface intersection. At most 96 iterations. Invalid or zero-length ray directions yield zero response and no traversal.",
  "inputs": [
    {
      "id": "field",
      "name": "Scalar Field",
      "type": "field3d"
    },
    {
      "id": "origin",
      "name": "Ray Origin",
      "type": "vec3",
      "default": "vec3(0.0,0.0,-2.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "direction",
      "name": "Ray Direction",
      "type": "vec3",
      "default": "normalize(vec3(maker_uv,1.5))",
      "semantic_role": "direction3d"
    }
  ],
  "outputs": [
    {
      "id": "intensity",
      "name": "Accumulated Intensity",
      "type": "float"
    },
    {
      "id": "distance",
      "name": "Travelled Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "end_position",
      "name": "Final Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "transmittance",
      "name": "Transmittance",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "max_distance",
      "name": "Maximum Distance",
      "type": "float",
      "default": 12,
      "min": 0.1,
      "max": 100
    },
    {
      "id": "min_step",
      "name": "Minimum Step",
      "type": "float",
      "default": 0.025,
      "min": 0.001,
      "max": 1
    },
    {
      "id": "max_step",
      "name": "Maximum Step",
      "type": "float",
      "default": 0.25,
      "min": 0.01,
      "max": 3
    },
    {
      "id": "response_sharpness",
      "name": "Response Sharpness",
      "type": "float",
      "default": 4,
      "min": 0.1,
      "max": 40
    },
    {
      "id": "opacity_gain",
      "name": "Opacity Gain",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 10
    },
    {
      "id": "adaptivity",
      "name": "Adaptivity",
      "type": "float",
      "default": 0.75,
      "min": 0,
      "max": 1
    },
    {
      "id": "max_steps",
      "name": "Maximum Steps",
      "type": "float",
      "default": 64,
      "min": 1,
      "max": 96
    }
  ],
  "helpers": "",
  "glsl_outputs": {
    "intensity": "0.0",
    "distance": "0.0",
    "end_position": "vec3(0.0)",
    "transmittance": "1.0"
  }
}
