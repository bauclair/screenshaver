{
  "schema_version": 1,
  "id": "screenshaver.fields.traversal",
  "name": "Field Traversal",
  "category": "Fields",
  "created_by": "Screenshaver",
  "header_color": "#477D9A",
  "description": "Samples an animated 3D field along a view ray and returns accumulated illumination.",
  "uses": "Procedural volumetric streaks, layered light, and glowing abstract shapes.",
  "notes": "Self-contained ray traversal. Optional Seed Field input biases density using a Morphing Field value; the internal 3D field is re-evaluated at every ray step. This is not yet a generic callback-based traversal of an upstream field.",
  "inputs": [
    {
      "id": "seed",
      "name": "Seed Field",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "light",
      "name": "Light",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "depth",
      "name": "Depth",
      "type": "float",
      "default": 2.5,
      "min": 0.2,
      "max": 8.0
    },
    {
      "id": "density",
      "name": "Density",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0
    }
  ],
  "helpers": "float maker_trav_hash(vec3 p){return fract(sin(dot(p,vec3(127.1,311.7,74.7)))*43758.5453);}\nfloat maker_trav_noise(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);float a=mix(maker_trav_hash(i),maker_trav_hash(i+vec3(1,0,0)),f.x);float b=mix(maker_trav_hash(i+vec3(0,1,0)),maker_trav_hash(i+vec3(1,1,0)),f.x);float c=mix(maker_trav_hash(i+vec3(0,0,1)),maker_trav_hash(i+vec3(1,0,1)),f.x);float d=mix(maker_trav_hash(i+vec3(0,1,1)),maker_trav_hash(i+vec3(1,1,1)),f.x);return mix(mix(a,b,f.y),mix(c,d,f.y),f.z);}\nvec3 maker_traverse(vec3 origin,float seed,float depth,float density,float speed){vec3 ray=normalize(vec3(origin.xy,1.25));vec3 sum=vec3(0.0);float t=u_time*speed;for(int k=0;k<10;k++){float z=(float(k)+0.5)*depth/10.0;vec3 p=vec3(origin.xy,-1.0)+ray*z;float n=maker_trav_noise(p*2.0+vec3(0.0,0.0,t*0.3));float wave=sin(p.x*2.1+t)*cos(p.y*1.7-t*0.6);float field=(n-0.5)+0.25*wave+seed*0.25;float weight=density*exp(-abs(field)*4.0)/(1.0+0.25*z*z);vec3 phase=vec3(0.0,2.1,4.2);sum+=weight*(0.5+0.5*sin(t*0.4+z*2.0+phase));}return sum/10.0;}",
  "glsl": "maker_traverse({position},{seed},{depth},{density},{speed})",
  "terminal": false
}
