{
  "schema_version": 1,
  "id": "screenshaver.fields.traversal",
  "name": "Field Traversal",
  "category": "Fields",
  "created_by": "Screenshaver",
  "header_color": "#477D9A",
  "description": "Samples an animated 3D field along a view ray and returns accumulated illumination.",
  "uses": "Procedural volumetric streaks, layered light, and glowing abstract shapes.",
  "notes": "Fixed or adaptive traversal. In adaptive mode Depth=2.5, Density=1 and Speed=0.5 are neutral; small distances are bounded for numerical stability. Connect Morphing Field for a field-driven traversal.",
  "inputs": [
    {
      "id": "seed",
      "name": "Seed Field",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "light",
      "name": "Light",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "depth",
      "name": "Depth",
      "type": "float",
      "default": 2.5,
      "min": 0.2,
      "max": 8.0
    },
    {
      "id": "density",
      "name": "Density",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "mode",
      "name": "Processing Mode",
      "type": "choice",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "options": [
        "Fixed samples",
        "Adaptive steps"
      ]
    }
  ],
  "helpers": "float maker_trav_hash(vec3 p){return fract(sin(dot(p,vec3(127.1,311.7,74.7)))*43758.5453);}\nfloat maker_trav_noise(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);float a=mix(maker_trav_hash(i),maker_trav_hash(i+vec3(1,0,0)),f.x);float b=mix(maker_trav_hash(i+vec3(0,1,0)),maker_trav_hash(i+vec3(1,1,0)),f.x);float c=mix(maker_trav_hash(i+vec3(0,0,1)),maker_trav_hash(i+vec3(1,0,1)),f.x);float d=mix(maker_trav_hash(i+vec3(0,1,1)),maker_trav_hash(i+vec3(1,1,1)),f.x);return mix(mix(a,b,f.y),mix(c,d,f.y),f.z);}\nvec3 maker_traverse(vec3 origin,float seed,float depth,float density,float speed){vec3 ray=normalize(vec3(origin.xy,1.25));vec3 sum=vec3(0.0);float t=u_time*speed;for(int k=0;k<10;k++){float z=(float(k)+0.5)*depth/10.0;vec3 p=vec3(origin.xy,-1.0)+ray*z;float n=maker_trav_noise(p*2.0+vec3(0.0,0.0,t*0.3));float wave=sin(p.x*2.1+t)*cos(p.y*1.7-t*0.6);float field=(n-0.5)+0.25*wave+seed*0.25;float weight=density*exp(-abs(field)*4.0)/(1.0+0.25*z*z);vec3 phase=vec3(0.0,2.1,4.2);sum+=weight*(0.5+0.5*sin(t*0.4+z*2.0+phase));}return sum/10.0;}\nfloat maker_trav_dot_noise_3d(vec3 p){const float PHI=1.618033988;const mat3 GOLD=mat3(-0.571464913,0.814921382,0.096597072,-0.278044873,-0.303026659,0.911518454,0.772087367,0.494042493,0.399753815);return dot(cos(GOLD*p),sin(PHI*p*GOLD));}\nfloat maker_trav_original_distance(vec3 p){vec3 b=p;float t=u_time;b.xy=sin(b.xy*0.25);float cs=cos(t*0.5+b.z*2.0),sn=sin(t*0.5+b.z*2.0);b.xy=mat2(cs,-sn,sn,cs)*b.xy;float s=0.001+abs(maker_trav_dot_noise_3d(b*20.0)/20.0-maker_trav_dot_noise_3d(b))*0.7;return s+abs(p.y*0.2+sin(p.z*2.0+abs(p.x)*0.5))*0.5;}\nvec3 maker_traverse_adaptive(vec3 origin,float depth,float density,float speed){vec3 p=vec3(0.0,0.0,-1.0-0.5*sin(u_time*(speed/0.5)*0.1));vec3 d=normalize(vec3(origin.xy,1.0));vec3 light=vec3(0.0);for(int k=0;k<10;k++){float s=max(maker_trav_original_distance(p),0.02);float stride=s*(depth/2.5);p+=d*stride;light+=density*(1.0+1.5*sin(float(k)+length(p.xy*0.1)+2.0+vec3(3.0,1.5,0.5)))/s;}return light;}",
  "glsl": "mix(maker_traverse({position},{seed},{depth},{density},{speed}),maker_traverse_adaptive({position},{depth},{density},{speed}),step(0.5,{mode}))",
  "terminal": false
}
