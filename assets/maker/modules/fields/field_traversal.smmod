{
  "schema_version": 1,
  "id": "screenshaver.fields.traversal",
  "name": "Field Traversal",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#477D9A",
  "description": "Integrates an animated procedural density field along a view ray.",
  "uses": "Procedural volumetric streaks, layered light, and glowing abstract shapes.",
  "notes": "Fixed samples use uniform depth intervals; adaptive steps use smaller intervals where the sampled field is stronger. Seed Field influences both modes.",
  "inputs": [
    {
      "id": "seed",
      "name": "Seed Field",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "light",
      "name": "Light",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "depth",
      "name": "Depth",
      "type": "float",
      "default": 2.5,
      "min": 0.2,
      "max": 8.0
    },
    {
      "id": "density",
      "name": "Density",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0
    },
    {
      "id": "mode",
      "name": "Processing Mode",
      "type": "choice",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "options": [
        "Fixed samples",
        "Adaptive steps"
      ]
    }
  ],
  "helpers": "float maker_trav_density(vec3 p, float seed, float time) {\n    float w1 = sin(2.3 * p.x + 0.7 * time) * cos(1.8 * p.y - time);\n    float w2 = sin(1.4 * p.z - 0.3 * time + 1.2 * p.y);\n    float field = 0.5 + 0.25 * w1 + 0.2 * w2 + 0.1 * (seed / sqrt(1.0 + seed * seed));\n    return clamp(field, 0.0, 1.0);\n}\nvec3 maker_traverse(vec3 origin, float seed, float depth, float density, float speed, float mode) {\n    vec3 direction = normalize(vec3(origin.xy, 1.0));\n    float travel = 0.0;\n    float t = u_time * speed;\n    vec3 sum = vec3(0.0);\n    for (int k = 0; k < 16; ++k) {\n        float baseStep = depth / 16.0;\n        vec3 samplePos = vec3(origin.xy, -1.0) + direction * (travel + 0.5 * baseStep);\n        float field = maker_trav_density(samplePos, seed, t);\n        float adaptive = mix(1.0, 0.45 + 0.8 * (1.0 - field), step(0.5, mode));\n        float stride = min(baseStep * adaptive, max(depth - travel, 0.0));\n        vec3 tint = 0.55 + 0.45 * cos(vec3(0.0, 2.1, 4.2) + 0.6 * t + 1.5 * travel);\n        sum += tint * field * density * stride / (1.0 + 0.2 * travel * travel);\n        travel += stride;\n        if (travel >= depth) break;\n    }\n    return sum / max(depth, 0.001);\n}",
  "glsl": "maker_traverse({position},{seed},{depth},{density},{speed},{mode})",
  "terminal": false
}
