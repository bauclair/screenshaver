{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.fields.harmonic_polar_curve_field_2d",
  "name": "Harmonic Polar Curve Field 2D",
  "category": "Fields",
  "header_color": "#557C9C",
  "description": "A harmonic radial curve expressed as signed radial error.",
  "uses": "Rosettes, radial contours and animated geometric masks.",
  "notes": "Radial error is not exact Euclidean curve distance. Integer harmonics close at the angular seam.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv"
    }
  ],
  "outputs": [
    {
      "id": "error",
      "name": "Radial Error",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "mask",
      "name": "Curve Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Mean Radius",
      "type": "float",
      "default": 0.45,
      "min": 0,
      "max": 4
    },
    {
      "id": "amplitude",
      "name": "Amplitude",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 4
    },
    {
      "id": "frequency",
      "name": "Harmonic Frequency",
      "type": "float",
      "default": 5,
      "min": 1,
      "max": 32
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 0,
      "min": -6.283185,
      "max": 6.283185
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 0.3,
      "min": -5,
      "max": 5
    },
    {
      "id": "width",
      "name": "Half Width",
      "type": "float",
      "default": 0.012,
      "min": 0.001,
      "max": 0.2
    },
    {
      "id": "softness",
      "name": "Edge Softness",
      "type": "float",
      "default": 0.008,
      "min": 0.001,
      "max": 0.2
    }
  ],
  "helpers": "float maker_harmonic_polar_error(vec2 q,float radius,float amplitude,float frequency,float phase){\n float r=length(q);\n float angle=r>1e-7?atan(q.y,q.x):0.0;\n float target=max(0.0,radius+amplitude*cos(floor(frequency+0.5)*angle+phase));\n return r-target;\n}\nfloat maker_harmonic_polar_mask(float error,float width,float softness){\n return 1.0-smoothstep(max(width,0.0),max(width,0.0)+max(softness,1e-5),abs(error));\n}",
  "glsl_outputs": {
    "error": "maker_harmonic_polar_error({position},{radius},{amplitude},{frequency},{phase}+u_time*{speed})",
    "mask": "maker_harmonic_polar_mask(maker_harmonic_polar_error({position},{radius},{amplitude},{frequency},{phase}+u_time*{speed}),{width},{softness})"
  }
}
