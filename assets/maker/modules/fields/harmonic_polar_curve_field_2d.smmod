{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.fields.harmonic_polar_curve_field_2d",
  "name": "Harmonic Polar Curve Field 2D",
  "category": "Fields",
  "header_color": "#557C9C",
  "description": "A harmonic radial curve expressed as signed radial error.",
  "uses": "Rosettes, radial contours and animated geometric masks.",
  "notes": "Radial error is not exact Euclidean curve distance. Integer harmonics close at the angular seam.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv"
    },
    {
      "id": "angular_origin",
      "name": "Angular Origin",
      "type": "vec2",
      "default": "vec2(0.0)"
    }
  ],
  "outputs": [
    {
      "id": "error",
      "name": "Radial Error",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "mask",
      "name": "Curve Mask",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "filled_mask",
      "name": "Filled Mask",
      "type": "float"
    },
    {
      "id": "target_radius",
      "name": "Target Radius",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Mean Radius",
      "type": "float",
      "default": 0.45,
      "min": 0,
      "max": 4
    },
    {
      "id": "amplitude",
      "name": "Amplitude",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 4
    },
    {
      "id": "frequency",
      "name": "Harmonic Frequency",
      "type": "float",
      "default": 5,
      "min": 1,
      "max": 32
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 0,
      "min": -6.283185,
      "max": 6.283185
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 0.3,
      "min": -5,
      "max": 5
    },
    {
      "id": "width",
      "name": "Half Width",
      "type": "float",
      "default": 0.012,
      "min": 0.001,
      "max": 0.2
    },
    {
      "id": "softness",
      "name": "Edge Softness",
      "type": "float",
      "default": 0.008,
      "min": 0.001,
      "max": 0.2
    },
    {
      "id": "harmonic_mode",
      "name": "Harmonic Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Single",
        "Sum",
        "Product",
        "Absolute Product"
      ]
    },
    {
      "id": "secondary_frequency",
      "name": "Secondary Frequency",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 32
    },
    {
      "id": "secondary_phase",
      "name": "Secondary Phase",
      "type": "float",
      "default": 0,
      "min": -6.283185,
      "max": 6.283185
    }
  ],
  "helpers": "float maker_harmonic_polar_error(vec2 q,float radius,float amplitude,float frequency,float phase,vec2 origin,float mode,float f2,float p2){\n float r=length(q);\n vec2 v=q-origin;float angle=length(v)>1e-7?atan(v.y,v.x):0.0;float a=cos(floor(frequency+0.5)*angle+phase),b=cos(round(f2)*angle+p2);float h=mode<.5?a:mode<1.5?.5*(a+b):mode<2.5?a*b:abs(a*b);\n float target=max(0.0,radius+amplitude*h);\n return r-target;\n}\nfloat maker_harmonic_polar_mask(float error,float width,float softness){\n return 1.0-smoothstep(max(width,0.0),max(width,0.0)+max(softness,1e-5),abs(error));\n}",
  "glsl_outputs": {
    "error": "maker_harmonic_polar_error({position},{radius},{amplitude},{frequency},{phase}+u_time*{speed},{angular_origin},{harmonic_mode},{secondary_frequency},{secondary_phase})",
    "mask": "maker_harmonic_polar_mask(maker_harmonic_polar_error({position},{radius},{amplitude},{frequency},{phase}+u_time*{speed},{angular_origin},{harmonic_mode},{secondary_frequency},{secondary_phase}),{width},{softness})",
    "filled_mask": "(1.0-smoothstep(0.0,max({softness},1e-5),maker_harmonic_polar_error({position},{radius},{amplitude},{frequency},{phase}+u_time*{speed},{angular_origin},{harmonic_mode},{secondary_frequency},{secondary_phase})))",
    "target_radius": "(length({position})-maker_harmonic_polar_error({position},{radius},{amplitude},{frequency},{phase}+u_time*{speed},{angular_origin},{harmonic_mode},{secondary_frequency},{secondary_phase}))"
  }
}
