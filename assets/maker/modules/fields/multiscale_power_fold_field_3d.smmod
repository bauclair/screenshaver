{
  "schema_version": 1,
  "id": "screenshaver.fields.multiscale_power_fold_field_3d",
  "name": "Multiscale Power-Fold Field 3D",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Normalized periodic power field, not an exact SDF or conservative ray step. Dominant layer denotes maximum response.",
  "uses": "Multiscale Power-Fold Field 3D",
  "notes": "Normalized periodic power field, not an exact SDF or conservative ray step. Dominant layer denotes maximum response.",
  "header_color": "#348F8B",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "scale_multiplier",
      "name": "Scale Multiplier",
      "type": "float",
      "default": "1.0"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "scalar_field",
      "name": "Scalar Field",
      "type": "float"
    },
    {
      "id": "folded_coordinates",
      "name": "Folded Coordinates",
      "type": "vec3"
    },
    {
      "id": "dominant_layer",
      "name": "Dominant Layer",
      "type": "float"
    },
    {
      "id": "folded_radius",
      "name": "Folded Radius",
      "type": "float"
    },
    {
      "id": "mean_response",
      "name": "Mean Response",
      "type": "float"
    },
    {
      "id": "peak_response",
      "name": "Peak Response",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "layer_count",
      "name": "Layer Count",
      "type": "float",
      "default": 4,
      "min": 1,
      "max": 12
    },
    {
      "id": "cell_period",
      "name": "Cell Period",
      "type": "float",
      "default": 2,
      "min": 0.05,
      "max": 20
    },
    {
      "id": "power_exponent",
      "name": "Power Exponent",
      "type": "float",
      "default": 4,
      "min": 1,
      "max": 16
    },
    {
      "id": "initial_frequency",
      "name": "Initial Frequency",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 10
    },
    {
      "id": "frequency_progression",
      "name": "Frequency Progression",
      "type": "float",
      "default": 1.5,
      "min": 1,
      "max": 3
    },
    {
      "id": "amplitude_decay",
      "name": "Amplitude Decay",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
      "id": "field_radius",
      "name": "Field Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.01,
      "max": 2
    },
    {
      "id": "response_strength",
      "name": "Response Strength",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 10
    },
    {
      "id": "animation_speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 0,
      "min": -5,
      "max": 5
    },
    {
      "id": "component_combination",
      "name": "Component Combination",
      "type": "choice",
      "default": 0,
      "options": [
        "Maximum",
        "Minimum",
        "Mean"
      ]
    },
    {
      "id": "layer_combination",
      "name": "Layer Combination",
      "type": "choice",
      "default": 0,
      "options": [
        "Maximum",
        "Minimum",
        "Weighted Sum"
      ]
    }
  ],
  "helpers": "struct MakerB344MultiscalePowerFoldField3D {float scalar_field;vec3 folded_coordinates;float dominant_layer;float folded_radius;float mean_response;float peak_response;};\nMakerB344MultiscalePowerFoldField3D maker_b344_multiscale_power_fold_field_3d(vec3 position,vec3 center,float scale_multiplier,float time_offset,float layer_count,float cell_period,float power_exponent,float initial_frequency,float frequency_progression,float amplitude_decay,float field_radius,float response_strength,float animation_speed,float component_combination,float layer_combination,float tm){\nint n=int(clamp(round(layer_count),1.,12.));float period=max(cell_period,.05),freq=initial_frequency,amp=1.,sumv=0.,peak=-1e20,low=1e20,idx=0.;vec3 best=vec3(0.);for(int j=0;j<12;j++){if(j>=n)break;vec3 q=2.*(fract((position-center)*scale_multiplier*freq/period+vec3(.5+animation_speed*(tm+time_offset)))-.5);vec3 v=pow(abs(q),vec3(power_exponent));float c=component_combination<.5?max(v.x,max(v.y,v.z)):(component_combination<1.5?min(v.x,min(v.y,v.z)):(v.x+v.y+v.z)/3.);float r=(c-field_radius)*amp*response_strength;sumv+=r;low=min(low,r);if(r>peak){peak=r;idx=float(j);best=sign(q)*v;}freq=min(freq*frequency_progression,1e6);amp*=amplitude_decay;}return MakerB344MultiscalePowerFoldField3D(layer_combination<.5?peak:(layer_combination<1.5?low:sumv),best,idx,length(best),sumv/float(n),peak);\n}",
  "glsl_outputs": {
    "scalar_field": "maker_b344_multiscale_power_fold_field_3d({position},{center},{scale_multiplier},{time_offset},{layer_count},{cell_period},{power_exponent},{initial_frequency},{frequency_progression},{amplitude_decay},{field_radius},{response_strength},{animation_speed},{component_combination},{layer_combination},u_time).scalar_field",
    "folded_coordinates": "maker_b344_multiscale_power_fold_field_3d({position},{center},{scale_multiplier},{time_offset},{layer_count},{cell_period},{power_exponent},{initial_frequency},{frequency_progression},{amplitude_decay},{field_radius},{response_strength},{animation_speed},{component_combination},{layer_combination},u_time).folded_coordinates",
    "dominant_layer": "maker_b344_multiscale_power_fold_field_3d({position},{center},{scale_multiplier},{time_offset},{layer_count},{cell_period},{power_exponent},{initial_frequency},{frequency_progression},{amplitude_decay},{field_radius},{response_strength},{animation_speed},{component_combination},{layer_combination},u_time).dominant_layer",
    "folded_radius": "maker_b344_multiscale_power_fold_field_3d({position},{center},{scale_multiplier},{time_offset},{layer_count},{cell_period},{power_exponent},{initial_frequency},{frequency_progression},{amplitude_decay},{field_radius},{response_strength},{animation_speed},{component_combination},{layer_combination},u_time).folded_radius",
    "mean_response": "maker_b344_multiscale_power_fold_field_3d({position},{center},{scale_multiplier},{time_offset},{layer_count},{cell_period},{power_exponent},{initial_frequency},{frequency_progression},{amplitude_decay},{field_radius},{response_strength},{animation_speed},{component_combination},{layer_combination},u_time).mean_response",
    "peak_response": "maker_b344_multiscale_power_fold_field_3d({position},{center},{scale_multiplier},{time_offset},{layer_count},{cell_period},{power_exponent},{initial_frequency},{frequency_progression},{amplitude_decay},{field_radius},{response_strength},{animation_speed},{component_combination},{layer_combination},u_time).peak_response"
  }
}
