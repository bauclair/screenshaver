{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.fields.harmonic_radial_curve_accumulation",
  "name": "Harmonic Radial Curve Accumulation",
  "category": "Fields",
  "header_color": "#557C9C",
  "description": "Accumulates phase-offset harmonic radial contours with a cyclic color gradient.",
  "uses": "Layered rosettes, luminous radial patterns and spectral geometry.",
  "notes": "Count is rounded to an integer. RGB is additive and may exceed one; use downstream tone mapping. Phase spacing and hue cycles are independent.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv"
    }
  ],
  "outputs": [
    {
      "id": "color",
      "name": "Color",
      "type": "vec3",
      "semantic_role": "color"
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Mean Radius",
      "type": "float",
      "default": 0.45,
      "min": 0,
      "max": 4
    },
    {
      "id": "amplitude",
      "name": "Amplitude",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 4
    },
    {
      "id": "frequency",
      "name": "Harmonic Frequency",
      "type": "float",
      "default": 5,
      "min": 1,
      "max": 32
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 0,
      "min": -6.283185,
      "max": 6.283185
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 0.3,
      "min": -5,
      "max": 5
    },
    {
      "id": "width",
      "name": "Half Width",
      "type": "float",
      "default": 0.012,
      "min": 0.001,
      "max": 0.2
    },
    {
      "id": "softness",
      "name": "Edge Softness",
      "type": "float",
      "default": 0.008,
      "min": 0.001,
      "max": 0.2
    },
    {
      "id": "count",
      "name": "Curve Count",
      "type": "float",
      "default": 12,
      "min": 1,
      "max": 64
    },
    {
      "id": "spacing",
      "name": "Phase Spacing",
      "type": "float",
      "default": 0.5,
      "min": -6.283185,
      "max": 6.283185
    },
    {
      "id": "hue_cycles",
      "name": "Hue Cycles",
      "type": "float",
      "default": 1,
      "min": -4,
      "max": 4
    },
    {
      "id": "gain",
      "name": "Accumulation Strength",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 4
    }
  ],
  "helpers": "vec3 maker_harmonic_radial_accumulate(vec2 q,float radius,float amplitude,float frequency,float phase,float width,float softness,float count,float spacing,float hueCycles,float gain){\n float r=length(q);\n float theta=r>1e-7?atan(q.y,q.x):0.0;\n float harmonic=floor(frequency+0.5)*theta;\n int n=int(clamp(floor(count+0.5),1.0,64.0));\n vec3 total=vec3(0.0);\n for(int k=0;k<64;++k){\n  if(k>=n)break;\n  float target=max(0.0,radius+amplitude*cos(harmonic+phase+float(k)*spacing));\n  float weight=1.0-smoothstep(max(width,0.0),max(width,0.0)+max(softness,1e-5),abs(r-target));\n  float hue=fract(float(k)/float(n)*hueCycles);\n  vec3 rgb=clamp(abs(fract(vec3(hue)+vec3(0.0,0.6666667,0.3333333))*6.0-3.0)-1.0,0.0,1.0);\n  total+=weight*rgb;\n }\n return total*max(gain,0.0);\n}",
  "glsl": "maker_harmonic_radial_accumulate({position},{radius},{amplitude},{frequency},{phase}+u_time*{speed},{width},{softness},{count},{spacing},{hue_cycles},{gain})"
}
