{
  "schema_version": 1,
  "id": "screenshaver.fields.traveling_segment_pulse_field_2d",
  "name": "Traveling Segment Pulse Field 2D",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Pulse length and phase in segment fractions; pulse position identifies nearest pulse center. Up to sixteen pulses; single pass ends outside phase 0\u20131.",
  "uses": "Traveling Segment Pulse Field 2D",
  "notes": "Pulse length and phase in segment fractions; pulse position identifies nearest pulse center. Up to sixteen pulses; single pass ends outside phase 0\u20131.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "position2d"
    },
    {
      "id": "start_point",
      "name": "Start Point",
      "type": "vec2",
      "default": "vec2(-0.5,0.0)"
    },
    {
      "id": "end_point",
      "name": "End Point",
      "type": "vec2",
      "default": "vec2(0.5,0.0)"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "phase_offset",
      "name": "Phase Offset",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "width_multiplier",
      "name": "Width Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "pulse_intensity",
      "name": "Pulse Intensity",
      "type": "float"
    },
    {
      "id": "segment_mask",
      "name": "Segment Mask",
      "type": "float"
    },
    {
      "id": "pulse_mask",
      "name": "Pulse Mask",
      "type": "float"
    },
    {
      "id": "segment_fraction",
      "name": "Segment Fraction",
      "type": "float"
    },
    {
      "id": "segment_distance",
      "name": "Segment Distance",
      "type": "float"
    },
    {
      "id": "pulse_position",
      "name": "Pulse Position",
      "type": "vec2"
    }
  ],
  "parameters": [
    {
      "id": "line_width",
      "name": "Line Width",
      "default": 0.025,
      "type": "float",
      "min": 0.0001,
      "max": 10
    },
    {
      "id": "pulse_length",
      "name": "Pulse Length",
      "default": 0.25,
      "type": "float",
      "min": 0.001,
      "max": 1
    },
    {
      "id": "travel_speed",
      "name": "Travel Speed",
      "default": 0.5,
      "type": "float",
      "min": -10,
      "max": 10
    },
    {
      "id": "pulse_count",
      "name": "Pulse Count",
      "default": 1,
      "type": "float",
      "min": 1,
      "max": 16
    },
    {
      "id": "base_intensity",
      "name": "Base Intensity",
      "default": 0.1,
      "type": "float",
      "min": 0,
      "max": 10
    },
    {
      "id": "pulse_intensity_scale",
      "name": "Pulse Intensity Scale",
      "default": 1,
      "type": "float",
      "min": 0,
      "max": 10
    },
    {
      "id": "edge_softness",
      "name": "Edge Softness",
      "default": 0.01,
      "type": "float",
      "min": 0,
      "max": 1
    },
    {
      "id": "travel_mode",
      "name": "Travel Mode",
      "default": 0,
      "type": "choice",
      "options": [
        "Forward",
        "Reverse",
        "Ping-Pong",
        "Single Pass"
      ]
    },
    {
      "id": "pulse_profile",
      "name": "Pulse Profile",
      "default": 0,
      "type": "choice",
      "options": [
        "Smooth",
        "Gaussian",
        "Triangular",
        "Exponential"
      ]
    }
  ],
  "helpers": "struct MakerB336TravelingSegmentPulseField2D {float pulse_intensity;float segment_mask;float pulse_mask;float segment_fraction;float segment_distance;vec2 pulse_position;};\nMakerB336TravelingSegmentPulseField2D maker_b336_traveling_segment_pulse_field_2d(vec2 position,vec2 start_point,vec2 end_point,float time_offset,float phase_offset,float width_multiplier,float line_width,float pulse_length,float travel_speed,float pulse_count,float base_intensity,float pulse_intensity_scale,float edge_softness,float travel_mode,float pulse_profile,float tm){\nvec2 e=end_point-start_point;float l=dot(e,e);float s=l>1e-12?clamp(dot(position-start_point,e)/l,0.,1.):0.;float d=length(position-start_point-s*e);float w=line_width*abs(width_multiplier);float mask=edge_softness>0.?1.-smoothstep(w,w+edge_softness,d):step(d,w);float t=(tm+time_offset)*travel_speed+phase_offset;float n=clamp(round(pulse_count),1.,16.);float p=travel_mode<.5?fract(t):(travel_mode<1.5?1.-fract(t):(travel_mode<2.5?1.-abs(2.*fract(t*.5)-1.):clamp(t,0.,1.)));float best=1e30,cp=p;for(int i=0;i<16;i++){if(float(i)>=n)break;float q=travel_mode>2.5?p-float(i)/n:fract(p+float(i)/n);float v=abs(s-q);if(v<best){best=v;cp=q;}}float x=best/max(pulse_length*.5,1e-6);float a=pulse_profile<.5?1.-smoothstep(0.,1.,x):(pulse_profile<1.5?exp(-4.*x*x):(pulse_profile<2.5?max(0.,1.-x):exp(-4.*x)));if(travel_mode>2.5&&(t<0.||t>1.))a=0.;return MakerB336TravelingSegmentPulseField2D(mask*(base_intensity+pulse_intensity_scale*a),mask,mask*a,s,d,start_point+clamp(cp,0.,1.)*e);\n}",
  "glsl_outputs": {
    "pulse_intensity": "maker_b336_traveling_segment_pulse_field_2d({position},{start_point},{end_point},{time_offset},{phase_offset},{width_multiplier},{line_width},{pulse_length},{travel_speed},{pulse_count},{base_intensity},{pulse_intensity_scale},{edge_softness},{travel_mode},{pulse_profile},u_time).pulse_intensity",
    "segment_mask": "maker_b336_traveling_segment_pulse_field_2d({position},{start_point},{end_point},{time_offset},{phase_offset},{width_multiplier},{line_width},{pulse_length},{travel_speed},{pulse_count},{base_intensity},{pulse_intensity_scale},{edge_softness},{travel_mode},{pulse_profile},u_time).segment_mask",
    "pulse_mask": "maker_b336_traveling_segment_pulse_field_2d({position},{start_point},{end_point},{time_offset},{phase_offset},{width_multiplier},{line_width},{pulse_length},{travel_speed},{pulse_count},{base_intensity},{pulse_intensity_scale},{edge_softness},{travel_mode},{pulse_profile},u_time).pulse_mask",
    "segment_fraction": "maker_b336_traveling_segment_pulse_field_2d({position},{start_point},{end_point},{time_offset},{phase_offset},{width_multiplier},{line_width},{pulse_length},{travel_speed},{pulse_count},{base_intensity},{pulse_intensity_scale},{edge_softness},{travel_mode},{pulse_profile},u_time).segment_fraction",
    "segment_distance": "maker_b336_traveling_segment_pulse_field_2d({position},{start_point},{end_point},{time_offset},{phase_offset},{width_multiplier},{line_width},{pulse_length},{travel_speed},{pulse_count},{base_intensity},{pulse_intensity_scale},{edge_softness},{travel_mode},{pulse_profile},u_time).segment_distance",
    "pulse_position": "maker_b336_traveling_segment_pulse_field_2d({position},{start_point},{end_point},{time_offset},{phase_offset},{width_multiplier},{line_width},{pulse_length},{travel_speed},{pulse_count},{base_intensity},{pulse_intensity_scale},{edge_softness},{travel_mode},{pulse_profile},u_time).pulse_position"
  }
}
