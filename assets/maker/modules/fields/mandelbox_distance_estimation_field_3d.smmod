{
  "schema_version": 1,
  "id": "screenshaver.fields.mandelbox_distance_estimation_field_3d",
  "name": "Mandelbox Distance Estimation Field 3D",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Mandelbox Distance Estimation Field 3D",
  "uses": "Mathematical field and color composition.",
  "notes": "Box fold and spherical fold followed by scale and translation. Unsigned heuristic distance estimate, not a guaranteed conservative SDF. Minimum and fixed radii are ordered internally.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv-vec2(0.5),0.0)"
    }
  ],
  "parameters": [
    {
      "id": "iterations",
      "name": "Iterations",
      "type": "float",
      "default": 12,
      "min": 1,
      "max": 32
    },
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": -1.8,
      "min": -3,
      "max": 3
    },
    {
      "id": "fold_limit",
      "name": "Fold Limit",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 4
    },
    {
      "id": "minimum_radius",
      "name": "Minimum Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.05,
      "max": 1
    },
    {
      "id": "fixed_radius",
      "name": "Fixed Radius",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 4
    },
    {
      "id": "escape_radius",
      "name": "Escape Radius",
      "type": "float",
      "default": 16,
      "min": 4,
      "max": 64
    }
  ],
  "outputs": [
    {
      "id": "estimate",
      "name": "Estimate",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "final_coordinate",
      "name": "Final Coordinate",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "iteration_count",
      "name": "Iteration Count",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "escaped",
      "name": "Escaped",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "minimum_magnitude",
      "name": "Minimum Magnitude",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "valid",
      "name": "Valid",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerMBox {float estimate;vec3 final_coordinate;float iteration_count;float escaped;float minimum_magnitude;float valid;};\nMakerMBox maker_mandelbox_distance_estimation_field_3d(vec3 position,float iterations,float scale,float fold_limit,float minimum_radius,float fixed_radius,float escape_radius){vec3 z=position;float dr=1.,mn=length(z),r=mn,n=0.;if(any(isnan(z))||any(isinf(z))||r>1e6)return MakerMBox(0.,vec3(0.),0.,0.,0.,0.);float lo=min(minimum_radius,fixed_radius),hi=max(minimum_radius,fixed_radius);for(int i=0;i<32;i++){if(i>=int(floor(iterations+.5))||r>escape_radius)break;z=2.*clamp(z,-fold_limit,fold_limit)-z;float rr=dot(z,z);float k=hi*hi/max(rr,lo*lo);k=max(1.,k);z*=k;dr*=k;z=z*scale+position;dr=abs(scale)*dr+1.;r=length(z);mn=min(mn,r);n+=1.;if(isinf(dr)||isnan(dr)||isinf(r)||isnan(r))return MakerMBox(0.,vec3(0.),n,0.,mn,0.);}return MakerMBox(r/max(dr,1e-8),z,n,float(r>escape_radius),mn,1.);}\n",
  "glsl_outputs": {
    "estimate": "maker_mandelbox_distance_estimation_field_3d({position},{iterations},{scale},{fold_limit},{minimum_radius},{fixed_radius},{escape_radius}).estimate",
    "final_coordinate": "maker_mandelbox_distance_estimation_field_3d({position},{iterations},{scale},{fold_limit},{minimum_radius},{fixed_radius},{escape_radius}).final_coordinate",
    "iteration_count": "maker_mandelbox_distance_estimation_field_3d({position},{iterations},{scale},{fold_limit},{minimum_radius},{fixed_radius},{escape_radius}).iteration_count",
    "escaped": "maker_mandelbox_distance_estimation_field_3d({position},{iterations},{scale},{fold_limit},{minimum_radius},{fixed_radius},{escape_radius}).escaped",
    "minimum_magnitude": "maker_mandelbox_distance_estimation_field_3d({position},{iterations},{scale},{fold_limit},{minimum_radius},{fixed_radius},{escape_radius}).minimum_magnitude",
    "valid": "maker_mandelbox_distance_estimation_field_3d({position},{iterations},{scale},{fold_limit},{minimum_radius},{fixed_radius},{escape_radius}).valid"
  }
}
