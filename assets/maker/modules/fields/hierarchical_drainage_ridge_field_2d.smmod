{
  "schema_version": 1,
  "id": "screenshaver.fields.hierarchical_drainage_ridge_field_2d",
  "name": "Hierarchical Drainage Ridge Field 2D",
  "category": "Fields",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#527D94",
  "description": "Hierarchical branching valley network from repeated folded coordinates; not a watershed solver.",
  "uses": "Procedural terrain and geological morphology.",
  "notes": "Stateless analytical approximation; no physical simulation.",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv-vec2(0.5)"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 3,
      "min": 0.1,
      "max": 20
    },
    {
      "id": "levels",
      "name": "Levels",
      "type": "float",
      "default": 5,
      "min": 1,
      "max": 8
    },
    {
      "id": "branch_angle",
      "name": "Branch Angle",
      "type": "float",
      "default": 0.55,
      "min": 0.1,
      "max": 1.3
    },
    {
      "id": "shrink",
      "name": "Shrink",
      "type": "float",
      "default": 0.65,
      "min": 0.35,
      "max": 0.85
    },
    {
      "id": "width",
      "name": "Width",
      "type": "float",
      "default": 0.035,
      "min": 0.001,
      "max": 0.2
    }
  ],
  "outputs": [
    {
      "id": "valley_distance",
      "name": "Valley Distance",
      "type": "float"
    },
    {
      "id": "valley_mask",
      "name": "Valley Mask",
      "type": "float"
    },
    {
      "id": "ridge",
      "name": "Ridge",
      "type": "float"
    },
    {
      "id": "generation",
      "name": "Generation",
      "type": "float"
    }
  ],
  "helpers": "\nstruct MakerT_hierarchical_drainage_ridge_field_2d {float valley_distance;float valley_mask;float ridge;float generation;};\nMakerT_hierarchical_drainage_ridge_field_2d maker_t_hierarchical_drainage_ridge_field_2d(vec2 position,float scale,float levels,float branch_angle,float shrink,float width){\nvec2 p=position*scale;float best=1e6,gen=0.,size=1.;float c=cos(branch_angle),s=sin(branch_angle);for(int i=0;i<8;i++){if(i>=int(levels))break;float d=length(p-vec2(0.,clamp(p.y,0.,1.)))*size;if(d<best){best=d;gen=float(i);}p-=vec2(0.,.65);p.x=abs(p.x);p=mat2(c,-s,s,c)*p/shrink;size*=shrink;}float v=1.-smoothstep(width*.3,width,best);return MakerT_hierarchical_drainage_ridge_field_2d(best/scale,v,1.-v,gen);\n}",
  "glsl_outputs": {
    "valley_distance": "maker_t_hierarchical_drainage_ridge_field_2d({position},{scale},{levels},{branch_angle},{shrink},{width}).valley_distance",
    "valley_mask": "maker_t_hierarchical_drainage_ridge_field_2d({position},{scale},{levels},{branch_angle},{shrink},{width}).valley_mask",
    "ridge": "maker_t_hierarchical_drainage_ridge_field_2d({position},{scale},{levels},{branch_angle},{shrink},{width}).ridge",
    "generation": "maker_t_hierarchical_drainage_ridge_field_2d({position},{scale},{levels},{branch_angle},{shrink},{width}).generation"
  }
}
