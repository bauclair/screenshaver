{
  "schema_version": 1,
  "id": "screenshaver.fields.soft_interference_field",
  "name": "Soft Interference Field",
  "category": "Fields",
  "created_by": "Screenshaver",
  "header_color": "#4B9A86",
  "description": "Combines three low-frequency moving wave directions after a gentle nonlinear coordinate deformation.",
  "uses": "Broad plasma veils, fluid gradients, animated masks and soft moving backgrounds.",
  "notes": "Output is approximately -1 to +1. Frequency scales the spatial domain; Distortion controls the pre-wave warp.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "position2d"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "frequency",
      "name": "Spatial Frequency",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 8
    },
    {
      "id": "distortion",
      "name": "Distortion",
      "type": "float",
      "default": 0.22,
      "min": 0,
      "max": 2
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 1,
      "min": -5,
      "max": 5
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 0,
      "min": -6.2832,
      "max": 6.2832
    }
  ],
  "helpers": "float maker_soft_interference_field(vec2 p,float frequency,float distortion,float speed,float phase){\n vec2 q=p*max(frequency,0.0001);\n float t=u_time*speed;\n q.x+=distortion*sin(q.y*1.35+t*0.31+phase);\n q.y+=distortion*0.83*sin(q.x*1.10-t*0.27+phase*1.3);\n float a=sin(q.x*1.55+q.y*0.72+t*0.34+phase);\n float b=sin(q.y*1.82-q.x*0.48-t*0.29+phase*1.7);\n float c=sin((q.x+q.y)*0.91+t*0.21-phase*0.8);\n return (a+b+c)/3.0;\n}",
  "terminal": false,
  "glsl": "maker_soft_interference_field({position},{frequency},{distortion},{speed},{phase})"
}
