{
  "schema_version": 1,
  "id": "screenshaver.coordinates.periodic_vector_wrap_3d",
  "name": "Periodic Vector Wrap 3D",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "description": "Wraps vector components into independently periodic intervals.",
  "uses": "Lattice interference, repeated textures and coordinate patterns.",
  "notes": "Cell Index is floor(Vector / Period) in every mode. Centered outputs shift each positive fractional interval by half a period; they do not use nearest-cell rounding. Independent wrapping does not preserve the cube-coordinate zero-sum constraint.",
  "header_color": "#627FC2",
  "terminal": false,
  "inputs": [
    {
      "id": "vector",
      "name": "Vector",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "wrapped",
      "name": "Wrapped Vector",
      "type": "vec3"
    },
    {
      "id": "cell",
      "name": "Cell Index",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "period_x",
      "name": "X Period",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "period_y",
      "name": "Y Period",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "period_z",
      "name": "Z Period",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "range",
      "name": "Output Range",
      "type": "choice",
      "default": 3,
      "options": [
        "Positive spatial",
        "Centered spatial",
        "Positive normalized",
        "Centered normalized"
      ]
    }
  ],
  "helpers": "vec3 maker_periodic_vector_period(vec3 p){return max(abs(p),vec3(0.001));}\nvec3 maker_periodic_vector_cell(vec3 v,vec3 p){return floor(v/maker_periodic_vector_period(p));}\nvec3 maker_periodic_vector_wrap(vec3 v,vec3 p,float mode){\n p=maker_periodic_vector_period(p);\n vec3 f=fract(v/p);\n if(mode<0.5)return f*p;\n if(mode<1.5)return (f-0.5)*p;\n if(mode<2.5)return f;\n return 2.0*f-1.0;\n}",
  "glsl_outputs": {
    "wrapped": "maker_periodic_vector_wrap({vector},vec3({period_x},{period_y},{period_z}),{range})",
    "cell": "maker_periodic_vector_cell({vector},vec3({period_x},{period_y},{period_z}))"
  }
}
