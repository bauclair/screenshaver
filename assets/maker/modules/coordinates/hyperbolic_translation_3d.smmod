{
  "schema_version": 1,
  "id": "screenshaver.coordinates.hyperbolic_translation_3d",
  "name": "Hyperbolic Translation 3D",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Lorentz boost with rapidity bounded to \u00b18. Conformal scale refers only to Poincare coordinates; input ball coordinates are clamped at the margin.",
  "uses": "Hyperbolic Translation 3D",
  "notes": "Lorentz boost with rapidity bounded to \u00b18. Conformal scale refers only to Poincare coordinates; input ball coordinates are clamped at the margin.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    },
    {
      "id": "direction",
      "name": "Direction",
      "type": "vec3",
      "default": "vec3(1.0,0.0,0.0)"
    },
    {
      "id": "distance_multiplier",
      "name": "Distance Multiplier",
      "type": "float",
      "default": "1.0"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "transformed_coordinates",
      "name": "Transformed Coordinates",
      "type": "vec3"
    },
    {
      "id": "displacement",
      "name": "Displacement",
      "type": "vec3"
    },
    {
      "id": "conformal_scale",
      "name": "Conformal Scale",
      "type": "float"
    },
    {
      "id": "origin_distance",
      "name": "Origin Distance",
      "type": "float"
    },
    {
      "id": "validity",
      "name": "Validity",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "input_model",
      "name": "Input Model",
      "type": "choice",
      "default": 0,
      "options": [
        "Klein",
        "Poincare",
        "Hyperboloid Spatial"
      ]
    },
    {
      "id": "curvature_radius",
      "name": "Curvature Radius",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "boundary_margin",
      "name": "Boundary Margin",
      "type": "float",
      "default": 0.001,
      "min": 0.0001,
      "max": 0.1
    },
    {
      "id": "translation_distance",
      "name": "Translation Distance",
      "type": "float",
      "default": 0.5,
      "min": -10,
      "max": 10
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    }
  ],
  "helpers": "struct MakerB388HyperbolicTranslation3D{vec3 transformed_coordinates;vec3 displacement;float conformal_scale;float origin_distance;float validity;};\nMakerB388HyperbolicTranslation3D maker_b388_hyperbolic_translation_3d(vec3 position,vec3 direction,float distance_multiplier,float time_offset,float input_model,float curvature_radius,float boundary_margin,float translation_distance,float speed){float R=max(curvature_radius,.001),lim=1.0-boundary_margin;vec3 x=clamp(position/R,-1e4,1e4);float r=length(x),valid=1.0;vec3 h;float w;if(input_model<1.5){valid=step(r,lim);x*=min(1.0,lim/max(r,1e-8));float q=dot(x,x);if(input_model<.5){w=inversesqrt(max(1.0-q,1e-8));h=x*w;}else{w=(1.0+q)/(1.0-q);h=2.0*x/(1.0-q);}}else{h=x;w=sqrt(1.0+dot(h,h));}vec3 d=length(direction)>1e-8?normalize(direction):vec3(1.0,0.0,0.0);float a=clamp((translation_distance+(u_time+time_offset)*speed)*distance_multiplier/R,-8.0,8.0),s=sinh(a),b=cosh(a),old=w;float along=dot(h,d);h+=d*((b-1.0)*along+s*w);w=sqrt(1.0+dot(h,h));vec3 outp=R*(input_model<.5?h/w:(input_model<1.5?h/(w+1.0):h));return MakerB388HyperbolicTranslation3D(outp,outp-position,(old+1.0)/(w+1.0),R*asinh(length(h)),valid);}",
  "glsl_outputs": {
    "transformed_coordinates": "maker_b388_hyperbolic_translation_3d({position},{direction},{distance_multiplier},{time_offset},{input_model},{curvature_radius},{boundary_margin},{translation_distance},{speed}).transformed_coordinates",
    "displacement": "maker_b388_hyperbolic_translation_3d({position},{direction},{distance_multiplier},{time_offset},{input_model},{curvature_radius},{boundary_margin},{translation_distance},{speed}).displacement",
    "conformal_scale": "maker_b388_hyperbolic_translation_3d({position},{direction},{distance_multiplier},{time_offset},{input_model},{curvature_radius},{boundary_margin},{translation_distance},{speed}).conformal_scale",
    "origin_distance": "maker_b388_hyperbolic_translation_3d({position},{direction},{distance_multiplier},{time_offset},{input_model},{curvature_radius},{boundary_margin},{translation_distance},{speed}).origin_distance",
    "validity": "maker_b388_hyperbolic_translation_3d({position},{direction},{distance_multiplier},{time_offset},{input_model},{curvature_radius},{boundary_margin},{translation_distance},{speed}).validity"
  }
}
