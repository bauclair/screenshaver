{
  "schema_version": 1,
  "id": "screenshaver.coordinates.cross_axis_sine_warp",
  "name": "Cross-Axis Sine Warp",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#287C9B",
  "description": "Bounded cross-coupled sine displacement with legacy simultaneous or sequential harmonic feedback.",
  "uses": "Liquid patterns, coupled sine distortions, animated UV warps.",
  "notes": "Existing mode retains the original 12-step limit and final translation; new controls apply only to Sequential Harmonic mode, which rounds Iterations to nearest integer and clamps to 1–50. Per Iteration translation updates X before the Y wave. Frequency floor 0.05 prevents zero division. Low frequency and high exponent can produce very large displacements; use moderate settings.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv"
    }
  ],
  "outputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2"
    }
  ],
  "parameters": [
    {
      "id": "iterations",
      "name": "Iterations",
      "type": "float",
      "default": 39,
      "min": 1,
      "max": 64
    },
    {
      "id": "strength",
      "name": "Strength",
      "type": "float",
      "default": 0.25,
      "min": 0,
      "max": 2
    },
    {
      "id": "scale",
      "name": "Frequency Scale",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 5
    },
    {
      "id": "speed",
      "name": "Time Speed",
      "type": "float",
      "default": 1.25,
      "min": 0,
      "max": 5
    },
    {
      "id": "x_boost",
      "name": "X Boost",
      "type": "float",
      "default": 5,
      "min": -10,
      "max": 10
    },
    {
      "id": "y_boost",
      "name": "Y Boost",
      "type": "float",
      "default": 5,
      "min": -10,
      "max": 10
    },
    {
      "id": "feedback_mode",
      "name": "Feedback Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Existing",
        "Sequential Harmonic"
      ]
    },
    {
      "id": "translation_mode",
      "name": "Translation Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Final",
        "Per Iteration"
      ]
    },
    {
      "id": "amplitude_exponent",
      "name": "Amplitude Exponent",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 3
    },
    {
      "id": "x_wave_phase",
      "name": "X Wave Phase",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "y_wave_phase",
      "name": "Y Wave Phase",
      "type": "float",
      "default": 90,
      "min": -360,
      "max": 360
    },
    {
      "id": "x_frequency_multiplier",
      "name": "X Frequency Multiplier",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 5
    },
    {
      "id": "y_frequency_multiplier",
      "name": "Y Frequency Multiplier",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 5
    }
  ],
  "helpers": "vec2 maker_cross_warp_independent(vec2 p,float time,float iterations,float strength,float scale,float speed,float xb,float yb){vec2 q=p;float t=time*speed;int count=clamp(int(iterations+0.5),1,12);for(int j=0;j<12;j++){if(j>=count)break;float k=float(j)+1.0;vec2 v=vec2(sin(scale*q.y*(1.0+0.3*k)+t+0.7*k),cos(scale*q.x*(1.0+0.2*k)-t+0.9*k));q+=strength*v/(k*float(count));}return q+vec2(xb,yb);}\nvec2 maker_cross_warp_modes(vec2 p,float time,float iterations,float strength,float scale,float speed,float xb,float yb,float mode,float translation,float exponent,float xp,float yp,float xm,float ym){\n if(mode<0.5)return maker_cross_warp_independent(p,time,iterations,strength,scale,speed,xb,yb);\n int count=int(clamp(floor(iterations+0.5),1.0,50.0));\n float base=max(scale,0.05), t=time*speed;\n vec2 q=p, shift=vec2(xb,yb); bool each=translation>=0.5;\n for(int j=0;j<50;++j){if(j>=count)break;\n float harmonic=base*float(j+1);\n float amplitude=strength/pow(harmonic,clamp(exponent,0.0,3.0));\n q.x+=amplitude*sin(harmonic*xm*q.y+t+radians(xp));\n if(each)q.x+=shift.x;\n q.y+=amplitude*sin(harmonic*ym*q.x+t+radians(yp));\n if(each)q.y+=shift.y;\n }\n return each?q:q+shift;\n}\n",
  "glsl": "maker_cross_warp_modes({position},u_time,{iterations},{strength},{scale},{speed},{x_boost},{y_boost},{feedback_mode},{translation_mode},{amplitude_exponent},{x_wave_phase},{y_wave_phase},{x_frequency_multiplier},{y_frequency_multiplier})",
  "terminal": false
}
