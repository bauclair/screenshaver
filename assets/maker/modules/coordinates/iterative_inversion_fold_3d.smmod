{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.coordinates.iterative_inversion_fold_3d",
  "name": "Iterative Inversion Fold 3D",
  "category": "Coordinates",
  "header_color": "#627FC2",
  "description": "Iteratively applies a centered absolute fold, regularized reciprocal-radius scaling, and translation to a 3D point.",
  "uses": "Fractal coordinate transforms, crystalline distortions and procedural orbit construction.",
  "notes": "Independently designed transform. Uses a positive denominator floor to avoid singularities; output is a position, not a distance estimator. Scale outputs report nominal reciprocal scaling, not an exact derivative under regularization or clamping. Accumulated scale saturates at exp(\u00b180); zero gain returns zero and a logarithmic sentinel of -80.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv,0.35)"
    }
  ],
  "outputs": [
    {
      "id": "folded",
      "name": "Folded Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "accumulated_scale",
      "name": "Accumulated Scale",
      "type": "float"
    },
    {
      "id": "logarithmic_scale",
      "name": "Logarithmic Scale",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "iterations",
      "name": "Iterations",
      "type": "float",
      "default": 5,
      "min": 1,
      "max": 16
    },
    {
      "id": "fold_center",
      "name": "Fold Center",
      "type": "float",
      "default": 0.35,
      "min": -3,
      "max": 3
    },
    {
      "id": "inversion",
      "name": "Inversion Gain",
      "type": "float",
      "default": 0.9,
      "min": 0,
      "max": 3
    },
    {
      "id": "radius_floor",
      "name": "Radius Floor",
      "type": "float",
      "default": 0.15,
      "min": 0.001,
      "max": 2
    },
    {
      "id": "offset",
      "name": "Offset",
      "type": "float",
      "default": 0.65,
      "min": -3,
      "max": 3
    }
  ],
  "helpers": "vec3 maker_bcc_invert_fold(vec3 p,float count,float center,float gain,float floor_radius,float shift){\n vec3 q=p;\n for(int i=0;i<16;i++){\n  if(float(i)>=floor(count+0.5))break;\n  vec3 reflected=abs(q-vec3(center));\n  float r2=dot(reflected,reflected);\n  q=reflected*(gain/max(r2,floor_radius*floor_radius))-vec3(shift,shift*0.73,shift*1.19);\n  q=clamp(q,vec3(-10000.0),vec3(10000.0));\n }\n return q;\n}\nvec2 maker_inversion_nominal_scale(vec3 p,float count,float center,float gain,float floor_radius,float shift){\n if(gain<=0.0)return vec2(0.0,-80.0);\n vec3 q=p;float log_scale=0.0;\n for(int i=0;i<16;i++){\n  if(float(i)>=floor(count+0.5))break;\n  vec3 reflected=abs(q-vec3(center));\n  float r2=dot(reflected,reflected);\n  float factor=gain/max(r2,floor_radius*floor_radius);\n  log_scale+=log(max(factor,1e-35));\n  q=reflected*factor-vec3(shift,shift*0.73,shift*1.19);\n  q=clamp(q,vec3(-10000.0),vec3(10000.0));\n }\n return vec2(exp(clamp(log_scale,-80.0,80.0)),log_scale);\n}",
  "glsl_outputs": {
    "folded": "maker_bcc_invert_fold({position},{iterations},{fold_center},{inversion},{radius_floor},{offset})",
    "accumulated_scale": "maker_inversion_nominal_scale({position},{iterations},{fold_center},{inversion},{radius_floor},{offset}).x",
    "logarithmic_scale": "maker_inversion_nominal_scale({position},{iterations},{fold_center},{inversion},{radius_floor},{offset}).y"
  }
}
