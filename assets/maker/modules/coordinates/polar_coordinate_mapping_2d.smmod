{
  "schema_version": 1,
  "id": "screenshaver.coordinates.polar_coordinate_mapping_2d",
  "name": "Polar Coordinate Mapping 2D",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "description": "Maps Cartesian positions to linear polar sampling coordinates.",
  "uses": "Radial turbulence, circular textures and moving radial patterns.",
  "notes": "Radius and Angle are unanimated geometric measurements; Angle is in radians. Angular Speed is radians per time unit; Angular Offset is degrees. Circular Direction represents the raw geometric angle, with (1,0) at the center. Polar Coordinates have an angular seam.",
  "header_color": "#627FC2",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "position2d"
    },
    {
      "id": "time",
      "name": "Time",
      "type": "float",
      "default": "u_time",
      "semantic_role": "time"
    }
  ],
  "outputs": [
    {
      "id": "polar",
      "name": "Polar Coordinates",
      "type": "vec2"
    },
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "angle",
      "name": "Angle",
      "type": "float",
      "semantic_role": "angle"
    },
    {
      "id": "direction",
      "name": "Circular Direction",
      "type": "vec2",
      "semantic_role": "direction2d"
    }
  ],
  "parameters": [
    {
      "id": "center_x",
      "name": "Center X",
      "type": "float",
      "default": 0,
      "min": -5,
      "max": 5
    },
    {
      "id": "center_y",
      "name": "Center Y",
      "type": "float",
      "default": 0,
      "min": -5,
      "max": 5
    },
    {
      "id": "radial_scale",
      "name": "Radial Scale",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 100
    },
    {
      "id": "angular_scale",
      "name": "Angular Scale",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 100
    },
    {
      "id": "radial_speed",
      "name": "Radial Speed",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    },
    {
      "id": "angular_speed",
      "name": "Angular Speed",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    },
    {
      "id": "angular_offset",
      "name": "Angular Offset",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    }
  ],
  "helpers": "float maker_linear_polar_angle(vec2 v){\n if(dot(v,v)<1e-16)return 0.0;\n if(v.x==0.0)return sign(v.y)*1.5707963267948966;\n return atan(v.y,v.x);\n}\nvec2 maker_linear_polar_direction(vec2 v){float r=length(v);return r<1e-8?vec2(1.0,0.0):v/r;}\nvec2 maker_linear_polar_map(vec2 v,float t,float rs,float ascale,float rv,float av,float offset){\n return vec2(rs*length(v)-rv*t,ascale*maker_linear_polar_angle(v)-av*t+radians(offset));\n}",
  "glsl_outputs": {
    "polar": "maker_linear_polar_map(({position}-vec2({center_x},{center_y})),{time},{radial_scale},{angular_scale},{radial_speed},{angular_speed},{angular_offset})",
    "radius": "length(({position}-vec2({center_x},{center_y})))",
    "angle": "maker_linear_polar_angle(({position}-vec2({center_x},{center_y})))",
    "direction": "maker_linear_polar_direction(({position}-vec2({center_x},{center_y})))"
  }
}
