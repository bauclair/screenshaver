{
  "schema_version": 1,
  "id": "screenshaver.coordinates.cylindrical_surface_coordinates_3d",
  "name": "Cylindrical Surface Coordinates 3D",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Unwraps a 3D position into angular and axial surface coordinates with radial distance and normal.",
  "uses": "Unwraps a 3D position into angular and axial surface coordinates with radial distance and normal.",
  "notes": "Angular modulation in radians; axial modulation additive in world units before scaling. Angular coordinate in turns, scaled before wrapping; Signed maps to [-0.5,0.5). Integer angular scales preserve seam continuity with periodic downstream fields. Axis planes X: YZ, Y: ZX, Z: XY. At axis use zero base angle and zero normal. Nonfinite inputs return zero. Positions bounded to +/-1e10.",
  "header_color": "#627FC2",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "angular_modulation",
      "name": "Angular Modulation",
      "type": "float",
      "default": "0.0",
      "semantic_role": "angle"
    },
    {
      "id": "axial_modulation",
      "name": "Axial Modulation",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "uv",
      "name": "Surface UV",
      "type": "vec2",
      "semantic_role": "uv"
    },
    {
      "id": "angular",
      "name": "Angular Coordinate",
      "type": "float"
    },
    {
      "id": "axial",
      "name": "Axial Coordinate",
      "type": "float"
    },
    {
      "id": "radial",
      "name": "Radial Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "normal",
      "name": "Radial Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    }
  ],
  "parameters": [
    {
      "id": "axis",
      "name": "Cylinder Axis",
      "type": "choice",
      "default": 2,
      "min": 0,
      "max": 2,
      "options": [
        "X",
        "Y",
        "Z"
      ]
    },
    {
      "id": "angular_scale",
      "name": "Angular Scale",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 100
    },
    {
      "id": "axial_scale",
      "name": "Axial Scale",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "angular_offset",
      "name": "Angular Offset",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "axial_offset",
      "name": "Axial Offset",
      "type": "float",
      "default": 0,
      "min": -100,
      "max": 100
    },
    {
      "id": "mapping",
      "name": "Angular Mapping",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "Wrapped",
        "Signed"
      ]
    },
    {
      "id": "orientation",
      "name": "Normal Orientation",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "Outward",
        "Inward"
      ]
    }
  ],
  "helpers": "struct MakerCSCResult { vec2 uv; float angular; float axial; float radial; vec3 normal; };\nMakerCSCResult maker_csc_eval(vec3 p,vec3 center,float am,float zm,float axis,float angular_scale,float axial_scale,float angular_offset,float axial_offset,float mapping,float orientation){\n if(any(isnan(p))||any(isinf(p))||any(isnan(center))||any(isinf(center))||isnan(am)||isinf(am)||isnan(zm)||isinf(zm))return MakerCSCResult(vec2(0.0),0.0,0.0,0.0,vec3(0.0));\n vec3 q=clamp(p,vec3(-1e10),vec3(1e10))-clamp(center,vec3(-1e10),vec3(1e10));\n vec2 v=axis<0.5?q.yz:(axis<1.5?q.zx:q.xy);float z=axis<0.5?q.x:(axis<1.5?q.y:q.z);\n float r=length(v);float tau=6.28318530718;float angle=r>1e-15?atan(v.y,v.x):0.0;\n float u=(angle+mod(am,tau)+radians(angular_offset))/tau*angular_scale;\n u=mapping<0.5?fract(u):fract(u+0.5)-0.5;\n float axial=(z+clamp(zm,-1e10,1e10)+axial_offset)*axial_scale;\n vec2 n=r>1e-15?v/r:vec2(0.0);vec3 normal=axis<0.5?vec3(0.0,n):(axis<1.5?vec3(n.y,0.0,n.x):vec3(n,0.0));\n if(orientation>0.5)normal=-normal;return MakerCSCResult(vec2(u,axial),u,axial,r,normal);\n}",
  "glsl_outputs": {
    "uv": "maker_csc_eval({position},{center},{angular_modulation},{axial_modulation},{axis},{angular_scale},{axial_scale},{angular_offset},{axial_offset},{mapping},{orientation}).uv",
    "angular": "maker_csc_eval({position},{center},{angular_modulation},{axial_modulation},{axis},{angular_scale},{axial_scale},{angular_offset},{axial_offset},{mapping},{orientation}).angular",
    "axial": "maker_csc_eval({position},{center},{angular_modulation},{axial_modulation},{axis},{angular_scale},{axial_scale},{angular_offset},{axial_offset},{mapping},{orientation}).axial",
    "radial": "maker_csc_eval({position},{center},{angular_modulation},{axial_modulation},{axis},{angular_scale},{axial_scale},{angular_offset},{axial_offset},{mapping},{orientation}).radial",
    "normal": "maker_csc_eval({position},{center},{angular_modulation},{axial_modulation},{axis},{angular_scale},{axial_scale},{angular_offset},{axial_offset},{mapping},{orientation}).normal"
  }
}
