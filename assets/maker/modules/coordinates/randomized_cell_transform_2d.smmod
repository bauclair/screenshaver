{
  "schema_version": 1,
  "id": "screenshaver.coordinates.randomized_cell_transform_2d",
  "name": "Randomized Cell Transform 2D",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "description": "Applies deterministic cell-specific translation and animated rotation.",
  "uses": "Randomized geometric arrays, mosaics and confetti.",
  "notes": "Jitter is a symmetric maximum displacement in local coordinate units, not a fraction of cell width. For 0.1-wide cells try 0.015 jitter. Rotation range is symmetric about the offset; angle output is radians. Speed variation scales the signed base speed by a factor between 1-variation and 1+variation. Cell-local sampling can clip shapes.",
  "header_color": "#627FC2",
  "inputs": [
    {
      "id": "local",
      "name": "Local Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "position2d"
    },
    {
      "id": "cell",
      "name": "Cell Index",
      "type": "vec2",
      "default": "vec2(0.0)"
    },
    {
      "id": "time",
      "name": "Time",
      "type": "float",
      "default": "u_time",
      "semantic_role": "time"
    }
  ],
  "outputs": [
    {
      "id": "transformed",
      "name": "Transformed Position",
      "type": "vec2",
      "semantic_role": "position2d"
    },
    {
      "id": "displacement",
      "name": "Cell Displacement",
      "type": "vec2",
      "semantic_role": "offset2d"
    },
    {
      "id": "angle",
      "name": "Rotation Angle",
      "type": "float",
      "semantic_role": "angle"
    },
    {
      "id": "random",
      "name": "Random Value",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "jitter_x",
      "name": "Horizontal Jitter",
      "type": "float",
      "default": 0.15,
      "min": 0,
      "max": 0.5
    },
    {
      "id": "jitter_y",
      "name": "Vertical Jitter",
      "type": "float",
      "default": 0.15,
      "min": 0,
      "max": 0.5
    },
    {
      "id": "rotation_range",
      "name": "Random Rotation",
      "type": "float",
      "default": 180,
      "min": 0,
      "max": 360
    },
    {
      "id": "rotation_offset",
      "name": "Rotation Offset",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "rotation_speed",
      "name": "Rotation Speed",
      "type": "float",
      "default": 90,
      "min": -720,
      "max": 720
    },
    {
      "id": "speed_variation",
      "name": "Speed Variation",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1000
    }
  ],
  "helpers": "uint maker_rct_hash(uint x){x^=x>>16u;x*=0x7feb352du;x^=x>>15u;x*=0x846ca68bu;return x^(x>>16u);}\nfloat maker_rct_unit(uint x){return float(maker_rct_hash(x)>>8u)/16777216.0;}\nvec4 maker_rct_samples(vec2 cell,float seed){\n ivec2 i=ivec2(floor(clamp(cell,vec2(-1000000000.0),vec2(1000000000.0))));\n uint h=maker_rct_hash(uint(i.x)^maker_rct_hash(uint(i.y)^0x9e3779b9u)^maker_rct_hash(uint(floor(clamp(seed,0.0,1000.0)+0.5))));\n return vec4(maker_rct_unit(h^0x243f6a88u),maker_rct_unit(h^0x85a308d3u),maker_rct_unit(h^0x13198a2eu),maker_rct_unit(h^0x03707344u));\n}\nfloat maker_rct_angle(vec4 r,float t,float range_deg,float offset_deg,float speed_deg,float variation){\n return radians(offset_deg+(2.0*r.z-1.0)*range_deg+t*speed_deg*(1.0+(2.0*r.w-1.0)*clamp(variation,0.0,1.0)));\n}\nvec2 maker_rct_inverse(vec2 p,vec2 d,float a){vec2 q=p-d;float c=cos(a),s=sin(a);return vec2(c*q.x+s*q.y,-s*q.x+c*q.y);}",
  "glsl_outputs": {
    "transformed": "maker_rct_inverse({local},((maker_rct_samples({cell},{seed}).xy*2.0-1.0)*vec2({jitter_x},{jitter_y})),maker_rct_angle(maker_rct_samples({cell},{seed}),{time},{rotation_range},{rotation_offset},{rotation_speed},{speed_variation}))",
    "displacement": "((maker_rct_samples({cell},{seed}).xy*2.0-1.0)*vec2({jitter_x},{jitter_y}))",
    "angle": "maker_rct_angle(maker_rct_samples({cell},{seed}),{time},{rotation_range},{rotation_offset},{rotation_speed},{speed_variation})",
    "random": "maker_rct_samples({cell},{seed}).z"
  },
  "terminal": false
}
