{
  "schema_version": 1,
  "id": "screenshaver.coordinates.multiscale_cyclic_vector_warp_3d",
  "name": "Multiscale Cyclic Vector Warp 3D",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Bounded multiscale periodic coordinate feedback with selectable component permutation.",
  "uses": "Bounded multiscale periodic coordinate feedback with selectable component permutation.",
  "notes": "All components use the pre-iteration position. Phase Offset is radians; phase parameters are degrees. Frequency capped at 4096; strength multiplier bounded to [-4,4]. Nonfinite inputs return zero.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0",
      "semantic_role": "time"
    },
    {
      "id": "strength_multiplier",
      "name": "Strength Multiplier",
      "type": "float",
      "default": "1.0"
    },
    {
      "id": "phase_offset",
      "name": "Phase Offset",
      "type": "vec3",
      "default": "vec3(0.0)"
    }
  ],
  "outputs": [
    {
      "id": "warped",
      "name": "Warped Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "displacement",
      "name": "Displacement",
      "type": "vec3"
    },
    {
      "id": "magnitude",
      "name": "Displacement Magnitude",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "iterations",
      "name": "Iterations",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 8
    },
    {
      "id": "frequency",
      "name": "Base Frequency",
      "type": "float",
      "default": 2,
      "min": 0.01,
      "max": 32
    },
    {
      "id": "frequency_multiplier",
      "name": "Frequency Multiplier",
      "type": "float",
      "default": 2,
      "min": 0.25,
      "max": 4
    },
    {
      "id": "amplitude",
      "name": "Base Amplitude",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 5
    },
    {
      "id": "amplitude_multiplier",
      "name": "Amplitude Multiplier",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 1,
      "min": -10,
      "max": 10
    },
    {
      "id": "phase_x",
      "name": "X Phase",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "phase_y",
      "name": "Y Phase",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "phase_z",
      "name": "Z Phase",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "permutation",
      "name": "Component Permutation",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 2,
      "options": [
        "YZX",
        "ZXY",
        "XYZ"
      ]
    },
    {
      "id": "waveform",
      "name": "Waveform",
      "type": "choice",
      "default": 0,
      "min": 0,
      "max": 1,
      "options": [
        "Sine",
        "Cosine"
      ]
    }
  ],
  "helpers": "struct MakerMCVW { vec3 warped; vec3 displacement; float magnitude; };\nMakerMCVW maker_mcvw_eval(vec3 p,float t,float strength,vec3 phase,float count,float freq,float fm,float amp,float am,float speed,float px,float py,float pz,float perm,float wave){\n if(any(isnan(p))||any(isinf(p))||any(isnan(phase))||any(isinf(phase))||isnan(t)||isinf(t)||isnan(strength)||isinf(strength))return MakerMCVW(vec3(0),vec3(0),0.0);\n p=clamp(p,vec3(-1e4),vec3(1e4)); vec3 delta=vec3(0.0);\n phase=clamp(phase,vec3(-1e5),vec3(1e5))+radians(vec3(px,py,pz))+clamp(t,-1e5,1e5)*speed;\n int n=int(clamp(floor(count+0.5),1.0,8.0));\n float a=amp*clamp(strength,-4.0,4.0);\n for(int k=0;k<8;k++){\n  if(k>=n)break;\n  vec3 q=p+delta; vec3 v=perm<0.5?q.yzx:(perm<1.5?q.zxy:q);\n  vec3 arg=v*freq+phase;\n  delta+=a*(wave<0.5?sin(arg):cos(arg));\n  freq=min(freq*fm,4096.0); a*=am;\n }\n return MakerMCVW(p+delta,delta,length(delta));\n}",
  "glsl_outputs": {
    "warped": "maker_mcvw_eval({position},u_time+{time_offset},{strength_multiplier},{phase_offset},{iterations},{frequency},{frequency_multiplier},{amplitude},{amplitude_multiplier},{speed},{phase_x},{phase_y},{phase_z},{permutation},{waveform}).warped",
    "displacement": "maker_mcvw_eval({position},u_time+{time_offset},{strength_multiplier},{phase_offset},{iterations},{frequency},{frequency_multiplier},{amplitude},{amplitude_multiplier},{speed},{phase_x},{phase_y},{phase_z},{permutation},{waveform}).displacement",
    "magnitude": "maker_mcvw_eval({position},u_time+{time_offset},{strength_multiplier},{phase_offset},{iterations},{frequency},{frequency_multiplier},{amplitude},{amplitude_multiplier},{speed},{phase_x},{phase_y},{phase_z},{permutation},{waveform}).magnitude"
  }
}
