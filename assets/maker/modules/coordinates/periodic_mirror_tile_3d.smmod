{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.coordinates.periodic_mirror_tile_3d",
  "name": "Periodic Mirror Tile 3D",
  "category": "Coordinates",
  "header_color": "#627FC2",
  "description": "Reflects 3D coordinates into repeating mirrored cells with independently adjustable axis periods.",
  "uses": "Seamless spatial repetition, periodic fractal domains and geometric tiling.",
  "notes": "Independent triangular-wave coordinate mapping. Unlike 3D Domain Fold, this operates directly on 3D position and returns a coordinate.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv,0.35)"
    }
  ],
  "outputs": [
    {
      "id": "tiled",
      "name": "Mirrored Position",
      "type": "vec3",
      "semantic_role": "position3d"
    }
  ],
  "parameters": [
    {
      "id": "period_x",
      "name": "X Cell Size",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 20
    },
    {
      "id": "period_y",
      "name": "Y Cell Size",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 20
    },
    {
      "id": "period_z",
      "name": "Z Cell Size",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 20
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    }
  ],
  "helpers": "vec3 maker_bcc_mirror_tile(vec3 p,vec3 period,float phase){\n vec3 w=max(period,vec3(0.0001));\n vec3 u=(p+vec3(phase))/w;\n return w*(1.0-abs(2.0*fract(0.5*u)-1.0));\n}",
  "glsl": "maker_bcc_mirror_tile({position},vec3({period_x},{period_y},{period_z}),{phase})"
}
