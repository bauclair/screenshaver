{
  "schema_version": 1,
  "id": "screenshaver.coordinates.orthographic_fisheye_ray_projection",
  "name": "Orthographic Fisheye Ray Projection",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Unit-disc orthographic fisheye lens, not an orthographic parallel-ray camera. View angle in radians; invalid rays return a clamped direction with zero mask.",
  "uses": "Orthographic Fisheye Ray Projection",
  "notes": "Unit-disc orthographic fisheye lens, not an orthographic parallel-ray camera. View angle in radians; invalid rays return a clamped direction with zero mask.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "screen_coordinates",
      "name": "Screen Coordinates",
      "type": "vec2",
      "default": "maker_uv"
    },
    {
      "id": "camera_origin",
      "name": "Camera Origin",
      "type": "vec3",
      "default": "vec3(0.0,0.0,-3.0)"
    },
    {
      "id": "camera_target",
      "name": "Camera Target",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "up_direction",
      "name": "Up Direction",
      "type": "vec3",
      "default": "vec3(0.0,1.0,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "ray_direction",
      "name": "Ray Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    },
    {
      "id": "ray_origin",
      "name": "Ray Origin",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "valid_ray_mask",
      "name": "Valid Ray Mask",
      "type": "float"
    },
    {
      "id": "projection_radius",
      "name": "Projection Radius",
      "type": "float"
    },
    {
      "id": "view_angle",
      "name": "View Angle",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "field_of_view",
      "name": "Field Of View",
      "default": 120,
      "type": "float",
      "min": 1,
      "max": 180
    },
    {
      "id": "lens_scale",
      "name": "Lens Scale",
      "default": 1,
      "type": "float",
      "min": 0.01,
      "max": 10
    },
    {
      "id": "camera_roll",
      "name": "Camera Roll",
      "default": 0,
      "type": "float",
      "min": -360,
      "max": 360
    },
    {
      "id": "outside_lens_handling",
      "name": "Outside Lens Handling",
      "default": 0,
      "type": "choice",
      "options": [
        "Invalid",
        "Clamp"
      ]
    }
  ],
  "helpers": "struct MakerB336OrthographicFisheyeRayProjection {vec3 ray_direction;vec3 ray_origin;float valid_ray_mask;float projection_radius;float view_angle;};\nMakerB336OrthographicFisheyeRayProjection maker_b336_orthographic_fisheye_ray_projection(vec2 screen_coordinates,vec3 camera_origin,vec3 camera_target,vec3 up_direction,float field_of_view,float lens_scale,float camera_roll,float outside_lens_handling,float tm){\nvec3 f=camera_target-camera_origin;f=length(f)>1e-7?normalize(f):vec3(0.,0.,1.);vec3 r=cross(f,up_direction);if(length(r)<1e-7)r=cross(f,abs(f.y)<.9?vec3(0.,1.,0.):vec3(1.,0.,0.));r=normalize(r);vec3 u=normalize(cross(r,f));vec2 p=screen_coordinates/max(lens_scale,.0001);float rad=length(p),v=rad<=1.||outside_lens_handling>.5?1.:0.;float a=radians(camera_roll);p=mat2(cos(a),sin(a),-sin(a),cos(a))*p;vec2 q=rad>1e-8?p/rad:vec2(0.);float sn=min(rad,1.)*sin(radians(field_of_view)*.5);vec3 d=f*sqrt(max(0.,1.-sn*sn))+sn*(q.x*r+q.y*u);return MakerB336OrthographicFisheyeRayProjection(normalize(d),camera_origin,v,rad,asin(clamp(sn,0.,1.)));\n}",
  "glsl_outputs": {
    "ray_direction": "maker_b336_orthographic_fisheye_ray_projection({screen_coordinates},{camera_origin},{camera_target},{up_direction},{field_of_view},{lens_scale},{camera_roll},{outside_lens_handling},u_time).ray_direction",
    "ray_origin": "maker_b336_orthographic_fisheye_ray_projection({screen_coordinates},{camera_origin},{camera_target},{up_direction},{field_of_view},{lens_scale},{camera_roll},{outside_lens_handling},u_time).ray_origin",
    "valid_ray_mask": "maker_b336_orthographic_fisheye_ray_projection({screen_coordinates},{camera_origin},{camera_target},{up_direction},{field_of_view},{lens_scale},{camera_roll},{outside_lens_handling},u_time).valid_ray_mask",
    "projection_radius": "maker_b336_orthographic_fisheye_ray_projection({screen_coordinates},{camera_origin},{camera_target},{up_direction},{field_of_view},{lens_scale},{camera_roll},{outside_lens_handling},u_time).projection_radius",
    "view_angle": "maker_b336_orthographic_fisheye_ray_projection({screen_coordinates},{camera_origin},{camera_target},{up_direction},{field_of_view},{lens_scale},{camera_roll},{outside_lens_handling},u_time).view_angle"
  }
}
