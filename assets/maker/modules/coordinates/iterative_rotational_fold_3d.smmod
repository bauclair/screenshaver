{
  "schema_version": 1,
  "id": "screenshaver.coordinates.iterative_rotational_fold_3d",
  "name": "Iterative Rotational Fold 3D",
  "category": "Coordinates",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Repeatedly rotates, selectively folds and translates a three-dimensional coordinate.",
  "uses": "Fractal domains, crystalline geometry and animated coordinate deformation.",
  "notes": "Right-handed X then Y then Z rotation per iteration. Angles in degrees, speeds in degrees per second. Iterations and fold choice rounded to nearest integer. Translation follows folding on every iteration, including unfolded axes. This is a coordinate transform, not a distance field. Modulation is evaluated once per sample, not per iteration. Rotation modulation in degrees. Uniform scale compensation is nominal, not a conservative distance guarantee. Translation progression multiplies the combined translation vector by ratio^i at zero-based iteration i, independently of coordinate scale. Final multiplier is ratio^(count-1). Extreme input magnitudes may overflow.",
  "header_color": "#627FC2",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv,0.0)"
    },
    {
      "id": "time",
      "name": "Time",
      "type": "float",
      "semantic_role": "time",
      "default": "u_time"
    },
    {
      "id": "rotation_modulation",
      "name": "Rotation Modulation",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "translation_modulation",
      "name": "Translation Modulation",
      "type": "vec3",
      "default": "vec3(0.0)"
    }
  ],
  "outputs": [
    {
      "id": "folded",
      "name": "Folded Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "accumulated_scale",
      "name": "Accumulated Scale",
      "type": "float"
    },
    {
      "id": "inverse_scale",
      "name": "Inverse Accumulated Scale",
      "type": "float"
    },
    {
      "id": "compensated",
      "name": "Scale-Compensated Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "final_translation_multiplier",
      "name": "Final Translation Multiplier",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "iterations",
      "name": "Iterations",
      "type": "float",
      "default": 8,
      "min": 1,
      "max": 32
    },
    {
      "id": "angle_x",
      "name": "X Rotation",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "angle_y",
      "name": "Y Rotation",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "angle_z",
      "name": "Z Rotation",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "speed_x",
      "name": "X Rotation Speed",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "speed_y",
      "name": "Y Rotation Speed",
      "type": "float",
      "default": 15,
      "min": -360,
      "max": 360
    },
    {
      "id": "speed_z",
      "name": "Z Rotation Speed",
      "type": "float",
      "default": 30,
      "min": -360,
      "max": 360
    },
    {
      "id": "fold_axes",
      "name": "Fold Axes",
      "type": "choice",
      "default": 5,
      "min": 0,
      "max": 7,
      "options": [
        "None",
        "X",
        "Y",
        "Z",
        "XY",
        "XZ",
        "YZ",
        "XYZ"
      ]
    },
    {
      "id": "translation_x",
      "name": "Translation X",
      "type": "float",
      "default": -0.5,
      "min": -10,
      "max": 10
    },
    {
      "id": "translation_y",
      "name": "Translation Y",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    },
    {
      "id": "translation_z",
      "name": "Translation Z",
      "type": "float",
      "default": -0.5,
      "min": -10,
      "max": 10
    },
    {
      "id": "iteration_scale",
      "name": "Iteration Scale",
      "type": "float",
      "default": 1,
      "min": 0.25,
      "max": 4
    },
    {
      "id": "transformation_order",
      "name": "Transformation Order",
      "type": "choice",
      "default": 0,
      "options": [
        "Rotate, Fold, Scale, Translate",
        "Fold, Scale, Translate, Rotate"
      ]
    },
    {
      "id": "translation_progression",
      "name": "Translation Progression",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 2.0
    }
  ],
  "helpers": "vec3 maker_iterative_rotational_fold(vec3 p,float iterations,vec3 angles,vec3 speeds,float time,float axes,vec3 translation,float scale,float order,vec3 rotation_modulation,vec3 translation_modulation,float progression){\n    vec3 a=radians(mod(angles+speeds*time+rotation_modulation,360.0));\n    vec3 c=cos(a),s=sin(a);\n    int count=int(clamp(floor(iterations+0.5),1.0,32.0));\n    int mode=int(clamp(floor(axes+0.5),0.0,7.0));\n    bool fx=mode==1||mode==4||mode==5||mode==7;\n    bool fy=mode==2||mode==4||mode==6||mode==7;\n    bool fz=mode==3||mode==5||mode==6||mode==7;\n    float ratio=clamp(progression,0.1,2.0);\n    float multiplier=1.0;\n    for(int i=0;i<32;++i){\n        if(i>=count) break;\n        if(order<0.5){\n        p=vec3(p.x,c.x*p.y-s.x*p.z,s.x*p.y+c.x*p.z);\n        p=vec3(c.y*p.x+s.y*p.z,p.y,-s.y*p.x+c.y*p.z);\n        p=vec3(c.z*p.x-s.z*p.y,s.z*p.x+c.z*p.y,p.z);\n        }\n        if(fx) p.x=abs(p.x);\n        if(fy) p.y=abs(p.y);\n        if(fz) p.z=abs(p.z);\n        p*=clamp(scale,0.25,4.0);\n        p+=(translation+translation_modulation)*multiplier;\n        multiplier*=ratio;\n        if(order>=0.5){\n        p=vec3(p.x,c.x*p.y-s.x*p.z,s.x*p.y+c.x*p.z);\n        p=vec3(c.y*p.x+s.y*p.z,p.y,-s.y*p.x+c.y*p.z);\n        p=vec3(c.z*p.x-s.z*p.y,s.z*p.x+c.z*p.y,p.z);\n        }\n    }\n    return p;\n}\nfloat maker_rot_fold_scale(float s,float n){return pow(clamp(s,0.25,4.0),clamp(floor(n+0.5),1.0,32.0));}\nfloat maker_rot_fold_translation_multiplier(float r,float n){return pow(clamp(r,0.1,2.0),clamp(floor(n+0.5),1.0,32.0)-1.0);}",
  "glsl_outputs": {
    "folded": "maker_iterative_rotational_fold({position},{iterations},vec3({angle_x},{angle_y},{angle_z}),vec3({speed_x},{speed_y},{speed_z}),{time},{fold_axes},vec3({translation_x},{translation_y},{translation_z}),{iteration_scale},{transformation_order},{rotation_modulation},{translation_modulation},{translation_progression})",
    "accumulated_scale": "maker_rot_fold_scale({iteration_scale},{iterations})",
    "inverse_scale": "(1.0/maker_rot_fold_scale({iteration_scale},{iterations}))",
    "compensated": "(maker_iterative_rotational_fold({position},{iterations},vec3({angle_x},{angle_y},{angle_z}),vec3({speed_x},{speed_y},{speed_z}),{time},{fold_axes},vec3({translation_x},{translation_y},{translation_z}),{iteration_scale},{transformation_order},{rotation_modulation},{translation_modulation},{translation_progression})/maker_rot_fold_scale({iteration_scale},{iterations}))",
    "final_translation_multiplier": "maker_rot_fold_translation_multiplier({translation_progression},{iterations})"
  }
}
