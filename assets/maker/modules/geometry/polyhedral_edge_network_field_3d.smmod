{
  "schema_version": 1,
  "id": "screenshaver.geometry.polyhedral_edge_network_field_3d",
  "name": "Polyhedral Edge Network Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Fixed regular Platonic solid topology; union of edge capsules and vertex spheres.",
  "uses": "Polyhedral Edge Network Field 3D",
  "notes": "Fixed regular Platonic solid topology; union of edge capsules and vertex spheres.",
  "header_color": "#557C9B",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0",
      "semantic_role": "time"
    }
  ],
  "outputs": [
    {
      "id": "combined_distance",
      "name": "Combined Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "edge_distance",
      "name": "Edge Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "vertex_distance",
      "name": "Vertex Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "nearest_edge_index",
      "name": "Nearest Edge Index",
      "type": "float"
    },
    {
      "id": "nearest_vertex_index",
      "name": "Nearest Vertex Index",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "solid",
      "name": "Solid",
      "type": "choice",
      "default": 0,
      "options": [
        "Tetrahedron",
        "Cube",
        "Octahedron",
        "Dodecahedron",
        "Icosahedron"
      ]
    },
    {
      "id": "circumradius",
      "name": "Circumradius",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "edge_thickness",
      "name": "Edge Thickness",
      "type": "float",
      "default": 0.03,
      "min": 0.001,
      "max": 1
    },
    {
      "id": "vertex_radius",
      "name": "Vertex Radius",
      "type": "float",
      "default": 0.05,
      "min": 0.001,
      "max": 1
    },
    {
      "id": "activation",
      "name": "Activation",
      "type": "choice",
      "default": 0,
      "options": [
        "Edges and Vertices",
        "Edges",
        "Vertices"
      ]
    }
  ],
  "helpers": "struct MakerPolyEdgeResult{float field;float edge;float vertex;float ei;float vi;};\nvoid maker_poly_edge_sample(vec3 p,vec3 a,vec3 b,float index,inout float best,inout float idx){vec3 v=b-a;float d=length(p-a-v*clamp(dot(p-a,v)/max(dot(v,v),1e-12),0.0,1.0));if(d<best){best=d;idx=index;}}\nMakerPolyEdgeResult maker_polyhedral_edge_network_field_3d(vec3 p,vec3 c,float t,float solid,float radius,float ew,float vw,float activation){p-=c;float ed=1e20,vd=1e20,ei=0.0,vi=0.0;vec3 v[20];float d;if(solid<0.5){v[0]=radius*vec3(0.577350269,0.577350269,0.577350269);v[1]=radius*vec3(0.577350269,-0.577350269,-0.577350269);v[2]=radius*vec3(-0.577350269,0.577350269,-0.577350269);v[3]=radius*vec3(-0.577350269,-0.577350269,0.577350269);for(int i=0;i<4;i++){d=length(p-v[i]);if(d<vd){vd=d;vi=float(i);}}maker_poly_edge_sample(p,v[0],v[1],0.0,ed,ei);maker_poly_edge_sample(p,v[0],v[2],1.0,ed,ei);maker_poly_edge_sample(p,v[0],v[3],2.0,ed,ei);maker_poly_edge_sample(p,v[1],v[2],3.0,ed,ei);maker_poly_edge_sample(p,v[1],v[3],4.0,ed,ei);maker_poly_edge_sample(p,v[2],v[3],5.0,ed,ei);}else if(solid<1.5){v[0]=radius*vec3(-0.577350269,-0.577350269,-0.577350269);v[1]=radius*vec3(-0.577350269,-0.577350269,0.577350269);v[2]=radius*vec3(-0.577350269,0.577350269,-0.577350269);v[3]=radius*vec3(-0.577350269,0.577350269,0.577350269);v[4]=radius*vec3(0.577350269,-0.577350269,-0.577350269);v[5]=radius*vec3(0.577350269,-0.577350269,0.577350269);v[6]=radius*vec3(0.577350269,0.577350269,-0.577350269);v[7]=radius*vec3(0.577350269,0.577350269,0.577350269);for(int i=0;i<8;i++){d=length(p-v[i]);if(d<vd){vd=d;vi=float(i);}}maker_poly_edge_sample(p,v[0],v[1],0.0,ed,ei);maker_poly_edge_sample(p,v[0],v[2],1.0,ed,ei);maker_poly_edge_sample(p,v[0],v[4],2.0,ed,ei);maker_poly_edge_sample(p,v[1],v[3],3.0,ed,ei);maker_poly_edge_sample(p,v[1],v[5],4.0,ed,ei);maker_poly_edge_sample(p,v[2],v[3],5.0,ed,ei);maker_poly_edge_sample(p,v[2],v[6],6.0,ed,ei);maker_poly_edge_sample(p,v[3],v[7],7.0,ed,ei);maker_poly_edge_sample(p,v[4],v[5],8.0,ed,ei);maker_poly_edge_sample(p,v[4],v[6],9.0,ed,ei);maker_poly_edge_sample(p,v[5],v[7],10.0,ed,ei);maker_poly_edge_sample(p,v[6],v[7],11.0,ed,ei);}else if(solid<2.5){v[0]=radius*vec3(-1.000000000,0.000000000,0.000000000);v[1]=radius*vec3(1.000000000,0.000000000,0.000000000);v[2]=radius*vec3(0.000000000,-1.000000000,0.000000000);v[3]=radius*vec3(0.000000000,1.000000000,0.000000000);v[4]=radius*vec3(0.000000000,0.000000000,-1.000000000);v[5]=radius*vec3(0.000000000,0.000000000,1.000000000);for(int i=0;i<6;i++){d=length(p-v[i]);if(d<vd){vd=d;vi=float(i);}}maker_poly_edge_sample(p,v[0],v[2],0.0,ed,ei);maker_poly_edge_sample(p,v[0],v[3],1.0,ed,ei);maker_poly_edge_sample(p,v[0],v[4],2.0,ed,ei);maker_poly_edge_sample(p,v[0],v[5],3.0,ed,ei);maker_poly_edge_sample(p,v[1],v[2],4.0,ed,ei);maker_poly_edge_sample(p,v[1],v[3],5.0,ed,ei);maker_poly_edge_sample(p,v[1],v[4],6.0,ed,ei);maker_poly_edge_sample(p,v[1],v[5],7.0,ed,ei);maker_poly_edge_sample(p,v[2],v[4],8.0,ed,ei);maker_poly_edge_sample(p,v[2],v[5],9.0,ed,ei);maker_poly_edge_sample(p,v[3],v[4],10.0,ed,ei);maker_poly_edge_sample(p,v[3],v[5],11.0,ed,ei);}else if(solid<3.5){v[0]=radius*vec3(-0.577350269,-0.577350269,-0.577350269);v[1]=radius*vec3(-0.577350269,-0.577350269,0.577350269);v[2]=radius*vec3(-0.577350269,0.577350269,-0.577350269);v[3]=radius*vec3(-0.577350269,0.577350269,0.577350269);v[4]=radius*vec3(0.577350269,-0.577350269,-0.577350269);v[5]=radius*vec3(0.577350269,-0.577350269,0.577350269);v[6]=radius*vec3(0.577350269,0.577350269,-0.577350269);v[7]=radius*vec3(0.577350269,0.577350269,0.577350269);v[8]=radius*vec3(0.000000000,-0.356822090,-0.934172359);v[9]=radius*vec3(-0.356822090,-0.934172359,0.000000000);v[10]=radius*vec3(-0.934172359,0.000000000,-0.356822090);v[11]=radius*vec3(0.000000000,-0.356822090,0.934172359);v[12]=radius*vec3(-0.356822090,0.934172359,0.000000000);v[13]=radius*vec3(0.934172359,0.000000000,-0.356822090);v[14]=radius*vec3(0.000000000,0.356822090,-0.934172359);v[15]=r