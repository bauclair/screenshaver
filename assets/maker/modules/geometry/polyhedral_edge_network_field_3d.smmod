50650808);v[4]=radius*vec3(-0.525731112,0.850650808,0.000000000);v[5]=radius*vec3(0.850650808,0.000000000,-0.525731112);v[6]=radius*vec3(0.000000000,0.525731112,-0.850650808);v[7]=radius*vec3(0.525731112,-0.850650808,0.000000000);v[8]=radius*vec3(-0.850650808,0.000000000,0.525731112);v[9]=radius*vec3(0.000000000,0.525731112,0.850650808);v[10]=radius*vec3(0.525731112,0.850650808,0.000000000);v[11]=radius*vec3(0.850650808,0.000000000,0.525731112);for(int i=0;i<12;i++){d=length(p-v[i]);if(d<vd){vd=d;vi=float(i);}}maker_poly_edge_sample(p,v[0],v[1],0.0,ed,ei);maker_poly_edge_sample(p,v[0],v[2],1.0,ed,ei);maker_poly_edge_sample(p,v[0],v[5],2.0,ed,ei);maker_poly_edge_sample(p,v[0],v[6],3.0,ed,ei);maker_poly_edge_sample(p,v[0],v[7],4.0,ed,ei);maker_poly_edge_sample(p,v[1],v[2],5.0,ed,ei);maker_poly_edge_sample(p,v[1],v[3],6.0,ed,ei);maker_poly_edge_sample(p,v[1],v[7],7.0,ed,ei);maker_poly_edge_sample(p,v[1],v[8],8.0,ed,ei);maker_poly_edge_sample(p,v[2],v[4],9.0,ed,ei);maker_poly_edge_sample(p,v[2],v[6],10.0,ed,ei);maker_poly_edge_sample(p,v[2],v[8],11.0,ed,ei);maker_poly_edge_sample(p,v[3],v[7],12.0,ed,ei);maker_poly_edge_sample(p,v[3],v[8],13.0,ed,ei);maker_poly_edge_sample(p,v[3],v[9],14.0,ed,ei);maker_poly_edge_sample(p,v[3],v[11],15.0,ed,ei);maker_poly_edge_sample(p,v[4],v[6],16.0,ed,ei);maker_poly_edge_sample(p,v[4],v[8],17.0,ed,ei);maker_poly_edge_sample(p,v[4],v[9],18.0,ed,ei);maker_poly_edge_sample(p,v[4],v[10],19.0,ed,ei);maker_poly_edge_sample(p,v[5],v[6],20.0,ed,ei);maker_poly_edge_sample(p,v[5],v[7],21.0,ed,ei);maker_poly_edge_sample(p,v[5],v[10],22.0,ed,ei);maker_poly_edge_sample(p,v[5],v[11],23.0,ed,ei);maker_poly_edge_sample(p,v[6],v[10],24.0,ed,ei);maker_poly_edge_sample(p,v[7],v[11],25.0,ed,ei);maker_poly_edge_sample(p,v[8],v[9],26.0,ed,ei);maker_poly_edge_sample(p,v[9],v[10],27.0,ed,ei);maker_poly_edge_sample(p,v[9],v[11],28.0,ed,ei);maker_poly_edge_sample(p,v[10],v[11],29.0,ed,ei);}ed-=ew;vd-=vw;return MakerPolyEdgeResult(activation<.5?min(ed,vd):activation<1.5?ed:vd,ed,vd,ei,vi);}",
  "glsl_outputs": {
