{
  "schema_version": 1,
  "id": "screenshaver.geometry.superquadric_surface_field_3d",
  "name": "Superquadric Surface Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#557C9C",
  "description": "Superquadric Surface Field 3D",
  "uses": "Procedural geometry and contour composition.",
  "notes": "Nested power norms with optional toroidal radial offset. Residual is dimensionless and not an SDF. Exponents below one produce nonconvex profiles. Supertoroid major radius is in normalized horizontal units.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "shape",
      "name": "Shape",
      "type": "choice",
      "default": 0,
      "options": [
        "Superellipsoid",
        "Supertoroid"
      ]
    },
    {
      "id": "x_radius",
      "name": "X Radius",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "y_radius",
      "name": "Y Radius",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "z_radius",
      "name": "Z Radius",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "horizontal_exponent",
      "name": "Horizontal Exponent",
      "type": "float",
      "default": 2,
      "min": 0.25,
      "max": 8
    },
    {
      "id": "vertical_exponent",
      "name": "Vertical Exponent",
      "type": "float",
      "default": 2,
      "min": 0.25,
      "max": 8
    },
    {
      "id": "major_radius",
      "name": "Major Radius",
      "type": "float",
      "default": 1.5,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "contour_width",
      "name": "Contour Width",
      "type": "float",
      "default": 0.02,
      "min": 1e-05,
      "max": 1
    }
  ],
  "outputs": [
    {
      "id": "implicit_residual",
      "name": "Implicit Residual",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "interior_mask",
      "name": "Interior Mask",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "horizontal_radius",
      "name": "Horizontal Radius",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "contour",
      "name": "Contour",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "\nstruct MakerShape2 {float implicit_residual; float interior_mask; float horizontal_radius; float contour;};\nMakerShape2 maker_superquadric_surface_field_3d(vec3 position,vec3 center,float shape,float x_radius,float y_radius,float z_radius,float horizontal_exponent,float vertical_exponent,float major_radius,float contour_width){\nvec3 q=abs(clamp(position-center,vec3(-1e5),vec3(1e5))/vec3(x_radius,y_radius,z_radius));float h=pow(pow(q.x,horizontal_exponent)+pow(q.y,horizontal_exponent),1./horizontal_exponent);float u=shape<.5?h:abs(h-major_radius);float d=pow(pow(u,vertical_exponent)+pow(q.z,vertical_exponent),1./vertical_exponent)-1.;return MakerShape2(d,step(d,0.),h,1.-smoothstep(0.,contour_width,abs(d)));\n}",
  "glsl_outputs": {
    "implicit_residual": "maker_superquadric_surface_field_3d({position},{center},{shape},{x_radius},{y_radius},{z_radius},{horizontal_exponent},{vertical_exponent},{major_radius},{contour_width}).implicit_residual",
    "interior_mask": "maker_superquadric_surface_field_3d({position},{center},{shape},{x_radius},{y_radius},{z_radius},{horizontal_exponent},{vertical_exponent},{major_radius},{contour_width}).interior_mask",
    "horizontal_radius": "maker_superquadric_surface_field_3d({position},{center},{shape},{x_radius},{y_radius},{z_radius},{horizontal_exponent},{vertical_exponent},{major_radius},{contour_width}).horizontal_radius",
    "contour": "maker_superquadric_surface_field_3d({position},{center},{shape},{x_radius},{y_radius},{z_radius},{horizontal_exponent},{vertical_exponent},{major_radius},{contour_width}).contour"
  }
}
