{
  "schema_version": 1,
  "id": "screenshaver.geometry.sdf_capsule",
  "name": "SDF Capsule",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "SDF Capsule procedural geometry and animation utility.",
  "uses": "SDF Capsule procedural geometry and animation utility.",
  "notes": "Coincident endpoints become a sphere. Radius modulation is additive.",
  "header_color": "#477D9A",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "endpoint_a",
      "name": "Endpoint A",
      "type": "vec3",
      "default": "vec3(0.0,-0.5,0.0)"
    },
    {
      "id": "endpoint_b",
      "name": "Endpoint B",
      "type": "vec3",
      "default": "vec3(0.0,0.5,0.0)"
    },
    {
      "id": "radius_modulation",
      "name": "Radius Modulation",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "axis_distance",
      "name": "Axis Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "closest_axis_point",
      "name": "Closest Axis Point",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "segment_progress",
      "name": "Segment Progress",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 10
    }
  ],
  "helpers": "struct MakerCapsule {float d;float axis;vec3 point;float progress;};\nMakerCapsule maker_capsule(vec3 p,vec3 a,vec3 b,float r){vec3 e=b-a;float l=dot(e,e);float t=l>1e-20?clamp(dot(p-a,e)/l,0.0,1.0):0.0;vec3 c=a+t*e;float d=length(p-c);return MakerCapsule(d-clamp(r,0.0,10.0),d,c,t);}",
  "glsl_outputs": {
    "distance": "maker_capsule({position},{endpoint_a},{endpoint_b},{radius}+{radius_modulation}).d",
    "axis_distance": "maker_capsule({position},{endpoint_a},{endpoint_b},{radius}+{radius_modulation}).axis",
    "closest_axis_point": "maker_capsule({position},{endpoint_a},{endpoint_b},{radius}+{radius_modulation}).point",
    "segment_progress": "maker_capsule({position},{endpoint_a},{endpoint_b},{radius}+{radius_modulation}).progress"
  }
}
