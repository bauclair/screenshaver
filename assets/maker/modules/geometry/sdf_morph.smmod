{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.geometry.sdf_morph",
  "name": "SDF Morph",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Blend between two distance fields with optional animation.",
  "uses": "Reusable signed-distance geometry and procedural field composition.",
  "notes": "Position is evaluated at the active ray-march sample. No texture dependency.",
  "inputs": [
    {
      "id": "a",
      "name": "A",
      "type": "float",
      "default": "1.0"
    },
    {
      "id": "b",
      "name": "B",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "blend",
      "name": "Blend",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 8.0
    },
    {
      "id": "animate",
      "name": "Animate",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0
    }
  ],
  "helpers": "",
  "glsl": "mix({a},{b},clamp(mix({blend},0.5+0.5*sin(u_time*{speed}),step(0.5,{animate})),0.0,1.0))"
}
