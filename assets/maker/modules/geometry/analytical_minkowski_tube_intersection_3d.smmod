{
  "schema_version": 1,
  "id": "screenshaver.geometry.analytical_minkowski_tube_intersection_3d",
  "name": "Analytical Minkowski Tube Intersection 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Analytical Minkowski Tube Intersection 3D",
  "uses": "Analytical Minkowski Tube Intersection 3D",
  "notes": "Axis-centered origins only; miss outputs zero. Surface angle in turns.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "ray_direction",
      "name": "Ray Direction",
      "type": "vec3",
      "default": "normalize(vec3(maker_uv,1.0))"
    },
    {
      "id": "axial_origin",
      "name": "Axial Origin",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "radius_multiplier",
      "name": "Radius Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "hit_distance",
      "name": "Hit Distance",
      "type": "float"
    },
    {
      "id": "hit_position",
      "name": "Hit Position",
      "type": "vec3"
    },
    {
      "id": "surface_normal",
      "name": "Surface Normal",
      "type": "vec3"
    },
    {
      "id": "surface_coordinates",
      "name": "Surface Coordinates",
      "type": "vec2"
    },
    {
      "id": "hit_mask",
      "name": "Hit Mask",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "minkowski_exponent",
      "name": "Minkowski Exponent",
      "type": "float",
      "default": 4,
      "min": 1,
      "max": 32
    },
    {
      "id": "horizontal_scale",
      "name": "Horizontal Scale",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "vertical_scale",
      "name": "Vertical Scale",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "maximum_distance",
      "name": "Maximum Distance",
      "type": "float",
      "default": 100,
      "min": 1,
      "max": 10000
    },
    {
      "id": "orientation",
      "name": "Orientation",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "rotation_axis",
      "name": "Rotation Axis",
      "type": "choice",
      "default": 2,
      "options": [
        "X",
        "Y",
        "Z"
      ]
    },
    {
      "id": "normal_direction",
      "name": "Normal Direction",
      "type": "choice",
      "default": 0,
      "options": [
        "Inward",
        "Outward"
      ]
    }
  ],
  "helpers": "\nstruct MakerB330AnalyticalMinkowskiTubeIntersection3D {float hit_distance;vec3 hit_position;vec3 surface_normal;vec2 surface_coordinates;float hit_mask;};\nMakerB330AnalyticalMinkowskiTubeIntersection3D maker_b330_analytical_minkowski_tube_intersection_3d(vec3 ray_direction,float axial_origin,float radius_multiplier,float radius,float minkowski_exponent,float horizontal_scale,float vertical_scale,float maximum_distance,float orientation,float rotation_axis,float normal_direction,float tm){\nfloat l=length(ray_direction);if(l<1e-8||isnan(l)||isinf(l))return MakerB330AnalyticalMinkowskiTubeIntersection3D(0.,vec3(0),vec3(0),vec2(0),0.);vec3 d=ray_direction/l;if(rotation_axis<.5)d=d.yzx;else if(rotation_axis<1.5)d=d.zxy;float a=radians(orientation);mat2 rot=mat2(cos(a),sin(a),-sin(a),cos(a));vec2 v=transpose(rot)*d.xy/vec2(horizontal_scale,vertical_scale);float m=max(abs(v.x),abs(v.y));if(m<1e-10)return MakerB330AnalyticalMinkowskiTubeIntersection3D(0.,vec3(0),vec3(0),vec2(0),0.);float e=minkowski_exponent;float den=m*pow(pow(abs(v.x)/m,e)+pow(abs(v.y)/m,e),1./e);float t=max(1e-6,radius*radius_multiplier)/den;if(t>maximum_distance)return MakerB330AnalyticalMinkowskiTubeIntersection3D(0.,vec3(0),vec3(0),vec2(0),0.);vec3 q=d*t+vec3(0,0,axial_origin);vec2 u=v/m;vec2 g=sign(u)*pow(abs(u),vec2(max(e-1.,1e-6)))/vec2(horizontal_scale,vertical_scale);vec3 n=normalize(vec3(rot*g,0));if(normal_direction<.5)n=-n;vec2 uv=vec2(atan(v.y,v.x)/6.2831853,q.z);if(rotation_axis<.5){q=q.zxy;n=n.zxy;}else if(rotation_axis<1.5){q=q.yzx;n=n.yzx;}return MakerB330AnalyticalMinkowskiTubeIntersection3D(t,q,n,uv,1.);\n}",
  "glsl_outputs": {
    "hit_distance": "maker_b330_analytical_minkowski_tube_intersection_3d({ray_direction},{axial_origin},{radius_multiplier},{radius},{minkowski_exponent},{horizontal_scale},{vertical_scale},{maximum_distance},{orientation},{rotation_axis},{normal_direction},u_time).hit_distance",
    "hit_position": "maker_b330_analytical_minkowski_tube_intersection_3d({ray_direction},{axial_origin},{radius_multiplier},{radius},{minkowski_exponent},{horizontal_scale},{vertical_scale},{maximum_distance},{orientation},{rotation_axis},{normal_direction},u_time).hit_position",
    "surface_normal": "maker_b330_analytical_minkowski_tube_intersection_3d({ray_direction},{axial_origin},{radius_multiplier},{radius},{minkowski_exponent},{horizontal_scale},{vertical_scale},{maximum_distance},{orientation},{rotation_axis},{normal_direction},u_time).surface_normal",
    "surface_coordinates": "maker_b330_analytical_minkowski_tube_intersection_3d({ray_direction},{axial_origin},{radius_multiplier},{radius},{minkowski_exponent},{horizontal_scale},{vertical_scale},{maximum_distance},{orientation},{rotation_axis},{normal_direction},u_time).surface_coordinates",
    "hit_mask": "maker_b330_analytical_minkowski_tube_intersection_3d({ray_direction},{axial_origin},{radius_multiplier},{radius},{minkowski_exponent},{horizontal_scale},{vertical_scale},{maximum_distance},{orientation},{rotation_axis},{normal_direction},u_time).hit_mask"
  }
}
