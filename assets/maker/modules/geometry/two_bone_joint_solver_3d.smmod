{
  "schema_version": 1,
  "id": "screenshaver.geometry.two_bone_joint_solver_3d",
  "name": "Two-Bone Joint Solver 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Two-Bone Joint Solver 3D procedural geometry and animation utility.",
  "uses": "Two-Bone Joint Solver 3D procedural geometry and animation utility.",
  "notes": "Lengths clamped to 0.001\u201320. Equal lengths and coincident target fold along bend direction. Unreachable target clamped to reachable shell.",
  "header_color": "#477D9A",
  "terminal": false,
  "inputs": [
    {
      "id": "root_position",
      "name": "Root Position",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "target_position",
      "name": "Target Position",
      "type": "vec3",
      "default": "vec3(1.0,0.0,0.0)"
    },
    {
      "id": "bend_direction",
      "name": "Bend Direction",
      "type": "vec3",
      "default": "vec3(0.0,1.0,0.0)"
    },
    {
      "id": "first_length_multiplier",
      "name": "First Length Multiplier",
      "type": "float",
      "default": "1.0"
    },
    {
      "id": "second_length_multiplier",
      "name": "Second Length Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "joint_position",
      "name": "Joint Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "end_position",
      "name": "End Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "first_bone_direction",
      "name": "First Bone Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    },
    {
      "id": "second_bone_direction",
      "name": "Second Bone Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    },
    {
      "id": "reachable_mask",
      "name": "Reachable Mask",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "target_error",
      "name": "Target Error",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "first_length",
      "name": "First Bone Length",
      "type": "float",
      "default": 0.75,
      "min": 0.001,
      "max": 20
    },
    {
      "id": "second_length",
      "name": "Second Bone Length",
      "type": "float",
      "default": 0.65,
      "min": 0.001,
      "max": 20
    },
    {
      "id": "bend_orientation",
      "name": "Bend Orientation",
      "type": "choice",
      "default": 0,
      "options": [
        "Positive",
        "Negative"
      ]
    }
  ],
  "helpers": "struct MakerJoint {vec3 joint;vec3 end;vec3 first;vec3 second;float reachable;float error;};\nMakerJoint maker_joint(vec3 p,vec3 target,vec3 bend,float a,float b,float mode){a=clamp(a,0.001,20.0);b=clamp(b,0.001,20.0);vec3 delta=target-p;float raw=length(delta),l=clamp(raw,abs(a-b),a+b);vec3 u=raw>1e-8?delta/raw:vec3(1,0,0);vec3 n=bend-u*dot(bend,u);if(length(n)<1e-8){vec3 axis=abs(u.y)<0.9?vec3(0,1,0):vec3(0,0,1);n=axis-u*dot(axis,u);}n=normalize(n)*(mode<0.5?1.0:-1.0);float x=l>1e-8?0.5*(l+(a-b)*(a+b)/l):0.0;float h=sqrt(max(0.0,a*a-x*x));vec3 j=p+x*u+h*n,e=p+l*u;return MakerJoint(j,e,normalize(j-p),normalize(e-j),raw>=abs(a-b)&&raw<=a+b?1.0:0.0,length(e-target));}",
  "glsl_outputs": {
    "joint_position": "maker_joint({root_position},{target_position},{bend_direction},{first_length}*{first_length_multiplier},{second_length}*{second_length_multiplier},{bend_orientation}).joint",
    "end_position": "maker_joint({root_position},{target_position},{bend_direction},{first_length}*{first_length_multiplier},{second_length}*{second_length_multiplier},{bend_orientation}).end",
    "first_bone_direction": "maker_joint({root_position},{target_position},{bend_direction},{first_length}*{first_length_multiplier},{second_length}*{second_length_multiplier},{bend_orientation}).first",
    "second_bone_direction": "maker_joint({root_position},{target_position},{bend_direction},{first_length}*{first_length_multiplier},{second_length}*{second_length_multiplier},{bend_orientation}).second",
    "reachable_mask": "maker_joint({root_position},{target_position},{bend_direction},{first_length}*{first_length_multiplier},{second_length}*{second_length_multiplier},{bend_orientation}).reachable",
    "target_error": "maker_joint({root_position},{target_position},{bend_direction},{first_length}*{first_length_multiplier},{second_length}*{second_length_multiplier},{bend_orientation}).error"
  }
}
