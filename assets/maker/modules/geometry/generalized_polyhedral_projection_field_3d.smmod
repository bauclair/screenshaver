{
  "schema_version": 1,
  "id": "screenshaver.geometry.generalized_polyhedral_projection_field_3d",
  "name": "Generalized Polyhedral Projection Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Generalized Polyhedral Projection Field 3D",
  "uses": "Generalized Polyhedral Projection Field 3D",
  "notes": "Maximum normalized plane violation; conservative exterior distance, not exact at corners.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0)"
    },
    {
      "id": "size_multiplier",
      "name": "Size Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "projection_field",
      "name": "Projection Field",
      "type": "float"
    },
    {
      "id": "interior_mask",
      "name": "Interior Mask",
      "type": "float"
    },
    {
      "id": "dominant_plane_index",
      "name": "Dominant Plane Index",
      "type": "float"
    },
    {
      "id": "dominant_plane_normal",
      "name": "Dominant Plane Normal",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "plane_configuration",
      "name": "Plane Configuration",
      "type": "choice",
      "default": 0,
      "options": [
        "Face Diagonal",
        "Body Diagonal",
        "Axial",
        "Combined",
        "Oblique"
      ]
    },
    {
      "id": "axial_plane_offset",
      "name": "Axial Plane Offset",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 10
    },
    {
      "id": "diagonal_plane_offset",
      "name": "Diagonal Plane Offset",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 10
    },
    {
      "id": "oblique_plane_offset",
      "name": "Oblique Plane Offset",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 10
    },
    {
      "id": "oblique_plane_angle",
      "name": "Oblique Plane Angle",
      "type": "float",
      "default": 45,
      "min": 1,
      "max": 89
    },
    {
      "id": "boundary_offset",
      "name": "Boundary Offset",
      "type": "float",
      "default": 0,
      "min": -10,
      "max": 10
    }
  ],
  "helpers": "\nstruct MakerB330GeneralizedPolyhedralProjectionField3D {float projection_field;float interior_mask;float dominant_plane_index;vec3 dominant_plane_normal;};\nMakerB330GeneralizedPolyhedralProjectionField3D maker_b330_generalized_polyhedral_projection_field_3d(vec3 position,vec3 center,float size_multiplier,float size,float plane_configuration,float axial_plane_offset,float diagonal_plane_offset,float oblique_plane_offset,float oblique_plane_angle,float boundary_offset,float tm){\nvec3 q=position-center;float s=max(1e-6,size*size_multiplier);float best=-1e30;vec3 normal=vec3(1,0,0);float idx=0.;for(int i=0;i<16;i++){vec3 n;float r;bool usePlane=false;if(i<3){n=vec3(0);n[i]=1.;r=axial_plane_offset;usePlane=plane_configuration>1.5&&plane_configuration<3.5;}else if(i<9){int j=(i-3)/2;float signv=(i%2==1)?1.:-1.;n=vec3(0);n[j]=.70710678;n[(j+1)%3]=signv*.70710678;r=diagonal_plane_offset;usePlane=plane_configuration<.5||abs(plane_configuration-3.)<.5;}else if(i<13){int j=i-9;n=normalize(vec3(1.,(j%2==0)?1.:-1.,(j/2==0)?1.:-1.));r=diagonal_plane_offset;usePlane=abs(plane_configuration-1.)<.5||abs(plane_configuration-3.)<.5;}else{int j=i-13;float a=radians(oblique_plane_angle);n=vec3(0);n[j]=cos(a);n[(j+1)%3]=sin(a);r=oblique_plane_offset;usePlane=plane_configuration>3.5;}if(usePlane){float v=dot(q,n);float d=abs(v)-s*r;if(d>best){best=d;normal=v<0.?-n:n;idx=float(i);}}}best-=boundary_offset;return MakerB330GeneralizedPolyhedralProjectionField3D(best,best<=0.?1.:0.,idx,normal);\n}",
  "glsl_outputs": {
    "projection_field": "maker_b330_generalized_polyhedral_projection_field_3d({position},{center},{size_multiplier},{size},{plane_configuration},{axial_plane_offset},{diagonal_plane_offset},{oblique_plane_offset},{oblique_plane_angle},{boundary_offset},u_time).projection_field",
    "interior_mask": "maker_b330_generalized_polyhedral_projection_field_3d({position},{center},{size_multiplier},{size},{plane_configuration},{axial_plane_offset},{diagonal_plane_offset},{oblique_plane_offset},{oblique_plane_angle},{boundary_offset},u_time).interior_mask",
    "dominant_plane_index": "maker_b330_generalized_polyhedral_projection_field_3d({position},{center},{size_multiplier},{size},{plane_configuration},{axial_plane_offset},{diagonal_plane_offset},{oblique_plane_offset},{oblique_plane_angle},{boundary_offset},u_time).dominant_plane_index",
    "dominant_plane_normal": "maker_b330_generalized_polyhedral_projection_field_3d({position},{center},{size_multiplier},{size},{plane_configuration},{axial_plane_offset},{diagonal_plane_offset},{oblique_plane_offset},{oblique_plane_angle},{boundary_offset},u_time).dominant_plane_normal"
  }
}
