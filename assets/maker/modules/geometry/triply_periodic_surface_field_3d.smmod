{
  "schema_version": 1,
  "id": "screenshaver.geometry.triply_periodic_surface_field_3d",
  "name": "Triply Periodic Surface Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#557C9C",
  "description": "Triply Periodic Surface Field 3D",
  "uses": "Procedural geometry and contour composition.",
  "notes": "Classical trigonometric nodal approximations, not exact minimal surfaces or signed distances. Existing gyroid remains separate.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "family",
      "name": "Family",
      "type": "choice",
      "default": 0,
      "options": [
        "Schwarz P",
        "Schwarz D",
        "Neovius",
        "I-WP",
        "Fischer-Koch S"
      ]
    },
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 6,
      "min": 0.01,
      "max": 100
    },
    {
      "id": "level",
      "name": "Level",
      "type": "float",
      "default": 0,
      "min": -5,
      "max": 5
    },
    {
      "id": "width",
      "name": "Width",
      "type": "float",
      "default": 0.05,
      "min": 1e-05,
      "max": 2
    }
  ],
  "outputs": [
    {
      "id": "residual",
      "name": "Residual",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "shell",
      "name": "Shell",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "negative_mask",
      "name": "Negative Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "\nstruct MakerShape0 {float residual; float shell; float negative_mask;};\nMakerShape0 maker_triply_periodic_surface_field_3d(vec3 position,vec3 center,float family,float frequency,float level,float width){\nvec3 q=(position-center)*frequency;vec3 c=cos(q),s=sin(q);float f=c.x+c.y+c.z;if(family>.5&&family<1.5)f=s.x*s.y*s.z+s.x*c.y*c.z+c.x*s.y*c.z+c.x*c.y*s.z;else if(family>1.5&&family<2.5)f=3.*(c.x+c.y+c.z)+4.*c.x*c.y*c.z;else if(family>2.5&&family<3.5)f=2.*(c.x*c.y+c.y*c.z+c.z*c.x)-dot(cos(2.*q),vec3(1.));else if(family>3.5)f=cos(2.*q.x)*s.y*c.z+cos(2.*q.y)*s.z*c.x+cos(2.*q.z)*s.x*c.y;f-=level;return MakerShape0(f,1.-smoothstep(0.,width,abs(f)),step(f,0.));\n}",
  "glsl_outputs": {
    "residual": "maker_triply_periodic_surface_field_3d({position},{center},{family},{frequency},{level},{width}).residual",
    "shell": "maker_triply_periodic_surface_field_3d({position},{center},{family},{frequency},{level},{width}).shell",
    "negative_mask": "maker_triply_periodic_surface_field_3d({position},{center},{family},{frequency},{level},{width}).negative_mask"
  }
}
