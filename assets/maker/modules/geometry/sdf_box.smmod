{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.geometry.sdf_box",
  "name": "SDF Box",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Axis-aligned box field using the maximum signed axis offset.",
  "uses": "Reusable signed-distance geometry and procedural field composition.",
  "notes": "Fast box field with planar-distance behavior near corners; not an exact Euclidean signed distance outside the box. Position is evaluated at the active sample.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(0.0)"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "size_x",
      "name": "Size X",
      "type": "float",
      "default": 0.8,
      "min": 0.02,
      "max": 8.0
    },
    {
      "id": "size_y",
      "name": "Size Y",
      "type": "float",
      "default": 0.8,
      "min": 0.02,
      "max": 8.0
    },
    {
      "id": "size_z",
      "name": "Size Z",
      "type": "float",
      "default": 0.8,
      "min": 0.02,
      "max": 8.0
    }
  ],
  "helpers": "",
  "glsl": "max(max(abs({position}.x)-{size_x}, abs({position}.y)-{size_y}), abs({position}.z)-{size_z})"
}
