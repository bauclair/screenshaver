{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "helpers": "vec2 maker_b402_segment_local(vec2 p,vec2 a,vec2 b){vec2 v=b-a;float l=length(v);vec2 u=l>1e-8?v/l:vec2(1.,0.);return vec2(dot(p-a,u),dot(p-a,vec2(-u.y,u.x)));}",
  "id": "screenshaver.geometry.point_segment_distance_2d",
  "name": "Point-to-Segment Distance 2D",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Shortest Euclidean distance from a 2D point to a finite line segment.",
  "uses": "Procedural line art, finite line masks, geometric motifs and wireframes.",
  "notes": "Uses orthogonal projection clamped to the segment, with a guard for coincident endpoints. Standard analytic geometry, independently implemented.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "position2d"
    },
    {
      "id": "start",
      "name": "Segment Start",
      "type": "vec2",
      "default": "vec2(-0.5,0.0)"
    },
    {
      "id": "end",
      "name": "Segment End",
      "type": "vec2",
      "default": "vec2(0.5,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "longitudinal",
      "name": "Longitudinal",
      "type": "float"
    },
    {
      "id": "transverse",
      "name": "Transverse",
      "type": "float"
    }
  ],
  "parameters": [],
  "glsl_outputs": {
    "distance": "length(({position})-mix(({start}),({end}),clamp(dot(({position})-({start}),({end})-({start}))/max(dot(({end})-({start}),({end})-({start})),1e-10),0.0,1.0)))",
    "longitudinal": "maker_b402_segment_local({position},{start},{end}).x",
    "transverse": "maker_b402_segment_local({position},{start},{end}).y"
  }
}
