{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.geometry.3d_cellular_tile_field",
  "name": "3D Cellular Tile Field",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Repeated three-dimensional cells with a controllable boundary response.",
  "uses": "Abstract faceted surfaces and cellular masks.",
  "notes": "Uses centered repeated coordinates and the distance to the nearest cell boundary; gain controls output intensity.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "tile_scale",
      "name": "Tile Scale",
      "type": "float",
      "default": 5.5,
      "min": 0.1,
      "max": 30
    },
    {
      "id": "gain",
      "name": "Boundary Gain",
      "type": "float",
      "default": 2.66,
      "min": 0,
      "max": 8
    }
  ],
  "helpers": "float maker_cellular_tile(vec3 p, float tileScale, float gain) {\n    vec3 q = fract(p / max(tileScale, 0.001)) - vec3(0.5);\n    vec3 toEdge = vec3(0.5) - abs(q);\n    float edgeDistance = min(toEdge.x, min(toEdge.y, toEdge.z));\n    return clamp(1.0 - 2.0 * edgeDistance, 0.0, 1.0) * gain;\n}",
  "glsl": "maker_cellular_tile({position},{tile_scale},{gain})"
}
