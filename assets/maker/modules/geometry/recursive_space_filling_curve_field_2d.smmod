{
  "schema_version": 1,
  "id": "screenshaver.geometry.recursive_space_filling_curve_field_2d",
  "name": "Recursive Space-Filling Curve Field 2D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#557C9C",
  "description": "Recursive Space-Filling Curve Field 2D",
  "uses": "Procedural geometric patterns and independent color composition.",
  "notes": "Finite Hilbert or Peano serpentine recursive path, or Morton-order path (not continuous in the infinite limit). Exhaustive segment search. Hilbert/Morton depth 1\u20135, Peano depth 1\u20133. Distance to finite polyline.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "vec2(0.0)",
      "semantic_role": "position2d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec2",
      "default": "vec2(0.0)",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "family",
      "name": "Family",
      "type": "choice",
      "default": 0,
      "options": [
        "Hilbert",
        "Peano",
        "Morton"
      ]
    },
    {
      "id": "depth",
      "name": "Depth",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 5
    },
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 0.8,
      "min": 0.001,
      "max": 10
    },
    {
      "id": "line_width",
      "name": "Line Width",
      "type": "float",
      "default": 0.004,
      "min": 1e-05,
      "max": 1
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "nearest_point",
      "name": "Nearest Point",
      "type": "vec2",
      "semantic_role": "position2d"
    },
    {
      "id": "curve_parameter",
      "name": "Curve Parameter",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "line_mask",
      "name": "Line Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerG_recursive_space_filling_curve_field_2d {float distance; vec2 nearest_point; float curve_parameter; float line_mask;};\nMakerG_recursive_space_filling_curve_field_2d maker_recursive_space_filling_curve_field_2d(vec2 position,vec2 center,float family,float depth,float size,float line_width){\nint level=int(clamp(floor(depth+.5),1.,family> .5&&family<1.5?3.:5.));int side=1;for(int j=0;j<5;j++){if(j>=level)break;side*=family>.5&&family<1.5?3:2;}int count=side*side;vec2 prev=vec2(0.),nearest=vec2(0.);float best=1e30,param=0.;for(int i=0;i<1024;i++){if(i>=count)break;int x=0,y=0,k=i;if(family<.5){for(int j=0;j<5;j++){if(j>=level)break;int s=1<<j;int rx=(k/2)%2,ry=(k^rx)%2;if(ry==0){if(rx==1){x=s-1-x;y=s-1-y;}int tmp=x;x=y;y=tmp;}x+=s*rx;y+=s*ry;k/=4;}}else if(family<1.5){int scale=side;bool flipX=false,flipY=false;for(int j=0;j<3;j++){if(j>=level)break;scale/=3;int digit=(i/(scale*scale))%9;int col=digit/3,row=digit%3;if(col%2==1)row=2-row;x+=(flipX?2-col:col)*scale;y+=(flipY?2-row:row)*scale;flipX=flipX!=(row%2==1);flipY=flipY!=(col%2==1);}}else{for(int j=0;j<5;j++){if(j>=level)break;x+=((k%2)<<j);y+=(((k/2)%2)<<j);k/=4;}}vec2 v=center+size*(vec2(float(x),float(y))/float(side-1)-.5);if(i>0){vec2 e=v-prev;float h=clamp(dot(position-prev,e)/max(dot(e,e),1e-20),0.,1.);vec2 q=prev+h*e;float d=dot(position-q,position-q);if(d<best){best=d;nearest=q;param=(float(i-1)+h)/float(count-1);}}prev=v;}float d=sqrt(best);return MakerG_recursive_space_filling_curve_field_2d(d,nearest,param,1.-smoothstep(line_width,2.*line_width,d));\n}",
  "glsl_outputs": {
    "distance": "maker_recursive_space_filling_curve_field_2d({position},{center},{family},{depth},{size},{line_width}).distance",
    "nearest_point": "maker_recursive_space_filling_curve_field_2d({position},{center},{family},{depth},{size},{line_width}).nearest_point",
    "curve_parameter": "maker_recursive_space_filling_curve_field_2d({position},{center},{family},{depth},{size},{line_width}).curve_parameter",
    "line_mask": "maker_recursive_space_filling_curve_field_2d({position},{center},{family},{depth},{size},{line_width}).line_mask"
  }
}
