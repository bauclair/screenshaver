{
  "schema_version": 1,
  "id": "screenshaver.geometry.curvature_based_curve_field_2d",
  "name": "Curvature-Based Curve Field 2D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#557C9C",
  "description": "Curvature-Based Curve Field 2D",
  "uses": "Procedural geometric patterns and independent color composition.",
  "notes": "Euler spiral via bounded midpoint integration, circle involute and tractrix. Finite parameter interval; Euler integration is approximate. Distance is to sampled polyline, not analytic curve. Parameter is normalized, not arc length.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "vec2(0.0)",
      "semantic_role": "position2d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec2",
      "default": "vec2(0.0)",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "family",
      "name": "Family",
      "type": "choice",
      "default": 0,
      "options": [
        "Euler Spiral",
        "Circle Involute",
        "Tractrix"
      ]
    },
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 0.15,
      "min": 0.001,
      "max": 5
    },
    {
      "id": "extent",
      "name": "Extent",
      "type": "float",
      "default": 4,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "orientation",
      "name": "Orientation",
      "type": "float",
      "default": 0,
      "min": -6.283185,
      "max": 6.283185
    },
    {
      "id": "segments",
      "name": "Segments",
      "type": "float",
      "default": 128,
      "min": 16,
      "max": 512
    },
    {
      "id": "line_width",
      "name": "Line Width",
      "type": "float",
      "default": 0.005,
      "min": 1e-05,
      "max": 1
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "nearest_point",
      "name": "Nearest Point",
      "type": "vec2",
      "semantic_role": "position2d"
    },
    {
      "id": "curve_parameter",
      "name": "Curve Parameter",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "line_mask",
      "name": "Line Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerG_curvature_based_curve_field_2d {float distance; vec2 nearest_point; float curve_parameter; float line_mask;};\nMakerG_curvature_based_curve_field_2d maker_curvature_based_curve_field_2d(vec2 position,vec2 center,float family,float radius,float extent,float orientation,float segments,float line_width){\nvec2 prev=vec2(0.),nearest=vec2(0.);float best=1e30,param=0.;int n=int(clamp(floor(segments+.5),16.,512.));for(int i=0;i<=512;i++){if(i>n)break;float t=float(i)/float(n);vec2 v;float a=t*extent;if(family<.5){v=vec2(0.);for(int j=0;j<64;j++){float u=a*(float(j)+.5)/64.;v+=vec2(cos(.5*u*u),sin(.5*u*u));}v*=a/64.;}else if(family<1.5)v=vec2(cos(a)+a*sin(a),sin(a)-a*cos(a));else v=vec2(a-tanh(a),1./cosh(a));float c=cos(orientation),s=sin(orientation);v=radius*mat2(c,s,-s,c)*v; v+=center;if(i>0){vec2 e=v-prev;float h=clamp(dot(position-prev,e)/max(dot(e,e),1e-20),0.,1.);vec2 q=prev+h*e;float d=dot(position-q,position-q);if(d<best){best=d;nearest=q;param=(float(i-1)+h)/float(n);}}prev=v;}float d=sqrt(best);return MakerG_curvature_based_curve_field_2d(d,nearest,param,1.-smoothstep(line_width,2.*line_width,d));\n}",
  "glsl_outputs": {
    "distance": "maker_curvature_based_curve_field_2d({position},{center},{family},{radius},{extent},{orientation},{segments},{line_width}).distance",
    "nearest_point": "maker_curvature_based_curve_field_2d({position},{center},{family},{radius},{extent},{orientation},{segments},{line_width}).nearest_point",
    "curve_parameter": "maker_curvature_based_curve_field_2d({position},{center},{family},{radius},{extent},{orientation},{segments},{line_width}).curve_parameter",
    "line_mask": "maker_curvature_based_curve_field_2d({position},{center},{family},{radius},{extent},{orientation},{segments},{line_width}).line_mask"
  }
}
