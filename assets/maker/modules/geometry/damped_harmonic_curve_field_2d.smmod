{
  "schema_version": 1,
  "id": "screenshaver.geometry.damped_harmonic_curve_field_2d",
  "name": "Damped Harmonic Curve Field 2D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#557C9C",
  "description": "Damped Harmonic Curve Field 2D",
  "uses": "Procedural geometric patterns and independent color composition.",
  "notes": "Four independently damped harmonic terms form a finite harmonograph trace; distinct from time-evaluated Harmonic Motion Path. Distance is to sampled polyline, not analytic curve. Parameter is normalized, not arc length.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "vec2(0.0)",
      "semantic_role": "position2d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec2",
      "default": "vec2(0.0)",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 0.22,
      "min": 0.001,
      "max": 5
    },
    {
      "id": "turns",
      "name": "Turns",
      "type": "float",
      "default": 8,
      "min": 0.25,
      "max": 32
    },
    {
      "id": "x_frequency",
      "name": "X Frequency",
      "type": "float",
      "default": 2,
      "min": 0.1,
      "max": 12
    },
    {
      "id": "y_frequency",
      "name": "Y Frequency",
      "type": "float",
      "default": 3,
      "min": 0.1,
      "max": 12
    },
    {
      "id": "secondary_x",
      "name": "Secondary X",
      "type": "float",
      "default": 3.03,
      "min": 0.1,
      "max": 12
    },
    {
      "id": "secondary_y",
      "name": "Secondary Y",
      "type": "float",
      "default": 2.01,
      "min": 0.1,
      "max": 12
    },
    {
      "id": "secondary_weight",
      "name": "Secondary Weight",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 2
    },
    {
      "id": "decay",
      "name": "Decay",
      "type": "float",
      "default": 2,
      "min": 0,
      "max": 12
    },
    {
      "id": "secondary_decay",
      "name": "Secondary Decay",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 12
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 1.57,
      "min": -6.283185,
      "max": 6.283185
    },
    {
      "id": "segments",
      "name": "Segments",
      "type": "float",
      "default": 128,
      "min": 16,
      "max": 512
    },
    {
      "id": "line_width",
      "name": "Line Width",
      "type": "float",
      "default": 0.005,
      "min": 1e-05,
      "max": 1
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "nearest_point",
      "name": "Nearest Point",
      "type": "vec2",
      "semantic_role": "position2d"
    },
    {
      "id": "curve_parameter",
      "name": "Curve Parameter",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "line_mask",
      "name": "Line Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerG_damped_harmonic_curve_field_2d {float distance; vec2 nearest_point; float curve_parameter; float line_mask;};\nMakerG_damped_harmonic_curve_field_2d maker_damped_harmonic_curve_field_2d(vec2 position,vec2 center,float radius,float turns,float x_frequency,float y_frequency,float secondary_x,float secondary_y,float secondary_weight,float decay,float secondary_decay,float phase,float segments,float line_width){\nvec2 prev=vec2(0.),nearest=vec2(0.);float best=1e30,param=0.;int n=int(clamp(floor(segments+.5),16.,512.));for(int i=0;i<=512;i++){if(i>n)break;float t=float(i)/float(n);vec2 v;float a=6.28318530718*turns*t;v=radius*(exp(-decay*t)*vec2(sin(a*x_frequency),sin(a*y_frequency+phase))+secondary_weight*exp(-secondary_decay*t)*vec2(sin(a*secondary_x+phase),sin(a*secondary_y))); v+=center;if(i>0){vec2 e=v-prev;float h=clamp(dot(position-prev,e)/max(dot(e,e),1e-20),0.,1.);vec2 q=prev+h*e;float d=dot(position-q,position-q);if(d<best){best=d;nearest=q;param=(float(i-1)+h)/float(n);}}prev=v;}float d=sqrt(best);return MakerG_damped_harmonic_curve_field_2d(d,nearest,param,1.-smoothstep(line_width,2.*line_width,d));\n}",
  "glsl_outputs": {
    "distance": "maker_damped_harmonic_curve_field_2d({position},{center},{radius},{turns},{x_frequency},{y_frequency},{secondary_x},{secondary_y},{secondary_weight},{decay},{secondary_decay},{phase},{segments},{line_width}).distance",
    "nearest_point": "maker_damped_harmonic_curve_field_2d({position},{center},{radius},{turns},{x_frequency},{y_frequency},{secondary_x},{secondary_y},{secondary_weight},{decay},{secondary_decay},{phase},{segments},{line_width}).nearest_point",
    "curve_parameter": "maker_damped_harmonic_curve_field_2d({position},{center},{radius},{turns},{x_frequency},{y_frequency},{secondary_x},{secondary_y},{secondary_weight},{decay},{secondary_decay},{phase},{segments},{line_width}).curve_parameter",
    "line_mask": "maker_damped_harmonic_curve_field_2d({position},{center},{radius},{turns},{x_frequency},{y_frequency},{secondary_x},{secondary_y},{secondary_weight},{decay},{secondary_decay},{phase},{segments},{line_width}).line_mask"
  }
}
