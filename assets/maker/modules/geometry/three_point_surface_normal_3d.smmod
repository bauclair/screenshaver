{
  "schema_version": 1,
  "id": "screenshaver.geometry.three_point_surface_normal_3d",
  "name": "Three-Point Surface Normal 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Normal from point winding; optional orientation relative to reference. Tolerance applies to edge lengths and sine of included angle. Degenerate normal is zero; area retained for near-collinear nonzero edges. Coordinates bounded to \u00b11e8.",
  "uses": "Three-Point Surface Normal 3D",
  "notes": "Normal from point winding; optional orientation relative to reference. Tolerance applies to edge lengths and sine of included angle. Degenerate normal is zero; area retained for near-collinear nonzero edges. Coordinates bounded to \u00b11e8.",
  "header_color": "#876B91",
  "terminal": false,
  "inputs": [
    {
      "id": "a",
      "name": "Point A",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(0.0)"
    },
    {
      "id": "b",
      "name": "Point B",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(1.0,0.0,0.0)"
    },
    {
      "id": "c",
      "name": "Point C",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(0.0,1.0,0.0)"
    },
    {
      "id": "reference",
      "name": "Reference Direction",
      "type": "vec3",
      "semantic_role": "direction3d",
      "default": "vec3(0.0,0.0,1.0)"
    }
  ],
  "outputs": [
    {
      "id": "normal",
      "name": "Surface Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    },
    {
      "id": "center",
      "name": "Triangle Center",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "area",
      "name": "Triangle Area",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "valid",
      "name": "Validity Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "parameters": [
    {
      "id": "orientation",
      "name": "Orientation Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Point Winding",
        "Reverse Winding",
        "Toward Reference",
        "Away From Reference"
      ]
    },
    {
      "id": "tolerance",
      "name": "Numerical Tolerance",
      "type": "float",
      "default": 1e-06,
      "min": 1e-08,
      "max": 0.001
    }
  ],
  "helpers": "struct MakerTPN {vec3 n;vec3 center;float area;float valid;};\nMakerTPN maker_tpn(vec3 a,vec3 b,vec3 c,vec3 refdir,float mode,float eps){\n if(any(isnan(a))||any(isinf(a))||any(isnan(b))||any(isinf(b))||any(isnan(c))||any(isinf(c)))return MakerTPN(vec3(0.0),vec3(0.0),0.0,0.0);\n a=clamp(a,vec3(-1e8),vec3(1e8));b=clamp(b,vec3(-1e8),vec3(1e8));c=clamp(c,vec3(-1e8),vec3(1e8));\n vec3 u=b-a,v=c-a,center=(a+b+c)/3.0;float lu=length(u),lv=length(v);\n if(lu<=eps||lv<=eps)return MakerTPN(vec3(0.0),center,0.0,0.0);\n vec3 crossv=cross(u/lu,v/lv);float l=length(crossv),area=0.5*lu*lv*l;\n if(l<=eps)return MakerTPN(vec3(0.0),center,area,0.0);\n vec3 n=crossv/l;if(mode>0.5&&mode<1.5)n=-n;\n if(mode>=1.5&&!any(isnan(refdir))&&!any(isinf(refdir))){float align=dot(n,clamp(refdir,vec3(-1e8),vec3(1e8)));if((mode<2.5&&align<0.0)||(mode>=2.5&&align>0.0))n=-n;}\n return MakerTPN(n,center,area,1.0);\n}",
  "glsl_outputs": {
    "normal": "maker_tpn({a},{b},{c},{reference},{orientation},{tolerance}).n",
    "center": "maker_tpn({a},{b},{c},{reference},{orientation},{tolerance}).center",
    "area": "maker_tpn({a},{b},{c},{reference},{orientation},{tolerance}).area",
    "valid": "maker_tpn({a},{b},{c},{reference},{orientation},{tolerance}).valid"
  }
}
