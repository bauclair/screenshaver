{
  "schema_version": 1,
  "id": "screenshaver.geometry.indexed_spatial_ring_field_3d",
  "name": "Indexed Spatial Ring Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Bounded ring union; not exact signed distance inside overlaps.",
  "uses": "Indexed Spatial Ring Field 3D",
  "notes": "Bounded ring union; not exact signed distance inside overlaps.",
  "header_color": "#348F8B",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0"
    },
    {
      "id": "radius_multiplier",
      "name": "Radius Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "ring_distance_field",
      "name": "Ring Distance Field",
      "type": "float"
    },
    {
      "id": "nearest_centerline_distance",
      "name": "Nearest Centerline Distance",
      "type": "float"
    },
    {
      "id": "nearest_ring_identifier",
      "name": "Nearest Ring Identifier",
      "type": "float"
    },
    {
      "id": "nearest_ring_center",
      "name": "Nearest Ring Center",
      "type": "vec3"
    },
    {
      "id": "nearest_ring_normal",
      "name": "Nearest Ring Normal",
      "type": "vec3"
    },
    {
      "id": "nearest_ring_radius",
      "name": "Nearest Ring Radius",
      "type": "float"
    },
    {
      "id": "proximity_response",
      "name": "Proximity Response",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "ring_count",
      "name": "Ring Count",
      "type": "float",
      "default": 12,
      "min": 1,
      "max": 32
    },
    {
      "id": "initial_radius",
      "name": "Initial Radius",
      "type": "float",
      "default": 0.1,
      "min": 0.01,
      "max": 5
    },
    {
      "id": "radius_increment",
      "name": "Radius Increment",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 2
    },
    {
      "id": "ring_thickness",
      "name": "Ring Thickness",
      "type": "float",
      "default": 0.02,
      "min": 0.001,
      "max": 1
    },
    {
      "id": "center_displacement",
      "name": "Center Displacement",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 5
    },
    {
      "id": "orientation_increment",
      "name": "Orientation Increment",
      "type": "float",
      "default": 30,
      "min": -180,
      "max": 180
    },
    {
      "id": "orientation_animation_speed",
      "name": "Orientation Animation Speed",
      "type": "float",
      "default": 0.5,
      "min": -5,
      "max": 5
    },
    {
      "id": "center_animation_speed",
      "name": "Center Animation Speed",
      "type": "float",
      "default": 0.5,
      "min": -5,
      "max": 5
    },
    {
      "id": "radius_oscillation",
      "name": "Radius Oscillation",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "id": "radius_animation_speed",
      "name": "Radius Animation Speed",
      "type": "float",
      "default": 0.5,
      "min": -5,
      "max": 5
    },
    {
      "id": "proximity_width",
      "name": "Proximity Width",
      "type": "float",
      "default": 0.05,
      "min": 0.001,
      "max": 2
    },
    {
      "id": "distribution_mode",
      "name": "Distribution Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Progressive",
        "Harmonic",
        "Randomized"
      ]
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1000
    }
  ],
  "helpers": "struct MakerB362IndexedSpatialRingField3D {float ring_distance_field;float nearest_centerline_distance;float nearest_ring_identifier;vec3 nearest_ring_center;vec3 nearest_ring_normal;float nearest_ring_radius;float proximity_response;};\nMakerB362IndexedSpatialRingField3D maker_b362_indexed_spatial_ring_field_3d(vec3 position,vec3 center,float time_offset,float radius_multiplier,float ring_count,float initial_radius,float radius_increment,float ring_thickness,float center_displacement,float orientation_increment,float orientation_animation_speed,float center_animation_speed,float radius_oscillation,float radius_animation_speed,float proximity_width,float distribution_mode,float seed,float tm){\nfloat t=tm+time_offset,best=1e20,idx=0.,br=0.;vec3 bc=center,bn=vec3(0.,1.,0.);int n=int(clamp(round(ring_count),1.,32.));for(int j=0;j<32;j++){if(j>=n)break;float f=float(j),h=fract(sin((f+seed)*71.39+1.)*4371.23),a=radians(orientation_increment)*f+t*orientation_animation_speed,b=distribution_mode<.5?a*.618:(distribution_mode<1.5?sin(a)*3.14159:6.2831853*h+t*orientation_animation_speed);vec3 normal=vec3(cos(a)*sin(b),cos(b),sin(a)*sin(b));vec3 c=center+center_displacement*sin(vec3(f*1.7,f*2.3,f*.9)+t*center_animation_speed+seed);float r=max(.0001,(initial_radius+f*radius_increment)*(1.+radius_oscillation*sin(t*radius_animation_speed+f))*abs(radius_multiplier));vec3 q=position-c;float z=dot(q,normal),d=length(vec2(length(q-z*normal)-r,z));if(d<best){best=d;idx=f;bc=c;bn=normal;br=r;}}return MakerB362IndexedSpatialRingField3D(best-ring_thickness,best,idx,bc,bn,br,exp(-best/proximity_width));\n}",
  "glsl_outputs": {
    "ring_distance_field": "maker_b362_indexed_spatial_ring_field_3d({position},{center},{time_offset},{radius_multiplier},{ring_count},{initial_radius},{radius_increment},{ring_thickness},{center_displacement},{orientation_increment},{orientation_animation_speed},{center_animation_speed},{radius_oscillation},{radius_animation_speed},{proximity_width},{distribution_mode},{seed},u_time).ring_distance_field",
    "nearest_centerline_distance": "maker_b362_indexed_spatial_ring_field_3d({position},{center},{time_offset},{radius_multiplier},{ring_count},{initial_radius},{radius_increment},{ring_thickness},{center_displacement},{orientation_increment},{orientation_animation_speed},{center_animation_speed},{radius_oscillation},{radius_animation_speed},{proximity_width},{distribution_mode},{seed},u_time).nearest_centerline_distance",
    "nearest_ring_identifier": "maker_b362_indexed_spatial_ring_field_3d({position},{center},{time_offset},{radius_multiplier},{ring_count},{initial_radius},{radius_increment},{ring_thickness},{center_displacement},{orientation_increment},{orientation_animation_speed},{center_animation_speed},{radius_oscillation},{radius_animation_speed},{proximity_width},{distribution_mode},{seed},u_time).nearest_ring_identifier",
    "nearest_ring_center": "maker_b362_indexed_spatial_ring_field_3d({position},{center},{time_offset},{radius_multiplier},{ring_count},{initial_radius},{radius_increment},{ring_thickness},{center_displacement},{orientation_increment},{orientation_animation_speed},{center_animation_speed},{radius_oscillation},{radius_animation_speed},{proximity_width},{distribution_mode},{seed},u_time).nearest_ring_center",
    "nearest_ring_normal": "maker_b362_indexed_spatial_ring_field_3d({position},{center},{time_offset},{radius_multiplier},{ring_count},{initial_radius},{radius_increment},{ring_thickness},{center_displacement},{orientation_increment},{orientation_animation_speed},{center_animation_speed},{radius_oscillation},{radius_animation_speed},{proximity_width},{distribution_mode},{seed},u_time).nearest_ring_normal",
    "nearest_ring_radius": "maker_b362_indexed_spatial_ring_field_3d({position},{center},{time_offset},{radius_multiplier},{ring_count},{initial_radius},{radius_increment},{ring_thickness},{center_displacement},{orientation_increment},{orientation_animation_speed},{center_animation_speed},{radius_oscillation},{radius_animation_speed},{proximity_width},{distribution_mode},{seed},u_time).nearest_ring_radius",
    "proximity_response": "maker_b362_indexed_spatial_ring_field_3d({position},{center},{time_offset},{radius_multiplier},{ring_count},{initial_radius},{radius_increment},{ring_thickness},{center_displacement},{orientation_increment},{orientation_animation_speed},{center_animation_speed},{radius_oscillation},{radius_animation_speed},{proximity_width},{distribution_mode},{seed},u_time).proximity_response"
  }
}
