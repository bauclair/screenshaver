{
  "schema_version": 1,
  "id": "screenshaver.geometry.three_point_oriented_plane_field_3d",
  "name": "Three-Point Oriented Plane Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Oriented plane from three points.",
  "uses": "Oriented plane from three points.",
  "notes": "Invalid geometry returns zero distance, zero normal, original bounded position and zero validity. Offset moves plane along its normal.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "a",
      "name": "Point A",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "b",
      "name": "Point B",
      "type": "vec3",
      "default": "vec3(1,0,0)"
    },
    {
      "id": "c",
      "name": "Point C",
      "type": "vec3",
      "default": "vec3(0,0,1)"
    },
    {
      "id": "reference",
      "name": "Interior Reference",
      "type": "vec3",
      "default": "vec3(0,-1,0)"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Signed Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "normal",
      "name": "Plane Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    },
    {
      "id": "projected",
      "name": "Projected Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "inside",
      "name": "Interior Mask",
      "type": "float"
    },
    {
      "id": "valid",
      "name": "Validity",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "offset",
      "name": "Plane Offset",
      "type": "float",
      "default": 0,
      "min": -100,
      "max": 100
    },
    {
      "id": "orientation",
      "name": "Normal Orientation",
      "type": "choice",
      "default": 1,
      "min": 0,
      "max": 2,
      "options": [
        "Vertex Order",
        "Toward Exterior",
        "Reversed"
      ]
    },
    {
      "id": "tolerance",
      "name": "Degeneracy Tolerance",
      "type": "float",
      "default": 1e-05,
      "min": 1e-06,
      "max": 0.01
    }
  ],
  "helpers": "struct MakerTOP {float distance;vec3 normal;vec3 projected;float inside;float valid;};\nMakerTOP maker_top(vec3 p,vec3 a,vec3 b,vec3 c,vec3 refp,float offset,float mode,float tol){\n if(any(isnan(p))||any(isinf(p))||any(isnan(a))||any(isinf(a))||any(isnan(b))||any(isinf(b))||any(isnan(c))||any(isinf(c))||any(isnan(refp))||any(isinf(refp)))return MakerTOP(0.,vec3(0),vec3(0),0.,0.);\n p=clamp(p,-1e6,1e6);a=clamp(a,-1e6,1e6);b=clamp(b,-1e6,1e6);c=clamp(c,-1e6,1e6);refp=clamp(refp,-1e6,1e6);vec3 n=cross(b-a,c-a);float l=length(n);if(l<=tol)return MakerTOP(0.,vec3(0),p,0.,0.);n/=l;if(mode>1.5||(mode>.5&&dot(refp-a,n)>0.))n=-n;float d=dot(p-a,n)-offset;return MakerTOP(d,n,p-d*n,d<=0.?1.:0.,1.);\n}",
  "glsl_outputs": {
    "distance": "maker_top({position},{a},{b},{c},{reference},{offset},{orientation},{tolerance}).distance",
    "normal": "maker_top({position},{a},{b},{c},{reference},{offset},{orientation},{tolerance}).normal",
    "projected": "maker_top({position},{a},{b},{c},{reference},{offset},{orientation},{tolerance}).projected",
    "inside": "maker_top({position},{a},{b},{c},{reference},{offset},{orientation},{tolerance}).inside",
    "valid": "maker_top({position},{a},{b},{c},{reference},{offset},{orientation},{tolerance}).valid"
  }
}
