    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.001,
      "max": 100.0
    },
    {
      "id": "spoke_count",
      "name": "Spoke Count",
      "type": "float",
      "default": 6.0,
      "min": 2.0,
      "max": 12.0
    },
    {
      "id": "branch_count",
      "name": "Branch Count",
      "type": "float",
      "default": 3.0,
      "min": 0.0,
      "max": 6.0
    },
    {
      "id": "spoke_width",
      "name": "Spoke Width",
      "type": "float",
      "default": 0.015,
      "min": 0.001,
      "max": 1.0
    },
    {
      "id": "branch_width",
      "name": "Branch Width",
      "type": "float",
      "default": 0.01,
      "min": 0.001,
      "max": 1.0
    },
    {
      "id": "branch_length",
