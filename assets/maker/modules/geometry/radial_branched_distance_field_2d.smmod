      "name": "Spoke Distance",
      "type": "float"
    },
    {
      "id": "branch_distance",
      "name": "Branch Distance",
      "type": "float"
    },
    {
      "id": "interior_mask",
      "name": "Interior Mask",
      "type": "float"
    },
    {
      "id": "soft_mask",
      "name": "Soft Mask",
