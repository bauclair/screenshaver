{
  "schema_version": 1,
  "id": "screenshaver.geometry.spherical_loxodrome_field_3d",
  "name": "Spherical Loxodrome Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Constant-bearing spherical spiral phase from longitude and Mercator latitude. Distance is a local angular approximation, not an exact spatial SDF; polar caps are excluded.",
  "uses": "Decorative geometric fields and reusable composition.",
  "notes": "Constant-bearing spherical spiral phase from longitude and Mercator latitude. Distance is a local angular approximation, not an exact spatial SDF; polar caps are excluded.",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv-vec2(0.5),0.0)"
    }
  ],
  "parameters": [
    {
      "id": "bearing",
      "name": "Bearing",
      "type": "float",
      "default": 0.65,
      "min": -1.45,
      "max": 1.45
    },
    {
      "id": "strands",
      "name": "Strands",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 12
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 0,
      "min": -6.283,
      "max": 6.283
    },
    {
      "id": "width",
      "name": "Width",
      "type": "float",
      "default": 0.06,
      "min": 0.001,
      "max": 0.4
    },
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 10
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "mask",
      "name": "Mask",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "phase_field",
      "name": "Phase Field",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "latitude",
      "name": "Latitude",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "validity",
      "name": "Validity",
      "type": "float",
      "semantic_role": ""
    }
  ],
  "helpers": "struct MakerP_spherical_loxodrome_field_3d {float distance;float mask;float phase_field;float latitude;float validity;};\nMakerP_spherical_loxodrome_field_3d maker_p_spherical_loxodrome_field_3d(vec3 position,float bearing,float strands,float phase,float width,float radius){\nfloat r=length(position);vec3 p=position/max(r,0.000001);float lat=asin(clamp(p.y,-1.0,1.0));float valid=step(0.00001,r)*step(abs(lat),1.54);float l=clamp(lat,-1.54,1.54);float lon=atan(p.z,p.x+0.00000001);float merc=log(tan(0.78539816339+0.5*l));float k=tan(bearing),n=clamp(floor(strands+0.5),1.0,12.0);float a=n*(lon-k*merc)+phase;float f=abs(fract(a/6.28318530718+0.5)-0.5)*6.28318530718;float d=radius*f*cos(l)/(n*sqrt(1.0+k*k));float dist=length(vec2(d,r-radius));return MakerP_spherical_loxodrome_field_3d(dist,valid*(1.0-smoothstep(width,width+0.01,dist)),0.5+0.5*cos(a),lat,valid);\n}",
  "glsl_outputs": {
    "distance": "maker_p_spherical_loxodrome_field_3d({position},{bearing},{strands},{phase},{width},{radius}).distance",
    "mask": "maker_p_spherical_loxodrome_field_3d({position},{bearing},{strands},{phase},{width},{radius}).mask",
    "phase_field": "maker_p_spherical_loxodrome_field_3d({position},{bearing},{strands},{phase},{width},{radius}).phase_field",
    "latitude": "maker_p_spherical_loxodrome_field_3d({position},{bearing},{strands},{phase},{width},{radius}).latitude",
    "validity": "maker_p_spherical_loxodrome_field_3d({position},{bearing},{strands},{phase},{width},{radius}).validity"
  }
}
