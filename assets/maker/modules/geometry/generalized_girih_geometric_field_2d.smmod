{
  "schema_version": 1,
  "id": "screenshaver.geometry.generalized_girih_geometric_field_2d",
  "name": "Generalized Girih Geometric Field 2D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Girih-inspired periodic star strapwork: intersecting rotated families of parallel lines, not an authentic five-tile Girih tessellation. Distance is to the nearest strap centerline.",
  "uses": "Decorative geometric fields and reusable composition.",
  "notes": "Girih-inspired periodic star strapwork: intersecting rotated families of parallel lines, not an authentic five-tile Girih tessellation. Distance is to the nearest strap centerline.",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv-vec2(0.5)"
    }
  ],
  "parameters": [
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 5,
      "min": 0.1,
      "max": 30
    },
    {
      "id": "families",
      "name": "Families",
      "type": "float",
      "default": 5,
      "min": 2,
      "max": 10
    },
    {
      "id": "angle",
      "name": "Angle",
      "type": "float",
      "default": 0,
      "min": -6.283,
      "max": 6.283
    },
    {
      "id": "offset",
      "name": "Offset",
      "type": "float",
      "default": 0,
      "min": -0.5,
      "max": 0.5
    },
    {
      "id": "width",
      "name": "Width",
      "type": "float",
      "default": 0.055,
      "min": 0.001,
      "max": 0.2
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "mask",
      "name": "Mask",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "crossing",
      "name": "Crossing",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "family",
      "name": "Family",
      "type": "float",
      "semantic_role": ""
    }
  ],
  "helpers": "struct MakerP_generalized_girih_geometric_field_2d {float distance;float mask;float crossing;float family;};\nMakerP_generalized_girih_geometric_field_2d maker_p_generalized_girih_geometric_field_2d(vec2 position,float frequency,float families,float angle,float offset,float width){\nvec2 p=position*frequency; float d=1.0, second=1.0, idx=0.0; int n=int(clamp(floor(families+0.5),2.0,10.0));\nfor(int i=0;i<10;i++){if(i>=n)break;float a=angle+3.14159265359*float(i)/float(n);float v=abs(fract(dot(p,vec2(cos(a),sin(a)))+offset+0.5)-0.5);if(v<d){second=d;d=v;idx=float(i);}else{second=min(second,v);}}\nfloat w=max(width,0.001);return MakerP_generalized_girih_geometric_field_2d(d/max(frequency,0.001),1.0-smoothstep(w,w+0.01,d),1.0-smoothstep(w,w+0.01,second),idx);\n}",
  "glsl_outputs": {
    "distance": "maker_p_generalized_girih_geometric_field_2d({position},{frequency},{families},{angle},{offset},{width}).distance",
    "mask": "maker_p_generalized_girih_geometric_field_2d({position},{frequency},{families},{angle},{offset},{width}).mask",
    "crossing": "maker_p_generalized_girih_geometric_field_2d({position},{frequency},{families},{angle},{offset},{width}).crossing",
    "family": "maker_p_generalized_girih_geometric_field_2d({position},{frequency},{families},{angle},{offset},{width}).family"
  }
}
