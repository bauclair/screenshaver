{
  "schema_version": 1,
  "id": "screenshaver.geometry.superformula_field_2d",
  "name": "Superformula Field 2D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#557C9C",
  "description": "Superformula Field 2D",
  "uses": "Procedural geometry and contour composition.",
  "notes": "Gielis superformula, independently implemented from the published mathematical equation. Radial residual is not Euclidean distance or a sphere-tracing bound. Radius factor clamped to [0.001,1000]. Nonclosing symmetry/exponent combinations may have an angular seam.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "position2d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec2",
      "default": "vec2(0.5)",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "symmetry",
      "name": "Symmetry",
      "type": "float",
      "default": 4,
      "min": 0,
      "max": 32
    },
    {
      "id": "a",
      "name": "A",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 4
    },
    {
      "id": "b",
      "name": "B",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 4
    },
    {
      "id": "n1",
      "name": "N1",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "n2",
      "name": "N2",
      "type": "float",
      "default": 2,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "n3",
      "name": "N3",
      "type": "float",
      "default": 2,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 0.3,
      "min": 0.001,
      "max": 10
    },
    {
      "id": "orientation",
      "name": "Orientation",
      "type": "float",
      "default": 0,
      "min": -6.283185,
      "max": 6.283185
    },
    {
      "id": "contour_width",
      "name": "Contour Width",
      "type": "float",
      "default": 0.01,
      "min": 1e-05,
      "max": 1
    }
  ],
  "outputs": [
    {
      "id": "radial_residual",
      "name": "Radial Residual",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "target_radius",
      "name": "Target Radius",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "interior_mask",
      "name": "Interior Mask",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "angle",
      "name": "Angle",
      "type": "float",
      "semantic_role": "angle"
    },
    {
      "id": "contour",
      "name": "Contour",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "float maker_sf412a(float t,float m,float a,float b,float n1,float n2,float n3){float v=m*t*.25;float s=pow(abs(cos(v))/a,n2)+pow(abs(sin(v))/b,n3);return exp(clamp(-log(max(s,1e-12))/n1,-6.907755,6.907755));}\nstruct MakerShape0 {float radial_residual; float target_radius; float interior_mask; float angle; float contour;};\nMakerShape0 maker_superformula_field_2d(vec2 position,vec2 center,float symmetry,float a,float b,float n1,float n2,float n3,float radius,float orientation,float contour_width){\nvec2 q=clamp(position-center,vec2(-1e6),vec2(1e6));float r=length(q),t=r>1e-8?atan(q.y,q.x)-orientation:0.;t=mod(t+3.14159265,6.2831853)-3.14159265;float target=radius*maker_sf412a(t,symmetry,a,b,n1,n2,n3),d=r-target;return MakerShape0(d,target,step(d,0.),t,1.-smoothstep(0.,contour_width,abs(d)));\n}",
  "glsl_outputs": {
    "radial_residual": "maker_superformula_field_2d({position},{center},{symmetry},{a},{b},{n1},{n2},{n3},{radius},{orientation},{contour_width}).radial_residual",
    "target_radius": "maker_superformula_field_2d({position},{center},{symmetry},{a},{b},{n1},{n2},{n3},{radius},{orientation},{contour_width}).target_radius",
    "interior_mask": "maker_superformula_field_2d({position},{center},{symmetry},{a},{b},{n1},{n2},{n3},{radius},{orientation},{contour_width}).interior_mask",
    "angle": "maker_superformula_field_2d({position},{center},{symmetry},{a},{b},{n1},{n2},{n3},{radius},{orientation},{contour_width}).angle",
    "contour": "maker_superformula_field_2d({position},{center},{symmetry},{a},{b},{n1},{n2},{n3},{radius},{orientation},{contour_width}).contour"
  }
}
