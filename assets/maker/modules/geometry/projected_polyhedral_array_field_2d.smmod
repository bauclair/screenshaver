{
  "schema_version": 1,
  "id": "screenshaver.geometry.projected_polyhedral_array_field_2d",
  "name": "Projected Polyhedral Array Field 2D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Projected wireframes without occlusion. Perspective distance is guarded per object; depth is interpolated along projected edge.",
  "uses": "Projected Polyhedral Array Field 2D",
  "notes": "Projected wireframes without occlusion. Perspective distance is guarded per object; depth is interpolated along projected edge. Alternative connectivity capped at four objects. Secondary selects next distinct pair distance; tetrahedron has none. Empty edge network returns sentinel distance 1e20.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec2",
      "default": "vec2(0.0)"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "edge_distance",
      "name": "Edge Distance",
      "type": "float"
    },
    {
      "id": "edge_mask",
      "name": "Edge Mask",
      "type": "float"
    },
    {
      "id": "vertex_distance",
      "name": "Vertex Distance",
      "type": "float"
    },
    {
      "id": "vertex_mask",
      "name": "Vertex Mask",
      "type": "float"
    },
    {
      "id": "object_index",
      "name": "Object Index",
      "type": "float"
    },
    {
      "id": "edge_index",
      "name": "Edge Index",
      "type": "float"
    },
    {
      "id": "projected_depth",
      "name": "Projected Depth",
      "type": "float"
    },
    {
      "id": "glow",
      "name": "Glow",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "solid",
      "name": "Solid",
      "type": "choice",
      "default": 1,
      "options": [
        "Tetrahedron",
        "Cube",
        "Octahedron",
        "Dodecahedron",
        "Icosahedron"
      ]
    },
    {
      "id": "object_count",
      "name": "Object Count",
      "type": "float",
      "default": 5,
      "min": 1,
      "max": 16
    },
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 0.7,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "scale_progression",
      "name": "Scale Progression",
      "type": "float",
      "default": 0.75,
      "min": 0.1,
      "max": 1.5
    },
    {
      "id": "rotation_x",
      "name": "Rotation X",
      "type": "float",
      "default": 20,
      "min": -360,
      "max": 360
    },
    {
      "id": "rotation_y",
      "name": "Rotation Y",
      "type": "float",
      "default": 20,
      "min": -360,
      "max": 360
    },
    {
      "id": "rotation_z",
      "name": "Rotation Z",
      "type": "float",
      "default": 20,
      "min": -360,
      "max": 360
    },
    {
      "id": "progression_x",
      "name": "Progression X",
      "type": "float",
      "default": 15,
      "min": -360,
      "max": 360
    },
    {
      "id": "progression_y",
      "name": "Progression Y",
      "type": "float",
      "default": 15,
      "min": -360,
      "max": 360
    },
    {
      "id": "progression_z",
      "name": "Progression Z",
      "type": "float",
      "default": 15,
      "min": -360,
      "max": 360
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
      "default": 0.2,
      "min": -10,
      "max": 10
    },
