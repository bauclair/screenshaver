      "id": "projection",
      "name": "Projection",
      "type": "choice",
      "default": 0,
      "options": [
        "Orthographic",
        "Perspective"
      ]
    },
    {
      "id": "projection_distance",
      "name": "Projection Distance",
      "type": "float",
      "default": 3,
      "min": 0.1,
      "max": 100
    },
    {
      "id": "line_width",
      "name": "Line Width",
      "type": "float",
      "default": 0.01,
      "min": 0.0001,
      "max": 2
    },
    {
      "id": "vertex_width",
      "name": "Vertex Width",
      "type": "float",
      "default": 0.02,
      "min": 0.0001,
      "max": 2
    },
    {
      "id": "softness",
      "name": "Softness",
      "type": "float",
      "default": 0.005,
      "min": 0,
      "max": 2
    },
