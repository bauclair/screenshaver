{
  "schema_version": 1,
  "id": "screenshaver.geometry.enneper_surface_mapping_3d",
  "name": "Enneper Surface Mapping 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Enneper Surface Mapping 3D",
  "uses": "Reusable mathematical geometry and field composition.",
  "notes": "Classical Enneper polynomial parametrization; bounded parameter domain. Finite-difference normal and area scale; not a distance field. Validity indicates nondegenerate local tangent frame.",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv-vec2(0.5)"
    }
  ],
  "parameters": [
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 0.5,
      "min": 0.01,
      "max": 5
    },
    {
      "id": "extent",
      "name": "Extent",
      "type": "float",
      "default": 2,
      "min": 0.1,
      "max": 4
    }
  ],
  "outputs": [
    {
      "id": "point",
      "name": "Point",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "normal",
      "name": "Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    },
    {
      "id": "area_scale",
      "name": "Area Scale",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "validity",
      "name": "Validity",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerLenneper_surface_mapping_3d {vec3 point;vec3 normal;float area_scale;float validity;};\nvec3 maker_l_enneper_surface_mapping_3d_point(vec2 p,float size,float extent){vec2 q=clamp(p*extent,vec2(-4),vec2(4));float u=q.x,v=q.y;return size*vec3(u-u*u*u/3.+u*v*v,v-v*v*v/3.+v*u*u,u*u-v*v);}\nMakerLenneper_surface_mapping_3d maker_l_enneper_surface_mapping_3d(vec2 position,float size,float extent){\n if(any(isnan(position))||any(isinf(position)))return MakerLenneper_surface_mapping_3d(vec3(0),vec3(0),0.,0.);\n vec2 p=clamp(position,vec2(-8),vec2(8));float h=.001;\n vec3 q=maker_l_enneper_surface_mapping_3d_point(p,size,extent);vec3 a=(maker_l_enneper_surface_mapping_3d_point(p+vec2(h,0),size,extent)-maker_l_enneper_surface_mapping_3d_point(p-vec2(h,0),size,extent))/(2.*h);vec3 b=(maker_l_enneper_surface_mapping_3d_point(p+vec2(0,h),size,extent)-maker_l_enneper_surface_mapping_3d_point(p-vec2(0,h),size,extent))/(2.*h);vec3 n=cross(a,b);float m=length(n);return MakerLenneper_surface_mapping_3d(q,m>1e-7?n/m:vec3(0),m,step(1e-7,m));\n}",
  "glsl_outputs": {
    "point": "maker_l_enneper_surface_mapping_3d({position},{size},{extent}).point",
    "normal": "maker_l_enneper_surface_mapping_3d({position},{size},{extent}).normal",
    "area_scale": "maker_l_enneper_surface_mapping_3d({position},{size},{extent}).area_scale",
    "validity": "maker_l_enneper_surface_mapping_3d({position},{size},{extent}).validity"
  }
}
