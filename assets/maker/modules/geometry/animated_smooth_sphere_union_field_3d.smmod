      "name": "Distribution Depth",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 10
    },
    {
      "id": "motion_amplitude",
      "name": "Motion Amplitude",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 5
    },
