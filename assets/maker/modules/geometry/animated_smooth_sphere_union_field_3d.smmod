      "type": "float",
      "default": 8,
      "min": 1,
      "max": 32
    },
    {
      "id": "minimum_radius",
      "name": "Minimum Radius",
      "type": "float",
      "default": 0.2,
      "min": 0.01,
      "max": 5
    },
    {
      "id": "maximum_radius",
      "name": "Maximum Radius",
      "type": "float",
