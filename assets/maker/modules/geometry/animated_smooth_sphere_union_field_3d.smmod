      "default": 0.2,
      "min": 0,
      "max": 2
    },
    {
      "id": "motion_pattern",
      "name": "Motion Pattern",
      "type": "choice",
      "default": 0,
      "options": [
        "Independent",
        "Orbital",
        "Oscillating"
      ]
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1000
