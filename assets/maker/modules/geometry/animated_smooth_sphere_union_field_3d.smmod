  "helpers": "struct MakerB354AnimatedSmoothSphereUnionField3D {float smooth_union_field;float nearest_sphere_distance;float nearest_sphere_identifier;vec3 nearest_sphere_center;float nearest_sphere_radius;float interior_mask;};\nMakerB354AnimatedSmoothSphereUnionField3D maker_b354_animated_smooth_sphere_union_field_3d(vec3 position,vec3 center,float time_offset,float radius_multiplier,float sphere_count,float minimum_radius,float maximum_radius,float distribution_width,float distribution_height,float distribution_depth,float motion_amplitude,float animation_speed,float speed_variation,float union_smoothing,float motion_pattern,float seed,float tm){\nint n=int(clamp(round(sphere_count),1.,32.));float field=1e20,nearv=1e20,idx=0.,br=0.;vec3 bc=center;for(int j=0;j<32;j++){if(j>=n)break;float f=float(j)+seed*37.1;vec3 h=fract(sin(vec3(f*19.17+1.,f*73.29+2.,f*41.73+3.))*19341.17);float a=6.2831853*h.x,t=(tm+time_offset)*animation_speed*(1.+speed_variation*(2.*h.z-1.));vec3 m=motion_pattern<.5?sin(vec3(t,1.3*t,.7*t)+6.2831853*h):(motion_pattern<1.5?vec3(cos(a+t),sin(a+t),0.):vec3(0.,sin(a+t),0.));vec3 c=center+(h-.5)*vec3(distribution_width,distribution_height,distribution_depth)+motion_amplitude*m;float r=max(.0001,mix(minimum_radius,maximum_radius,h.y)*abs(radius_multiplier)),d=length(position-c)-r;if(d<nearv){nearv=d;idx=float(j);bc=c;br=r;}float k=union_smoothing;if(j==0||k<1e-6)field=min(field,d);else{float h2=max(k-abs(field-d),0.)/k;field=min(field,d)-.25*k*h2*h2;}}return MakerB354AnimatedSmoothSphereUnionField3D(field,nearv,idx,bc,br,1.-step(0.,field));\n}",
  "glsl_outputs": {
    "smooth_union_field": "maker_b354_animated_smooth_sphere_union_field_3d({position},{center},{time_offset},{radius_multiplier},{sphere_count},{minimum_radius},{maximum_radius},{distribution_width},{distribution_height},{distribution_depth},{motion_amplitude},{animation_speed},{speed_variation},{union_smoothing},{motion_pattern},{seed},u_time).smooth_union_field",
    "nearest_sphere_distance": "maker_b354_animated_smooth_sphere_union_field_3d({position},{center},{time_offset},{radius_multiplier},{sphere_count},{minimum_radius},{maximum_radius},{distribution_width},{distribution_height},{distribution_depth},{motion_amplitude},{animation_speed},{speed_variation},{union_smoothing},{motion_pattern},{seed},u_time).nearest_sphere_distance",
    "nearest_sphere_identifier": "maker_b354_animated_smooth_sphere_union_field_3d({position},{center},{time_offset},{radius_multiplier},{sphere_count},{minimum_radius},{maximum_radius},{distribution_width},{distribution_height},{distribution_depth},{motion_amplitude},{animation_speed},{speed_variation},{union_smoothing},{motion_pattern},{seed},u_time).nearest_sphere_identifier",
    "nearest_sphere_center": "maker_b354_animated_smooth_sphere_union_field_3d({position},{center},{time_offset},{radius_multiplier},{sphere_count},{minimum_radius},{maximum_radius},{distribution_width},{distribution_height},{distribution_depth},{motion_amplitude},{animation_speed},{speed_variation},{union_smoothing},{motion_pattern},{seed},u_time).nearest_sphere_center",
    "nearest_sphere_radius": "maker_b354_animated_smooth_sphere_union_field_3d({position},{center},{time_offset},{radius_multiplier},{sphere_count},{minimum_radius},{maximum_radius},{distribution_width},{distribution_height},{distribution_depth},{motion_amplitude},{animation_speed},{speed_variation},{union_smoothing},{motion_pattern},{seed},u_time).nearest_sphere_radius",
    "interior_mask": "maker_b354_animated_smooth_sphere_union_field_3d({position},{center},{time_offset},{radius_multiplier},{sphere_count},{minimum_radius},{maximum_radius},{distribution_width},{distribution_height},{distribution_depth},{motion_amplitude},{animation_speed},{speed_variation},{union_smoothing},{motion_pattern},{seed},u_time).interior_mask"
  }
}
