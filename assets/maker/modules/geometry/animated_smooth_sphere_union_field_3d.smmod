      "min": 0.01,
      "max": 5
    },
    {
      "id": "distribution_width",
      "name": "Distribution Width",
      "type": "float",
      "default": 1.5,
      "min": 0,
      "max": 10
    },
    {
      "id": "distribution_height",
      "name": "Distribution Height",
      "type": "float",
      "default": 1.5,
      "min": 0,
      "max": 10
    },
    {
