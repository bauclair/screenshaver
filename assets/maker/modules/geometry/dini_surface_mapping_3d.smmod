{
  "schema_version": 1,
  "id": "screenshaver.geometry.dini_surface_mapping_3d",
  "name": "Dini Surface Mapping 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Dini Surface Mapping 3D",
  "uses": "Reusable mathematical geometry and field composition.",
  "notes": "Dini parametrization with singular endpoints excluded; pitch zero gives a pseudosphere. Finite-difference normal and area scale; not a distance field. Validity indicates nondegenerate local tangent frame.",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv-vec2(0.5)"
    }
  ],
  "parameters": [
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 0.5,
      "min": 0.01,
      "max": 5
    },
    {
      "id": "turns",
      "name": "Turns",
      "type": "float",
      "default": 2,
      "min": 0.25,
      "max": 4
    },
    {
      "id": "pitch",
      "name": "Pitch",
      "type": "float",
      "default": 0.18,
      "min": -1,
      "max": 1
    }
  ],
  "outputs": [
    {
      "id": "point",
      "name": "Point",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "normal",
      "name": "Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    },
    {
      "id": "area_scale",
      "name": "Area Scale",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "validity",
      "name": "Validity",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerLdini_surface_mapping_3d {vec3 point;vec3 normal;float area_scale;float validity;};\nvec3 maker_l_dini_surface_mapping_3d_point(vec2 p,float size,float turns,float pitch){float u=p.x*6.2831853*turns;float v=clamp(.8+p.y*1.4,.05,1.55);return size*vec3(cos(u)*sin(v),sin(u)*sin(v),cos(v)+log(tan(v*.5))+pitch*u);}\nMakerLdini_surface_mapping_3d maker_l_dini_surface_mapping_3d(vec2 position,float size,float turns,float pitch){\n if(any(isnan(position))||any(isinf(position)))return MakerLdini_surface_mapping_3d(vec3(0),vec3(0),0.,0.);\n vec2 p=clamp(position,vec2(-8),vec2(8));float h=.001;\n vec3 q=maker_l_dini_surface_mapping_3d_point(p,size,turns,pitch);vec3 a=(maker_l_dini_surface_mapping_3d_point(p+vec2(h,0),size,turns,pitch)-maker_l_dini_surface_mapping_3d_point(p-vec2(h,0),size,turns,pitch))/(2.*h);vec3 b=(maker_l_dini_surface_mapping_3d_point(p+vec2(0,h),size,turns,pitch)-maker_l_dini_surface_mapping_3d_point(p-vec2(0,h),size,turns,pitch))/(2.*h);vec3 n=cross(a,b);float m=length(n);return MakerLdini_surface_mapping_3d(q,m>1e-7?n/m:vec3(0),m,step(1e-7,m));\n}",
  "glsl_outputs": {
    "point": "maker_l_dini_surface_mapping_3d({position},{size},{turns},{pitch}).point",
    "normal": "maker_l_dini_surface_mapping_3d({position},{size},{turns},{pitch}).normal",
    "area_scale": "maker_l_dini_surface_mapping_3d({position},{size},{turns},{pitch}).area_scale",
    "validity": "maker_l_dini_surface_mapping_3d({position},{size},{turns},{pitch}).validity"
  }
}
