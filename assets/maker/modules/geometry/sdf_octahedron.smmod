{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.geometry.sdf_octahedron",
  "name": "SDF Octahedron",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Approximate signed distance to an axis-aligned regular octahedron.",
  "uses": "Reusable signed-distance geometry and procedural field composition.",
  "notes": "Uses the L1 implicit surface |x|+|y|+|z|=size and its normalized plane distance. Conservative raymarch stepping may be needed near vertices.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(0.0)"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 1.8,
      "min": 0.05,
      "max": 8.0
    }
  ],
  "helpers": "float maker_octahedron_plane_distance(vec3 p,float size){\n  vec3 a=abs(p);\n  return (a.x+a.y+a.z-max(size,0.0001))*0.5773502691896258;\n}",
  "glsl": "maker_octahedron_plane_distance({position},{size})"
}
