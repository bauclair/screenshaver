{
  "schema_version": 1,
  "id": "screenshaver.geometry.finite_capped_cylinder_distance_field_3d",
  "name": "Finite Capped Cylinder Distance Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Oriented finite solid distance field.",
  "uses": "Oriented finite solid distance field.",
  "notes": "Center is the axial midpoint. Zero axis falls back to +Y. Dimensions are bounded.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "axis",
      "name": "Axis",
      "type": "vec3",
      "default": "vec3(0.0,1.0,0.0)"
    },
    {
      "id": "radius_multiplier",
      "name": "Radius Multiplier",
      "type": "float",
      "default": "1.0"
    },
    {
      "id": "height_multiplier",
      "name": "Height Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Signed Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "radial",
      "name": "Radial Distance",
      "type": "float"
    },
    {
      "id": "axial",
      "name": "Axial Position",
      "type": "float"
    },
    {
      "id": "inside",
      "name": "Interior Mask",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "height",
      "name": "Height",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 100
    }
  ],
  "helpers": "struct MakerFCY {float distance;float radial;float axial;float inside;};\nMakerFCY maker_fcy(vec3 p,vec3 c,vec3 axis,float rm,float hm,float radius,float height){\n if(any(isnan(p))||any(isinf(p))||any(isnan(c))||any(isinf(c))||any(isnan(axis))||any(isinf(axis))||isnan(rm)||isinf(rm)||isnan(hm)||isinf(hm))return MakerFCY(0.,0.,0.,0.);\n vec3 q=clamp(p,-1e6,1e6)-clamp(c,-1e6,1e6);axis=clamp(axis,-1e6,1e6);float al=length(axis);vec3 n=al>1e-8?axis/al:vec3(0,1,0);float z=dot(q,n),r=length(q-z*n),h=max(.001,height*clamp(hm,.0001,100.));\n float rad=max(.001,radius*clamp(rm,.0001,100.));vec2 e=vec2(r-rad,abs(z)-h*.5);float d=length(max(e,0.))+min(max(e.x,e.y),0.);bool inside=d<=0.;\nreturn MakerFCY(d,r,z,inside?1.:0.);\n}",
  "glsl_outputs": {
    "distance": "maker_fcy({position},{center},{axis},{radius_multiplier},{height_multiplier},{radius},{height}).distance",
    "radial": "maker_fcy({position},{center},{axis},{radius_multiplier},{height_multiplier},{radius},{height}).radial",
    "axial": "maker_fcy({position},{center},{axis},{radius_multiplier},{height_multiplier},{radius},{height}).axial",
    "inside": "maker_fcy({position},{center},{axis},{radius_multiplier},{height_multiplier},{radius},{height}).inside"
  }
}
