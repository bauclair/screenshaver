{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.geometry.warped_plane_field",
  "name": "Warped Plane Field",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Plane field displaced by independent sine waves and an optional scalar Cell Field input.",
  "uses": "Abstract terrain and raymarched surfaces.",
  "notes": "Uses ordinary periodic height displacement; Cell Field can add surface variation without texture sampling.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    },
    {
      "id": "cell",
      "name": "Cell Field",
      "type": "float",
      "default": "0.5"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "wave_strength",
      "name": "Wave Strength",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 4
    },
    {
      "id": "cell_strength",
      "name": "Cell Strength",
      "type": "float",
      "default": 1.5,
      "min": 0,
      "max": 5
    },
    {
      "id": "cell_center",
      "name": "Cell Center",
      "type": "float",
      "default": 0.5,
      "min": -2,
      "max": 2
    }
  ],
  "helpers": "",
  "glsl": "({position}.y - {wave_strength} * (0.6*sin(1.3*{position}.x + 0.4*u_time) + 0.4*cos(0.9*{position}.z - 0.25*u_time)) + ({cell_center}-{cell})*{cell_strength})"
}
