      "default": 24,
      "min": 1,
      "max": 128
    },
    {
      "id": "temporal_spacing",
      "name": "Temporal Spacing",
      "type": "float",
      "default": 0.035,
      "min": -2,
      "max": 2
    },
    {
      "id": "temporal_quantization",
      "name": "Temporal Quantization",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 2
    },
    {
      "id": "a_x_amplitude",
      "name": "A X Amplitude",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 10
    },
    {
      "id": "a_x_frequency",
      "name": "A X Frequency",
      "type": "float",
      "default": 3.1,
      "min": -20,
      "max": 20
    },
    {
      "id": "a_x_phase",
      "name": "A X Phase",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "a_y_amplitude",
      "name": "A Y Amplitude",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 10
    },
    {
      "id": "a_y_frequency",
      "name": "A Y Frequency",
      "type": "float",
      "default": 4.3,
      "min": -20,
      "max": 20
    },
    {
      "id": "a_y_phase",
      "name": "A Y Phase",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    },
    {
      "id": "b_x_amplitude",
      "name": "B X Amplitude",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 10
    },
    {
      "id": "b_x_frequency",
      "name": "B X Frequency",
      "type": "float",
      "default": 4.7,
      "min": -20,
      "max": 20
    },
    {
      "id": "b_x_phase",
      "name": "B X Phase",
      "type": "float",
      "default": 90,
      "min": -360,
      "max": 360
    },
    {
      "id": "b_y_amplitude",
      "name": "B Y Amplitude",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 10
    },
    {
      "id": "b_y_frequency",
      "name": "B Y Frequency",
      "type": "float",
      "default": 2.3,
      "min": -20,
      "max": 20
    },
    {
      "id": "b_y_phase",
      "name": "B Y Phase",
      "type": "float",
      "default": 90,
      "min": -360,
      "max": 360
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "float",
