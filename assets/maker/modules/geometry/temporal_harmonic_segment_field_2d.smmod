{
  "schema_version": 1,
  "id": "screenshaver.geometry.temporal_harmonic_segment_field_2d",
  "name": "Temporal Harmonic Segment Field 2D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Stateless time-indexed segments; positive spacing samples past times. Maximum response is attenuation-weighted.",
  "uses": "Temporal Harmonic Segment Field 2D",
  "notes": "Stateless time-indexed segments; positive spacing samples past times. Maximum response is attenuation-weighted.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
