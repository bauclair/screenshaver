      "default": 0.005,
      "min": 0,
      "max": 1
    }
  ],
  "helpers": "struct MakerB396TemporalHarmonicSegmentField2D{float nearest_distance;float accumulated_response;float normalized_response;float nearest_index;float segment_fraction;vec2 closest_point;float maximum_response;};\nMakerB396TemporalHarmonicSegmentField2D maker_b396_temporal_harmonic_segment_field_2d(vec2 position,vec2 center,float time_offset,float segment_count,float temporal_spacing,float temporal_quantization,float a_x_amplitude,float a_x_frequency,float a_x_phase,float a_y_amplitude,float a_y_frequency,float a_y_phase,float b_x_amplitude,float b_x_frequency,float b_x_phase,float b_y_amplitude,float b_y_frequency,float b_y_phase,float speed,float attenuation,float length_multiplier,float line_width,float softness){int n=int(clamp(round(segment_count),1.,128.));float t=(u_time+time_offset)*speed;if(temporal_quantization>1e-6)t=floor(t/temporal_quantization)*temporal_quantization;float best=1e20,idx=0.,frac=0.,sum=0.,weights=0.,peak=0.,w=1.;vec2 cp=center;for(int i=0;i<128;i++){if(i>=n)break;float s=t-float(i)*temporal_spacing;vec2 a=center+vec2(a_x_amplitude*sin(s*a_x_frequency+radians(a_x_phase)),a_y_amplitude*sin(s*a_y_frequency+radians(a_y_phase))),b=center+vec2(b_x_amplitude*sin(s*b_x_frequency+radians(b_x_phase)),b_y_amplitude*sin(s*b_y_frequency+radians(b_y_phase)));vec2 mid=(a+b)*.5; a=mid+(a-mid)*length_multiplier;b=mid+(b-mid)*length_multiplier;vec2 v=b-a;float u=clamp(dot(position-a,v)/max(dot(v,v),1e-12),0.,1.);vec2 p=a+u*v;float d=length(position-p),m=1.-smoothstep(line_width,line_width+max(softness,1e-6),d);if(d<best){best=d;idx=float(i);frac=u;cp=p;}sum+=w*m;weights+=w;peak=max(peak,w*m);w*=attenuation;}return MakerB396TemporalHarmonicSegmentField2D(best,sum,sum/max(weights,1e-6),idx,frac,cp,peak);}",
  "glsl_outputs": {
    "nearest_distance": "maker_b396_temporal_harmonic_segment_field_2d({position},{center},{time_offset},{segment_count},{temporal_spacing},{temporal_quantization},{a_x_amplitude},{a_x_frequency},{a_x_phase},{a_y_amplitude},{a_y_frequency},{a_y_phase},{b_x_amplitude},{b_x_frequency},{b_x_phase},{b_y_amplitude},{b_y_frequency},{b_y_phase},{speed},{attenuation},{length_multiplier},{line_width},{softness}).nearest_distance",
    "accumulated_response": "maker_b396_temporal_harmonic_segment_field_2d({position},{center},{time_offset},{segment_count},{temporal_spacing},{temporal_quantization},{a_x_amplitude},{a_x_frequency},{a_x_phase},{a_y_amplitude},{a_y_frequency},{a_y_phase},{b_x_amplitude},{b_x_frequency},{b_x_phase},{b_y_amplitude},{b_y_frequency},{b_y_phase},{speed},{attenuation},{length_multiplier},{line_width},{softness}).accumulated_response",
    "normalized_response": "maker_b396_temporal_harmonic_segment_field_2d({position},{center},{time_offset},{segment_count},{temporal_spacing},{temporal_quantization},{a_x_amplitude},{a_x_frequency},{a_x_phase},{a_y_amplitude},{a_y_frequency},{a_y_phase},{b_x_amplitude},{b_x_frequency},{b_x_phase},{b_y_amplitude},{b_y_frequency},{b_y_phase},{speed},{attenuation},{length_multiplier},{line_width},{softness}).normalized_response",
    "nearest_index": "maker_b396_temporal_harmonic_segment_field_2d({position},{center},{time_offset},{segment_count},{temporal_spacing},{temporal_quantization},{a_x_amplitude},{a_x_frequency},{a_x_phase},{a_y_amplitude},{a_y_frequency},{a_y_phase},{b_x_amplitude},{b_x_frequency},{b_x_phase},{b_y_amplitude},{b_y_frequency},{b_y_phase},{speed},{attenuation},{length_multiplier},{line_width},{softness}).nearest_index",
    "segment_fraction": "maker_b396_temporal_harmonic_segment_field_2d({position},{center},{time_offset},{segment_count},{temporal_spacing},{temporal_quantization},{a_x_amplitude},{a_x_frequency},{a_x_phase},{a_y_amplitude},{a_y_frequency},{a_y_phase},{b_x_amplitude},{b_x_frequency},{b_x_phase},{b_y_amplitude},{b_y_frequency},{b_y_phase},{speed},{attenuation},{length_multiplier},{line_width},{softness}).segment_fraction",
    "closest_point": "maker_b396_temporal_harmonic_segment_field_2d({position},{center},{time_offset},{segment_count},{temporal_spacing},{temporal_quantization},{a_x_amplitude},{a_x_frequency},{a_x_phase},{a_y_amplitude},{a_y_frequency},{a_y_phase},{b_x_amplitude},{b_x_frequency},{b_x_phase},{b_y_amplitude},{b_y_frequency},{b_y_phase},{speed},{attenuation},{length_multiplier},{line_width},{softness}).closest_point",
    "maximum_response": "maker_b396_temporal_harmonic_segment_field_2d({position},{center},{time_offset},{segment_count},{temporal_spacing},{temporal_quantization},{a_x_amplitude},{a_x_frequency},{a_x_phase},{a_y_amplitude},{a_y_frequency},{a_y_phase},{b_x_amplitude},{b_x_frequency},{b_x_phase},{b_y_amplitude},{b_y_frequency},{b_y_phase},{speed},{attenuation},{length_multiplier},{line_width},{softness}).maximum_response"
  }
}
