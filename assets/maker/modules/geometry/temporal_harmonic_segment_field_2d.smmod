      "name": "Nearest Index",
      "type": "float"
    },
    {
      "id": "segment_fraction",
      "name": "Segment Fraction",
      "type": "float"
    },
    {
      "id": "closest_point",
      "name": "Closest Point",
      "type": "vec2"
    },
    {
      "id": "maximum_response",
      "name": "Maximum Response",
      "type": "float"
    }
  ],
  "parameters": [
