{
  "schema_version": 1,
  "id": "screenshaver.geometry.cyclic_spline_path_3d",
  "name": "Cyclic Spline Path 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Closed time-parameterized Hermite spline with optional linear interpolation.",
  "uses": "Closed time-parameterized Hermite spline with optional linear interpolation.",
  "notes": "Uniform segment time; cubic overshoot is intentional. Derivative is with respect to input time, not playback wall time. Linear derivatives can jump at knots.",
  "header_color": "#477D9A",
  "terminal": false,
  "inputs": [
    {
      "id": "time",
      "name": "Time",
      "type": "float",
      "default": "u_time",
      "semantic_role": "time"
    },
    {
      "id": "point_1",
      "name": "Control Point A",
      "type": "vec3",
      "default": "vec3(3.0,0.0,0.0)"
    },
    {
      "id": "point_2",
      "name": "Control Point B",
      "type": "vec3",
      "default": "vec3(1.5,0.0,2.59808)"
    },
    {
      "id": "point_3",
      "name": "Control Point C",
      "type": "vec3",
      "default": "vec3(-1.5,0.0,2.59808)"
    },
    {
      "id": "point_4",
      "name": "Control Point D",
      "type": "vec3",
      "default": "vec3(-3.0,0.0,0.0)"
    },
    {
      "id": "point_5",
      "name": "Control Point E",
      "type": "vec3",
      "default": "vec3(-1.5,0.0,-2.59808)"
    },
    {
      "id": "point_6",
      "name": "Control Point F",
      "type": "vec3",
      "default": "vec3(1.5,0.0,-2.59808)"
    }
  ],
  "outputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "tangent",
      "name": "Tangent Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    },
    {
      "id": "velocity",
      "name": "Velocity",
      "type": "vec3"
    },
    {
      "id": "look_ahead_position",
      "name": "Look-ahead Position",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "segment_index",
      "name": "Segment Index",
      "type": "float"
    },
    {
      "id": "segment_progress",
      "name": "Segment Progress",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "duration",
      "name": "Cycle Duration",
      "type": "float",
      "default": 30,
      "min": 0.1,
      "max": 300
    },
    {
      "id": "offset",
      "name": "Time Offset",
      "type": "float",
      "default": 0,
      "min": -300,
      "max": 300
    },
    {
      "id": "count",
      "name": "Control Point Count",
      "type": "float",
      "default": 6,
      "min": 4,
      "max": 6
    },
    {
      "id": "tension",
      "name": "Tension",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "id": "look_ahead",
      "name": "Look-ahead Time",
      "type": "float",
      "default": 0.5,
      "min": -10,
      "max": 10
    },
    {
      "id": "interpolation",
      "name": "Interpolation",
      "type": "choice",
      "default": 1,
      "options": [
        "Linear",
        "Cubic"
      ]
    }
  ],
  "helpers": "vec3 maker_cyclic_path(float t,float duration,float offset,float count,float tension,float mode,vec3 p0,vec3 p1,vec3 p2,vec3 p3,vec3 p4,vec3 p5,int outputMode){\n int n=int(clamp(floor(count+0.5),4.0,6.0)); float dur=max(duration,0.1); float x=mod(mod(t,dur)+offset,dur)/dur*float(n); int j=min(int(floor(x)),n-1); float u=clamp(x-float(j),0.0,1.0); vec3 points[6]=vec3[6](p0,p1,p2,p3,p4,p5);\n vec3 a=points[(j+n-1)%n],b=points[j],c=points[(j+1)%n],d=points[(j+2)%n]; vec3 m=(1.0-clamp(tension,0.0,1.0))*0.5*(c-a),k=(1.0-clamp(tension,0.0,1.0))*0.5*(d-b);\n vec3 v=mix(b,c,u),dv=c-b; if(mode>=0.5){v=(2.0*u*u*u-3.0*u*u+1.0)*b+(u*u*u-2.0*u*u+u)*m+(-2.0*u*u*u+3.0*u*u)*c+(u*u*u-u*u)*k; dv=(6.0*u*u-6.0*u)*b+(3.0*u*u-4.0*u+1.0)*m+(-6.0*u*u+6.0*u)*c+(3.0*u*u-2.0*u)*k;} dv*=float(n)/dur;\n return outputMode==1?dv:(outputMode==2?vec3(float(j)):(outputMode==3?vec3(u):v));\n}\nvec3 maker_cyclic_path_tangent(vec3 v){float l=length(v);return l>1e-8?v/l:vec3(0.0,0.0,1.0);}",
  "glsl_outputs": {
    "position": "maker_cyclic_path({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},0)",
    "tangent": "maker_cyclic_path_tangent(maker_cyclic_path({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},1))",
    "velocity": "maker_cyclic_path({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},1)",
    "look_ahead_position": "maker_cyclic_path(({time}+{look_ahead}),{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},0)",
    "segment_index": "maker_cyclic_path({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},2).x",
    "segment_progress": "maker_cyclic_path({time},{duration},{offset},{count},{tension},{interpolation},{point_1},{point_2},{point_3},{point_4},{point_5},{point_6},3).x"
  }
}
