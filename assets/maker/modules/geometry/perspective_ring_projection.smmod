{
  "schema_version": 1,
  "id": "screenshaver.geometry.perspective_ring_projection",
  "name": "Perspective Ring Projection",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#477D9A",
  "description": "Projects a circular ring in a plane parallel to the image plane using a pinhole camera model.",
  "uses": "Perspective tunnel layers, circular overlays and depth-scaled outlines.",
  "notes": "Camera-relative coordinates; ring center is a vec3 in camera space. Negative or near-zero depth produces visibility 0. The projected radius and center are finite for all inputs.",
  "inputs": [
    {
      "id": "center",
      "name": "Ring Center (Camera Space)",
      "type": "vec3",
      "default": "vec3(0.0,0.0,4.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "uv",
      "name": "Screen Position",
      "type": "vec2",
      "default": "maker_uv",
      "semantic_role": "uv"
    }
  ],
  "outputs": [
    {
      "id": "projected_center",
      "name": "Projected Center",
      "type": "vec2",
      "semantic_role": "position2d"
    },
    {
      "id": "projected_radius",
      "name": "Projected Radius",
      "type": "float"
    },
    {
      "id": "edge_distance",
      "name": "Screen Edge Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "visibility",
      "name": "Visible",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "parameters": [
    {
      "id": "radius",
      "name": "World Radius",
      "type": "float",
      "default": 1,
      "min": 0.001,
      "max": 20
    },
    {
      "id": "focal_length",
      "name": "Focal Length",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "near_plane",
      "name": "Near Plane",
      "type": "float",
      "default": 0.05,
      "min": 0.001,
      "max": 2
    }
  ],
  "helpers": "",
  "glsl_outputs": {
    "projected_center": "({center}.xy * {focal_length} / max({center}.z, {near_plane}))",
    "projected_radius": "({radius} * {focal_length} / max({center}.z, {near_plane}))",
    "edge_distance": "(length({uv} - ({center}.xy * {focal_length} / max({center}.z, {near_plane}))) - {radius} * {focal_length} / max({center}.z, {near_plane}))",
    "visibility": "step({near_plane}, {center}.z)"
  }
}
