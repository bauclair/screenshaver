{
  "schema_version": 1,
  "id": "screenshaver.geometry.projective_surface_mapping_3d",
  "name": "Projective Surface Mapping 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Projective Surface Mapping 3D",
  "uses": "Reusable mathematical geometry and field composition.",
  "notes": "Roman surface parametric map from antipodally identified sphere; unlike existing implicit Roman residual, outputs spatial points and local differential geometry. Not a regular immersion at singularities. Finite-difference normal and area scale; not a distance field. Validity indicates nondegenerate local tangent frame.",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv-vec2(0.5)"
    }
  ],
  "parameters": [
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 0.5,
      "min": 0.01,
      "max": 5
    },
    {
      "id": "rotation",
      "name": "Rotation",
      "type": "float",
      "default": 0,
      "min": -360,
      "max": 360
    }
  ],
  "outputs": [
    {
      "id": "point",
      "name": "Point",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "normal",
      "name": "Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    },
    {
      "id": "area_scale",
      "name": "Area Scale",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "validity",
      "name": "Validity",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerLprojective_surface_mapping_3d {vec3 point;vec3 normal;float area_scale;float validity;};\nvec3 maker_l_projective_surface_mapping_3d_point(vec2 p,float size,float rotation){float u=p.x*6.2831853+radians(rotation),v=p.y*3.14159265;vec3 n=vec3(cos(u)*cos(v),sin(u)*cos(v),sin(v));return size*vec3(n.y*n.z,n.z*n.x,n.x*n.y);}\nMakerLprojective_surface_mapping_3d maker_l_projective_surface_mapping_3d(vec2 position,float size,float rotation){\n if(any(isnan(position))||any(isinf(position)))return MakerLprojective_surface_mapping_3d(vec3(0),vec3(0),0.,0.);\n vec2 p=clamp(position,vec2(-8),vec2(8));float h=.001;\n vec3 q=maker_l_projective_surface_mapping_3d_point(p,size,rotation);vec3 a=(maker_l_projective_surface_mapping_3d_point(p+vec2(h,0),size,rotation)-maker_l_projective_surface_mapping_3d_point(p-vec2(h,0),size,rotation))/(2.*h);vec3 b=(maker_l_projective_surface_mapping_3d_point(p+vec2(0,h),size,rotation)-maker_l_projective_surface_mapping_3d_point(p-vec2(0,h),size,rotation))/(2.*h);vec3 n=cross(a,b);float m=length(n);return MakerLprojective_surface_mapping_3d(q,m>1e-7?n/m:vec3(0),m,step(1e-7,m));\n}",
  "glsl_outputs": {
    "point": "maker_l_projective_surface_mapping_3d({position},{size},{rotation}).point",
    "normal": "maker_l_projective_surface_mapping_3d({position},{size},{rotation}).normal",
    "area_scale": "maker_l_projective_surface_mapping_3d({position},{size},{rotation}).area_scale",
    "validity": "maker_l_projective_surface_mapping_3d({position},{size},{rotation}).validity"
  }
}
