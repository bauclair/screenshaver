{
  "schema_version": 1,
  "id": "screenshaver.geometry.torus_knot_link_field_3d",
  "name": "Torus Knot and Link Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Torus Knot and Link Field 3D",
  "uses": "Mathematical geometry and field composition.",
  "notes": "Polyline approximation to all gcd(p,q) distinct torus link components; segments per component, maximum 4096 segments total. Distance is to sampled segments minus tube radius, not exact analytical knot distance. Major radius should exceed minor radius for an embedded torus.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv-vec2(0.5),0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "winding_p",
      "name": "Winding P",
      "type": "float",
      "default": 2,
      "min": 1,
      "max": 8
    },
    {
      "id": "winding_q",
      "name": "Winding Q",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 8
    },
    {
      "id": "major_radius",
      "name": "Major Radius",
      "type": "float",
      "default": 0.35,
      "min": 0.01,
      "max": 10
    },
    {
      "id": "minor_radius",
      "name": "Minor Radius",
      "type": "float",
      "default": 0.14,
      "min": 0.001,
      "max": 5
    },
    {
      "id": "tube_radius",
      "name": "Tube Radius",
      "type": "float",
      "default": 0.025,
      "min": 0.001,
      "max": 2
    },
    {
      "id": "segments",
      "name": "Segments",
      "type": "float",
      "default": 128,
      "min": 32,
      "max": 512
    },
    {
      "id": "phase",
      "name": "Phase",
      "type": "float",
      "default": 0,
      "min": -6.283185,
      "max": 6.283185
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "centerline_distance",
      "name": "Centerline Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "nearest_point",
      "name": "Nearest Point",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "component_index",
      "name": "Component Index",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "curve_parameter",
      "name": "Curve Parameter",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "component_count",
      "name": "Component Count",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "interior_mask",
      "name": "Interior Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerTopology_torus_knot_link_field_3d {float distance; float centerline_distance; vec3 nearest_point; float component_index; float curve_parameter; float component_count; float interior_mask;};\nMakerTopology_torus_knot_link_field_3d maker_torus_knot_link_field_3d(vec3 position,vec3 center,float winding_p,float winding_q,float major_radius,float minor_radius,float tube_radius,float segments,float phase){\nvec3 x=position-center; int p=int(clamp(floor(winding_p+.5),1.,8.)),q=int(clamp(floor(winding_q+.5),1.,8.)); int a=p,b=q; for(int j=0;j<8;j++){if(b==0)break;int r=a%b;a=b;b=r;}int g=max(a,1);int pp=p/g,qq=q/g;int n=int(clamp(floor(segments+.5),32.,512.));float best=1e30,bt=0.,bi=0.;vec3 bp=vec3(0.);for(int k=0;k<8;k++){if(k>=g)break;float off=6.28318530718*float(k)/float(p);vec3 prev=vec3((major_radius+minor_radius*cos(off+phase)),0.,minor_radius*sin(off+phase));for(int j=1;j<=512;j++){if(j>n)break;float t=6.28318530718*float(j)/float(n);float u=float(pp)*t,v=float(qq)*t+off+phase;float r=major_radius+minor_radius*cos(v);vec3 next=vec3(r*cos(u),r*sin(u),minor_radius*sin(v));vec3 e=next-prev;float h=clamp(dot(x-prev,e)/max(dot(e,e),1e-20),0.,1.);vec3 hit=prev+h*e;float d=dot(x-hit,x-hit);if(d<best){best=d;bp=hit;bi=float(k);bt=(float(j-1)+h)/float(n);}prev=next;}}float d=sqrt(best);return MakerTopology_torus_knot_link_field_3d(d-tube_radius,d,bp+center,bi,bt,float(g),step(d,tube_radius));\n}",
  "glsl_outputs": {
    "distance": "maker_torus_knot_link_field_3d({position},{center},{winding_p},{winding_q},{major_radius},{minor_radius},{tube_radius},{segments},{phase}).distance",
    "centerline_distance": "maker_torus_knot_link_field_3d({position},{center},{winding_p},{winding_q},{major_radius},{minor_radius},{tube_radius},{segments},{phase}).centerline_distance",
    "nearest_point": "maker_torus_knot_link_field_3d({position},{center},{winding_p},{winding_q},{major_radius},{minor_radius},{tube_radius},{segments},{phase}).nearest_point",
    "component_index": "maker_torus_knot_link_field_3d({position},{center},{winding_p},{winding_q},{major_radius},{minor_radius},{tube_radius},{segments},{phase}).component_index",
    "curve_parameter": "maker_torus_knot_link_field_3d({position},{center},{winding_p},{winding_q},{major_radius},{minor_radius},{tube_radius},{segments},{phase}).curve_parameter",
    "component_count": "maker_torus_knot_link_field_3d({position},{center},{winding_p},{winding_q},{major_radius},{minor_radius},{tube_radius},{segments},{phase}).component_count",
    "interior_mask": "maker_torus_knot_link_field_3d({position},{center},{winding_p},{winding_q},{major_radius},{minor_radius},{tube_radius},{segments},{phase}).interior_mask"
  }
}
