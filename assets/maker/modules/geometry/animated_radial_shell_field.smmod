{
  "schema_version": 1,
  "id": "screenshaver.geometry.animated_radial_shell_field",
  "name": "Animated Radial Shell Field",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "description": "Concentric spherical shell signed-distance field and smooth band mask with animated radial phase.",
  "uses": "Generate reusable nested spherical shells for ray marching, procedural masks, and animated layered geometry.",
  "notes": "Independent implementation of radial periodic distance mathematics; does not reproduce the Controlled Explosions shader. The distance is a radial shell distance field; ray marching near the origin and rapidly animated phases may require conservative stepping.",
  "header_color": "#557C9C",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "semantic_role": "position3d",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Shell Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "mask",
      "name": "Band Mask",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "parameters": [
    {
      "id": "spacing",
      "name": "Shell Spacing",
      "type": "float",
      "default": 0.7,
      "min": 0.1,
      "max": 5.0
    },
    {
      "id": "thickness",
      "name": "Half Thickness",
      "type": "float",
      "default": 0.055,
      "min": 0.005,
      "max": 0.3
    },
    {
      "id": "phase",
      "name": "Radial Phase",
      "type": "float",
      "default": 0.0,
      "min": -10.0,
      "max": 10.0
    },
    {
      "id": "speed",
      "name": "Travel Speed",
      "type": "float",
      "default": 0.2,
      "min": -3.0,
      "max": 3.0
    },
    {
      "id": "edge",
      "name": "Mask Edge Width",
      "type": "float",
      "default": 0.025,
      "min": 0.001,
      "max": 0.2
    }
  ],
  "helpers": "float maker_radial_shell_distance(vec3 p, float spacing, float half_thickness, float phase) {\n    float period = max(spacing, 0.001);\n    float radius = length(p);\n    float nearest_shell = abs(mod(radius - phase + 0.5 * period, period) - 0.5 * period);\n    return nearest_shell - max(half_thickness, 0.0001);\n}",
  "glsl_outputs": {
    "distance": "maker_radial_shell_distance({position},{spacing},{thickness},{phase}+u_time*{speed})",
    "mask": "1.0-smoothstep(0.0,max({edge},0.0001),maker_radial_shell_distance({position},{spacing},{thickness},{phase}+u_time*{speed}))"
  }
}
