{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.geometry.domain_repeat_3d",
  "name": "3D Domain Repeat",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Evaluate an upstream field at repeating 3D coordinates.",
  "uses": "Reusable signed-distance geometry and procedural field composition.",
  "notes": "Position is evaluated at the active ray-march sample. No texture dependency.",
  "inputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "span_x",
      "name": "Span X",
      "type": "float",
      "default": 4.0,
      "min": 0.1,
      "max": 16.0
    },
    {
      "id": "span_y",
      "name": "Span Y",
      "type": "float",
      "default": 4.0,
      "min": 0.1,
      "max": 16.0
    },
    {
      "id": "span_z",
      "name": "Span Z",
      "type": "float",
      "default": 4.0,
      "min": 0.1,
      "max": 16.0
    }
  ],
  "helpers": "",
  "glsl": "{field}"
}
