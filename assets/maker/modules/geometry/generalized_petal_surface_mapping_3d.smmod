{
  "schema_version": 1,
  "id": "screenshaver.geometry.generalized_petal_surface_mapping_3d",
  "name": "Generalized Petal Surface Mapping 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#348F8B",
  "description": "Parametric petal with tapered envelope, longitudinal curl, transverse fold and twist; analytic tangent normal, not a distance field.",
  "uses": "Procedural botanical geometry and composition.",
  "notes": "Parametric petal with tapered envelope, longitudinal curl, transverse fold and twist; analytic tangent normal, not a distance field.",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv-vec2(0.5)"
    }
  ],
  "parameters": [
    {
      "id": "size",
      "name": "Size",
      "type": "float",
      "default": 1,
      "min": 0.01,
      "max": 5
    },
    {
      "id": "breadth",
      "name": "Breadth",
      "type": "float",
      "default": 0.35,
      "min": 0.02,
      "max": 1
    },
    {
      "id": "curl",
      "name": "Curl",
      "type": "float",
      "default": 0.5,
      "min": -2,
      "max": 2
    },
    {
      "id": "fold",
      "name": "Fold",
      "type": "float",
      "default": 0.2,
      "min": -1,
      "max": 1
    },
    {
      "id": "twist",
      "name": "Twist",
      "type": "float",
      "default": 0.6,
      "min": -6.28,
      "max": 6.28
    }
  ],
  "outputs": [
    {
      "id": "point",
      "name": "Point",
      "type": "vec3",
      "semantic_role": "position3d"
    },
    {
      "id": "normal",
      "name": "Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    },
    {
      "id": "area_scale",
      "name": "Area Scale",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "validity",
      "name": "Validity",
      "type": "float",
      "semantic_role": "mask"
    }
  ],
  "helpers": "struct MakerQ_generalized_petal_surface_mapping_3d {vec3 point;vec3 normal;float area_scale;float validity;};\nMakerQ_generalized_petal_surface_mapping_3d maker_q_generalized_petal_surface_mapping_3d(vec2 position,float size,float breadth,float curl,float fold,float twist){\nfloat u=clamp(position.x+.5,0.,1.),v=clamp(position.y*2.,-1.,1.);float b=breadth*sin(3.14159265*u),db=breadth*3.14159265*cos(3.14159265*u);float a=twist*u,c=cos(a),s=sin(a);float x=b*v,z=curl*u*u+fold*b*v*v;float xu=db*v,zu=2.*curl*u+fold*db*v*v;vec3 p=size*vec3(c*x-s*z,u,s*x+c*z);vec3 du=size*vec3(c*xu-s*zu-twist*(s*x+c*z),1.,s*xu+c*zu+twist*(c*x-s*z));vec3 dv=size*vec3(c*b-s*2.*fold*b*v,0.,s*b+c*2.*fold*b*v);vec3 n=cross(du,dv);float m=length(n);float valid=step(abs(position.x),.5)*step(abs(position.y),.5)*step(1e-7,m);return MakerQ_generalized_petal_surface_mapping_3d(p,m>1e-7?n/m:vec3(0),2.*m,valid);\n}",
  "glsl_outputs": {
    "point": "maker_q_generalized_petal_surface_mapping_3d({position},{size},{breadth},{curl},{fold},{twist}).point",
    "normal": "maker_q_generalized_petal_surface_mapping_3d({position},{size},{breadth},{curl},{fold},{twist}).normal",
    "area_scale": "maker_q_generalized_petal_surface_mapping_3d({position},{size},{breadth},{curl},{fold},{twist}).area_scale",
    "validity": "maker_q_generalized_petal_surface_mapping_3d({position},{size},{breadth},{curl},{fold},{twist}).validity"
  }
}
