{
  "schema_version": 1,
  "id": "screenshaver.geometry.rounded_box_distance_field_3d",
  "name": "Rounded Box Distance Field 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "description": "Preserve Extents caps rounding at the smallest half extent. Expand Extents adds rounding outside the box.",
  "uses": "Preserve Extents caps rounding at the smallest half extent. Expand Extents adds rounding outside the box.",
  "notes": "Preserve Extents caps rounding at the smallest half extent. Expand Extents adds rounding outside the box.",
  "header_color": "#527D94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "center",
      "name": "Center",
      "type": "vec3",
      "default": "vec3(0.0)"
    },
    {
      "id": "size_multiplier",
      "name": "Size Multiplier",
      "type": "float",
      "default": "1.0"
    },
    {
      "id": "radius_multiplier",
      "name": "Radius Multiplier",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Signed Distance",
      "type": "float",
      "semantic_role": "distance"
    },
    {
      "id": "exterior",
      "name": "Exterior Distance",
      "type": "float"
    },
    {
      "id": "depth",
      "name": "Interior Depth",
      "type": "float"
    },
    {
      "id": "inside",
      "name": "Interior Mask",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "surface_normal",
      "name": "Surface Normal",
      "type": "vec3",
      "semantic_role": "normal3d"
    }
  ],
  "parameters": [
    {
      "id": "x_extent",
      "name": "X Half Extent",
      "type": "float",
      "default": 0.5,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "y_extent",
      "name": "Y Half Extent",
      "type": "float",
      "default": 0.5,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "z_extent",
      "name": "Z Half Extent",
      "type": "float",
      "default": 0.5,
      "min": 0.001,
      "max": 100
    },
    {
      "id": "radius",
      "name": "Rounding Radius",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 100
    },
    {
      "id": "convention",
      "name": "Dimension Convention",
      "type": "choice",
      "default": 0,
      "options": [
        "Preserve Extents",
        "Expand Extents"
      ]
    }
  ],
  "helpers": "struct MakerB296RoundedBoxDistanceField3D {float distance;float exterior;float depth;float inside;vec3 surface_normal;};\nMakerB296RoundedBoxDistanceField3D maker_b296_rounded_box_distance_field_3d(vec3 position,vec3 center,float size_multiplier,float radius_multiplier,float x_extent,float y_extent,float z_extent,float radius,float convention){\nif((any(isnan(position))||any(isinf(position)))||(any(isnan(center))||any(isinf(center)))||(isnan(size_multiplier)||isinf(size_multiplier))||(isnan(radius_multiplier)||isinf(radius_multiplier))||(isnan(x_extent)||isinf(x_extent))||(isnan(y_extent)||isinf(y_extent))||(isnan(z_extent)||isinf(z_extent))||(isnan(radius)||isinf(radius))||(isnan(convention)||isinf(convention)))return MakerB296RoundedBoxDistanceField3D(0.0,0.0,0.0,0.0,vec3(0.0));\nvec3 b=vec3(x_extent,y_extent,z_extent)*clamp(size_multiplier,.0001,100.);float r=radius*clamp(radius_multiplier,0.,100.);if(convention<.5){r=min(r,min(b.x,min(b.y,b.z)));b-=r;}vec3 e=abs(clamp(position,-1e6,1e6)-clamp(center,-1e6,1e6))-b;float d=length(max(e,0.))+min(max(e.x,max(e.y,e.z)),0.)-r;vec3 q=clamp(position,-1e6,1e6)-clamp(center,-1e6,1e6);vec3 s=vec3(q.x<0.?-1.:1.,q.y<0.?-1.:1.,q.z<0.?-1.:1.);vec3 v=max(e,0.);vec3 normal=length(v)>1e-10?s*v/length(v):e.x>=e.y&&e.x>=e.z?vec3(s.x,0.,0.):e.y>=e.z?vec3(0.,s.y,0.):vec3(0.,0.,s.z);return MakerB296RoundedBoxDistanceField3D(d,max(d,0.),max(-d,0.),d<=0.?1.:0.,normal);\n}",
  "glsl_outputs": {
    "distance": "maker_b296_rounded_box_distance_field_3d({position},{center},{size_multiplier},{radius_multiplier},{x_extent},{y_extent},{z_extent},{radius},{convention}).distance",
    "exterior": "maker_b296_rounded_box_distance_field_3d({position},{center},{size_multiplier},{radius_multiplier},{x_extent},{y_extent},{z_extent},{radius},{convention}).exterior",
    "depth": "maker_b296_rounded_box_distance_field_3d({position},{center},{size_multiplier},{radius_multiplier},{x_extent},{y_extent},{z_extent},{radius},{convention}).depth",
    "inside": "maker_b296_rounded_box_distance_field_3d({position},{center},{size_multiplier},{radius_multiplier},{x_extent},{y_extent},{z_extent},{radius},{convention}).inside",
    "surface_normal": "maker_b296_rounded_box_distance_field_3d({position},{center},{size_multiplier},{radius_multiplier},{x_extent},{y_extent},{z_extent},{radius},{convention}).surface_normal"
  }
}
