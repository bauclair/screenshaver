{
  "schema_version": 1,
  "id": "screenshaver.geometry.dielectric_refraction_direction_3d",
  "name": "Dielectric Refraction Direction 3D",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "description": "Analytical Snell refraction and reflection at a dielectric interface.",
  "uses": "Analytical Snell refraction and reflection at a dielectric interface.",
  "notes": "Incident direction points toward interface; normal points outward in automatic mode. Forced modes select media explicitly. Invalid directions or normals return zero directions and zero TIR mask.",
  "header_color": "#477D9A",
  "terminal": false,
  "inputs": [
    {
      "id": "incident",
      "name": "Incident Direction",
      "type": "vec3",
      "semantic_role": "direction3d",
      "default": "normalize(vec3(maker_uv,1.0))"
    },
    {
      "id": "normal",
      "name": "Surface Normal",
      "type": "vec3",
      "semantic_role": "normal3d",
      "default": "vec3(0,0,-1)"
    }
  ],
  "outputs": [
    {
      "id": "refracted",
      "name": "Refracted Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    },
    {
      "id": "reflected",
      "name": "Reflected Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    },
    {
      "id": "tir",
      "name": "Total Internal Reflection Mask",
      "type": "float",
      "semantic_role": "mask"
    },
    {
      "id": "effective",
      "name": "Effective Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    }
  ],
  "parameters": [
    {
      "id": "exterior",
      "name": "Exterior Refractive Index",
      "type": "float",
      "default": 1,
      "min": 0.1,
      "max": 5
    },
    {
      "id": "interior",
      "name": "Interior Refractive Index",
      "type": "float",
      "default": 1.5,
      "min": 0.1,
      "max": 5
    },
    {
      "id": "mode",
      "name": "Interface Orientation Mode",
      "type": "choice",
      "default": 0,
      "options": [
        "Automatic",
        "Entering",
        "Exiting"
      ]
    }
  ],
  "helpers": "vec3 maker_dr3_unit(vec3 v){if(any(isnan(v))||any(isinf(v)))return vec3(0.0);float m=max(max(abs(v.x),abs(v.y)),abs(v.z));if(m==0.0)return vec3(0.0);v/=m;return v*inversesqrt(dot(v,v));}\nvec4 maker_dr3_eval(vec3 d,vec3 n,float ext,float interior,float mode){d=maker_dr3_unit(d);n=maker_dr3_unit(n);if(dot(d,d)==0.0||dot(n,n)==0.0)return vec4(0.0);bool entering=mode<0.5?dot(d,n)<=0.0:mode<1.5; if(dot(d,n)>0.0)n=-n;float eta=entering?ext/interior:interior/ext;float c=clamp(-dot(d,n),0.0,1.0);float k=1.0-eta*eta*(1.0-c*c);if(k<0.0)return vec4(0.0,0.0,0.0,1.0);return vec4(maker_dr3_unit(eta*d+(eta*c-sqrt(k))*n),0.0);}\nvec3 maker_dr3_reflect(vec3 d,vec3 n){d=maker_dr3_unit(d);n=maker_dr3_unit(n);if(dot(n,n)==0.0)return vec3(0.0);return reflect(d,n);}\nvec3 maker_dr3_effective(vec3 d,vec3 n,float a,float b,float m){vec4 r=maker_dr3_eval(d,n,a,b,m);return r.w>0.5?maker_dr3_reflect(d,n):r.xyz;}",
  "glsl_outputs": {
    "refracted": "maker_dr3_eval({incident},{normal},{exterior},{interior},{mode}).xyz",
    "reflected": "maker_dr3_reflect({incident},{normal})",
    "tir": "maker_dr3_eval({incident},{normal},{exterior},{interior},{mode}).w",
    "effective": "maker_dr3_effective({incident},{normal},{exterior},{interior},{mode})"
  }
}
