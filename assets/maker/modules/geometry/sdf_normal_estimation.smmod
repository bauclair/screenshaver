{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.geometry.sdf_normal_estimation",
  "name": "SDF Normal Estimation",
  "category": "Geometry",
  "header_color": "#557C9C",
  "description": "Estimate a surface normal with central or tetrahedral callable field samples.",
  "uses": "Connect a callable SDF field; supply the surface position to estimate its normal.",
  "notes": "Finite-difference central gradient. A callable connection is required; no field is evaluated until the consumer samples it. Tetrahedral uses four unit-direction offsets; central uses six. Degenerate gradients use +Z.",
  "inputs": [
    {
      "id": "field",
      "name": "Field 3D",
      "type": "field3d"
    },
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "position3d"
    }
  ],
  "outputs": [
    {
      "id": "normal",
      "name": "Normal",
      "type": "vec3"
    }
  ],
  "parameters": [
    {
      "id": "epsilon",
      "name": "Epsilon",
      "type": "float",
      "default": 0.003,
      "min": 0.0001,
      "max": 0.1
    },
    {
      "id": "estimation_method",
      "name": "Estimation Method",
      "type": "choice",
      "default": 0,
      "options": [
        "Central",
        "Tetrahedral"
      ]
    }
  ],
  "helpers": "vec3 maker_safe_sdf_normal(vec3 g){float l=length(g);return l>1e-12?g/l:vec3(0.0,0.0,1.0);}",
  "glsl": "maker_safe_sdf_normal({estimation_method}<0.5?vec3({field}({position}+vec3({epsilon},0.0,0.0))-{field}({position}-vec3({epsilon},0.0,0.0)),{field}({position}+vec3(0.0,{epsilon},0.0))-{field}({position}-vec3(0.0,{epsilon},0.0)),{field}({position}+vec3(0.0,0.0,{epsilon}))-{field}({position}-vec3(0.0,0.0,{epsilon}))):(vec3(1.0,1.0,1.0)*{field}({position}+{epsilon}*0.57735026919*vec3(1.0,1.0,1.0))+vec3(1.0,-1.0,-1.0)*{field}({position}+{epsilon}*0.57735026919*vec3(1.0,-1.0,-1.0))+vec3(-1.0,1.0,-1.0)*{field}({position}+{epsilon}*0.57735026919*vec3(-1.0,1.0,-1.0))+vec3(-1.0,-1.0,1.0)*{field}({position}+{epsilon}*0.57735026919*vec3(-1.0,-1.0,1.0))))"
}
