{
  "schema_version": 1,
  "id": "screenshaver.geometry.finite_cube_cluster_field",
  "name": "Finite Cube Cluster Field",
  "category": "Geometry",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#557C9C",
  "description": "Signed distance to a bounded three-dimensional lattice of boxes, with externally controlled size modulation.",
  "uses": "Finite block assemblies, cube sculptures, structured SDF scenes and animated grid forms.",
  "notes": "Independently designed. Up to four cubes per axis (64 box evaluations per sample). Size Modulation is a scalar applied uniformly to the box half-size for this evaluation; the graph does not automatically evaluate a connected oscillator separately for each cube. This is an approximate box SDF using the standard exact box distance expression.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "size_modulation",
      "name": "Size Modulation",
      "type": "float",
      "default": "1.0"
    }
  ],
  "outputs": [
    {
      "id": "distance",
      "name": "Distance",
      "type": "float",
      "semantic_role": "distance"
    }
  ],
  "parameters": [
    {
      "id": "count_x",
      "name": "Count X",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 4
    },
    {
      "id": "count_y",
      "name": "Count Y",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 4
    },
    {
      "id": "count_z",
      "name": "Count Z",
      "type": "float",
      "default": 3,
      "min": 1,
      "max": 4
    },
    {
      "id": "spacing",
      "name": "Spacing",
      "type": "float",
      "default": 1.25,
      "min": 0.1,
      "max": 8
    },
    {
      "id": "half_size",
      "name": "Base Half-Size",
      "type": "float",
      "default": 0.4,
      "min": 0.01,
      "max": 3
    },
    {
      "id": "size_variation",
      "name": "Cell Size Variation",
      "type": "float",
      "default": 0.12,
      "min": 0,
      "max": 0.75
    }
  ],
  "helpers": "float maker_finite_cube_cluster_field(vec3 p,float modulation,float nx,float ny,float nz,float spacing,float halfSize,float variation){\n int cx=clamp(int(floor(nx+0.5)),1,4),cy=clamp(int(floor(ny+0.5)),1,4),cz=clamp(int(floor(nz+0.5)),1,4);\n float gap=max(spacing,0.1),base=max(halfSize,0.01)*clamp(modulation,0.05,3.0);\n float result=1e6;\n for(int x=0;x<4;x++){if(x>=cx)break;\n  for(int y=0;y<4;y++){if(y>=cy)break;\n   for(int z=0;z<4;z++){if(z>=cz)break;\n    vec3 index=vec3(float(x),float(y),float(z));\n    vec3 center=(index-0.5*(vec3(float(cx),float(cy),float(cz))-1.0))*gap;\n    float variationSignal=sin(dot(index,vec3(1.17,2.31,3.73)));\n    float radius=max(0.005,base*(1.0+clamp(variation,0.0,0.75)*variationSignal));\n    vec3 q=abs(p-center)-vec3(radius);\n    float d=length(max(q,vec3(0.0)))+min(max(q.x,max(q.y,q.z)),0.0);\n    result=min(result,d);\n   }\n  }\n }\n return result;\n}",
  "glsl": "maker_finite_cube_cluster_field({position},{size_modulation},{count_x},{count_y},{count_z},{spacing},{half_size},{size_variation})",
  "terminal": false
}
