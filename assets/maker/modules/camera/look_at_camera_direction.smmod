{
  "schema_version": 1,
  "id": "screenshaver.camera.look_at_camera_direction",
  "name": "Look-at Camera Direction",
  "category": "Camera",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#5678A1",
  "description": "World-space camera ray direction constructed from eye, target, up and screen coordinates.",
  "uses": "Ray directions for procedural camera movement and 3D ray-based effects.",
  "notes": "Independently designed. UV is interpreted in the range 0..1. Handles degenerate eye-target and up-axis alignment with deterministic fallbacks. FOV is in degrees. Default UV now uses normalized framebuffer coordinates, matching the documented 0..1 range. Eye Position is available for SDF Ray March Ray Origin.",
  "inputs": [
    {
      "id": "eye",
      "name": "Eye",
      "type": "vec3",
      "default": "vec3(0.0,0.0,5.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "target",
      "name": "Target",
      "type": "vec3",
      "default": "vec3(0.0)",
      "semantic_role": "position3d"
    },
    {
      "id": "up",
      "name": "Up",
      "type": "vec3",
      "default": "vec3(0.0,1.0,0.0)",
      "semantic_role": "direction3d"
    },
    {
      "id": "uv",
      "name": "UV",
      "type": "vec2",
      "default": "gl_FragCoord.xy/max(u_resolution,vec2(1.0))",
      "semantic_role": "uv"
    }
  ],
  "outputs": [
    {
      "id": "direction",
      "name": "Direction",
      "type": "vec3",
      "semantic_role": "direction3d"
    },
    {
      "id": "eye_position",
      "name": "Eye Position",
      "type": "vec3",
      "semantic_role": "position3d"
    }
  ],
  "parameters": [
    {
      "id": "fov",
      "name": "Vertical FOV (degrees)",
      "type": "float",
      "default": 60,
      "min": 5,
      "max": 150
    },
    {
      "id": "aspect",
      "name": "Aspect Ratio",
      "type": "float",
      "default": 1.7777778,
      "min": 0.25,
      "max": 4
    }
  ],
  "helpers": "vec3 maker_look_at_camera_direction(vec3 eye,vec3 target,vec3 up,vec2 uv,float fov,float aspect){\n vec3 forward=target-eye;\n if(dot(forward,forward)<1e-10)forward=vec3(0.0,0.0,-1.0);\n forward=normalize(forward);\n vec3 upDir=dot(up,up)>1e-10?normalize(up):vec3(0.0,1.0,0.0);\n if(abs(dot(forward,upDir))>0.999)upDir=abs(forward.y)<0.9?vec3(0.0,1.0,0.0):vec3(1.0,0.0,0.0);\n vec3 right=normalize(cross(forward,upDir));\n vec3 cameraUp=cross(right,forward);\n float lens=tan(radians(clamp(fov,5.0,150.0))*0.5);\n vec2 screen=(uv*2.0-1.0)*vec2(clamp(aspect,0.25,4.0),1.0)*lens;\n return normalize(forward+right*screen.x+cameraUp*screen.y);\n}",
  "terminal": false,
  "glsl_outputs": {
    "direction": "maker_look_at_camera_direction({eye},{target},{up},{uv},{fov},{aspect})",
    "eye_position": "{eye}"
  }
}
