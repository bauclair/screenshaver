{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "terminal": false,
  "id": "screenshaver.noise.triangular_lattice_field",
  "name": "Triangular Lattice Field",
  "category": "Noise",
  "header_color": "#763699",
  "description": "Continuous piecewise-linear value field interpolated over equilateral triangular cells.",
  "uses": "Faceted terrain height fields, low-poly textures, and deterministic geometric variation.",
  "notes": "Independent equilateral lattice implementation. Seed is converted to a nonnegative integer; changing it changes vertex values.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "default": "maker_uv"
    }
  ],
  "outputs": [
    {
      "id": "field",
      "name": "Field",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 6.0,
      "min": 0.1,
      "max": 40.0
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 10000.0
    }
  ],
  "helpers": "// Equilateral triangular lattice: inverse basis of (1,0), (1/2,sqrt(3)/2).\nvec2 maker_tri_grid(vec2 p){return vec2(p.x-0.577350269189626*p.y,1.154700538379252*p.y);}\nvec3 maker_tri_weights(vec2 f){return (f.x+f.y<=1.0)?vec3(1.0-f.x-f.y,f.x,f.y):vec3(f.x+f.y-1.0,1.0-f.x,1.0-f.y);}\nuint maker_tri_hash(ivec2 cell,uint seed){uvec2 q=uvec2(cell);uint h=(q.x*0x9e3779b9u)^(q.y*0x85ebca6bu)^seed;h^=h>>16;h*=0x7feb352du;h^=h>>15;h*=0x846ca68bu;h^=h>>16;return h;}\nfloat maker_tri_vertex(ivec2 cell,uint seed){return float(maker_tri_hash(cell,seed)&0x00ffffffu)*(1.0/16777215.0);}\nfloat maker_tri_field(vec2 p,float scale,float seed){vec2 q=maker_tri_grid(p*max(scale,0.0001));ivec2 cell=ivec2(floor(q));vec2 f=fract(q);uint s=uint(max(seed,0.0));vec3 w=maker_tri_weights(f);if(f.x+f.y<=1.0){return dot(w,vec3(maker_tri_vertex(cell,s),maker_tri_vertex(cell+ivec2(1,0),s),maker_tri_vertex(cell+ivec2(0,1),s)));}return dot(w,vec3(maker_tri_vertex(cell+ivec2(1,1),s),maker_tri_vertex(cell+ivec2(0,1),s),maker_tri_vertex(cell+ivec2(1,0),s)));}\n",
  "glsl": "maker_tri_field({position},{scale},{seed})"
}
