{
  "schema_version": 1,
  "id": "screenshaver.noise.dot3d",
  "name": "3D Dot Noise",
  "category": "Noise",
  "created_by": "Screenshaver",
  "creator_email": "screenshaver@proton.me",
  "header_color": "#6D729A",
  "description": "Smooth 3D lattice value noise from independently chosen integer-coordinate hashing.",
  "uses": "Reusable scalar field detail and procedural modulation.",
  "notes": "Uses integer-coordinate hashing and smooth 3D lattice interpolation.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "value",
      "name": "Value",
      "type": "float"
    }
  ],
  "parameters": [],
  "helpers": "float maker_lattice_hash3(vec3 cell){\n  vec3 v=fract(cell*vec3(0.1031,0.11369,0.13787));\n  v+=dot(v,v.yxz+19.19);\n  return fract((v.x+v.y)*v.z);\n}\nfloat maker_lattice_noise3(vec3 p){\n  vec3 base=floor(p);\n  vec3 w=fract(p);\n  w=w*w*(3.0-2.0*w);\n  float x00=mix(maker_lattice_hash3(base),maker_lattice_hash3(base+vec3(1,0,0)),w.x);\n  float x10=mix(maker_lattice_hash3(base+vec3(0,1,0)),maker_lattice_hash3(base+vec3(1,1,0)),w.x);\n  float x01=mix(maker_lattice_hash3(base+vec3(0,0,1)),maker_lattice_hash3(base+vec3(1,0,1)),w.x);\n  float x11=mix(maker_lattice_hash3(base+vec3(0,1,1)),maker_lattice_hash3(base+vec3(1,1,1)),w.x);\n  return mix(mix(x00,x10,w.y),mix(x01,x11,w.y),w.z);\n}",
  "glsl": "maker_lattice_noise3({position})",
  "terminal": false
}
