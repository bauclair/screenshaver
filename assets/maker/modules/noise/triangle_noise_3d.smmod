{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.noise.triangle3d",
  "name": "Triangle Noise 3D",
  "category": "Noise",
  "header_color": "#8165A6",
  "description": "Nested triangle-wave surface perturbation adapted from Abstract Corridor.",
  "uses": "Angular rocky displacement, inexpensive geometric roughness.",
  "notes": "The input is a sample position, not a callable field. Ray-marching requires compiler support for repeated evaluation at sample positions.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "value",
      "name": "Value",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 8
    },
    {
      "id": "strength",
      "name": "Strength",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 3
    }
  ],
  "helpers": "vec3 maker_corridor_tri(vec3 x){return abs(x-floor(x)-0.5);}",
  "glsl": "(dot(maker_corridor_tri({position}*{scale}*0.5+maker_corridor_tri({position}*{scale}*0.25).yzx),vec3(0.666))*{strength})"
}
