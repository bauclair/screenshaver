{
  "schema_version": 1,
  "created_by": "Screenshaver",
  "terminal": false,
  "id": "screenshaver.noise.triangle3d",
  "name": "Triangle Noise 3D",
  "category": "Noise",
  "header_color": "#8165A6",
  "description": "Independent layered triangular-wave signal for inexpensive faceted 3D patterns.",
  "uses": "Angular rocky displacement, inexpensive geometric roughness.",
  "notes": "Replaces nested triangle-wave expression attributed to Abstract Corridor. This is deterministic periodic geometry rather than stochastic noise.",
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec3",
      "default": "vec3(maker_uv,0.0)"
    }
  ],
  "outputs": [
    {
      "id": "value",
      "name": "Value",
      "type": "float"
    }
  ],
  "parameters": [
    {
      "id": "scale",
      "name": "Scale",
      "type": "float",
      "default": 1,
      "min": 0.05,
      "max": 8
    },
    {
      "id": "strength",
      "name": "Strength",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 3
    }
  ],
  "helpers": "float maker_triangle_wave(float x){return 1.0-abs(2.0*fract(x)-1.0);}\nfloat maker_triangle_field(vec3 p,float scale,float strength){vec3 q=p*scale;float a=maker_triangle_wave(q.x+0.31*q.z);float b=maker_triangle_wave(q.y-0.27*q.x);float c=maker_triangle_wave(q.z+0.43*q.y);return strength*(a*b+b*c+c*a)/3.0;}",
  "glsl": "maker_triangle_field({position},{scale},{strength})"
}
