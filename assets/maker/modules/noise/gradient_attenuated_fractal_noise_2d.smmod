{
  "schema_version": 1,
  "id": "screenshaver.noise.gradient_attenuated_fractal_noise_2d",
  "name": "Gradient-Attenuated Fractal Noise 2D",
  "category": "Noise",
  "created_by": "Screenshaver",
  "description": "Bounded fractal gradient noise with slope-dependent octave weighting.",
  "uses": "Bounded fractal gradient noise with slope-dependent octave weighting.",
  "notes": "Accumulated gradient is the amplitude-weighted sum of octave gradients in input coordinates, not the derivative of the final attenuated field. Attenuation is amplitude-weighted mean. Rotation speed is degrees per second; octave rotation is degrees. Frequency capped at 4096.",
  "header_color": "#398F94",
  "terminal": false,
  "inputs": [
    {
      "id": "position",
      "name": "Position",
      "type": "vec2",
      "semantic_role": "position2d",
      "default": "maker_uv"
    },
    {
      "id": "time_offset",
      "name": "Time Offset",
      "type": "float",
      "semantic_role": "time",
      "default": "0.0"
    }
  ],
  "outputs": [
    {
      "id": "signed_noise",
      "name": "Signed Noise",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "normalized_noise",
      "name": "Normalized Noise",
      "type": "float",
      "semantic_role": "intensity"
    },
    {
      "id": "magnitude",
      "name": "Accumulated Gradient Magnitude",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "attenuation",
      "name": "Attenuation",
      "type": "float",
      "semantic_role": ""
    },
    {
      "id": "gradient",
      "name": "Accumulated Gradient",
      "type": "vec2",
      "semantic_role": ""
    }
  ],
  "parameters": [
    {
      "id": "frequency",
      "name": "Frequency",
      "type": "float",
      "default": 3,
      "min": 0.01,
      "max": 100
    },
    {
      "id": "amplitude",
      "name": "Amplitude",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 8
    },
    {
      "id": "octaves",
      "name": "Octaves",
      "type": "float",
      "default": 4,
      "min": 1,
      "max": 8
    },
    {
      "id": "lacunarity",
      "name": "Lacunarity",
      "type": "float",
      "default": 2,
      "min": 1,
      "max": 4
    },
    {
      "id": "persistence",
      "name": "Persistence",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "rotation",
      "name": "Octave Rotation",
      "type": "float",
      "default": 30,
      "min": -180,
      "max": 180
    },
    {
      "id": "attenuation",
      "name": "Gradient Attenuation",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 16
    },
    {
      "id": "seed",
      "name": "Seed",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 65535
    },
    {
      "id": "speed",
      "name": "Animation Speed",
      "type": "float",
      "default": 15,
      "min": -360,
      "max": 360
    }
  ],
  "helpers": "uint maker_gafn2_hash(uint x){x ^= x >> 16u; x *= 0x7feb352du; x ^= x >> 15u; x *= 0x846ca68bu; return x ^ (x >> 16u);}\nvec2 maker_gafn2_grad(ivec2 c,uint seed,float phase){uint h=maker_gafn2_hash(uint(c.x)^maker_gafn2_hash(uint(c.y)^seed));float a=float(h & 65535u)*0.00009587379924+phase;return vec2(cos(a),sin(a));}\nvec3 maker_gafn2_eval(vec2 p,float t,float freq,float amp,float seed,float speed,float phase,float mode){\n if(any(isnan(p))||any(isinf(p))||isnan(t)||isinf(t)) return vec3(0.0);\n vec2 q=mod(clamp(p,vec2(-1e8),vec2(1e8))*freq,65536.0); ivec2 c=ivec2(floor(q));vec2 f=fract(q);\n vec2 w=mode<0.5?f*f*(3.0-2.0*f):f*f*f*(f*(6.0*f-15.0)+10.0);\n vec2 dw=mode<0.5?6.0*f*(1.0-f):30.0*f*f*(f-1.0)*(f-1.0);\n float a=radians(mod(clamp(t,-1e8,1e8)*speed+phase,360.0));uint s=uint(clamp(seed,0.0,65535.0));\n vec2 g0=maker_gafn2_grad(c,s,a),g1=maker_gafn2_grad((c+ivec2(1,0))%65536,s,a),g2=maker_gafn2_grad((c+ivec2(0,1))%65536,s,a),g3=maker_gafn2_grad((c+ivec2(1,1))%65536,s,a);\n float v0=dot(g0,f),v1=dot(g1,f-vec2(1,0)),v2=dot(g2,f-vec2(0,1)),v3=dot(g3,f-vec2(1));\n float lo=mix(v0,v1,w.x),hi=mix(v2,v3,w.x);\n vec2 dlo=mix(g0,g1,w.x)+vec2((v1-v0)*dw.x,0),dhi=mix(g2,g3,w.x)+vec2((v3-v2)*dw.x,0);\n vec2 grad=(mix(dlo,dhi,w.y)+vec2(0,(hi-lo)*dw.y))*freq;\n if(abs(p.x)>1e8) grad.x=0.0;if(abs(p.y)>1e8) grad.y=0.0;\n return vec3(mix(lo,hi,w.y),grad)*amp*0.70710678118;\n}\nvec4 maker_gafn2_fractal(vec2 p,float t,float freq,float amp,float oct,float lac,float pers,float angle,float k,float seed,float speed){\n if(any(isnan(p))||any(isinf(p))||isnan(t)||isinf(t))return vec4(0.0);\n p=clamp(p,vec2(-1e6),vec2(1e6)); float a=1.0,h=0.0,total=0.0,att=0.0;vec2 g=vec2(0.0);float theta=radians(angle);mat2 R=mat2(cos(theta),sin(theta),-sin(theta),cos(theta)),M=mat2(1.0);float f=freq;\n for(int i=0;i<8;++i){if(i>=int(clamp(floor(oct+0.5),1.0,8.0)))break;\n vec3 n=maker_gafn2_eval(M*p,t,f,1.0,mod(seed+float(i)*101.0,65536.0),speed,0.0,1.0);\n g+=a*transpose(M)*n.yz;float w=1.0/(1.0+k*dot(g,g));h+=a*n.x*w;att+=a*w;total+=a;a*=pers;f=min(f*lac,4096.0);M=R*M;}\n return vec4(amp*h/max(total,1e-6),g,att/max(total,1e-6));\n}",
  "glsl_outputs": {
    "signed_noise": "maker_gafn2_fractal({position},u_time+{time_offset},{frequency},{amplitude},{octaves},{lacunarity},{persistence},{rotation},{attenuation},{seed},{speed}).x",
    "normalized_noise": "clamp(0.5+0.5*maker_gafn2_fractal({position},u_time+{time_offset},{frequency},{amplitude},{octaves},{lacunarity},{persistence},{rotation},{attenuation},{seed},{speed}).x,0.0,1.0)",
    "magnitude": "length(maker_gafn2_fractal({position},u_time+{time_offset},{frequency},{amplitude},{octaves},{lacunarity},{persistence},{rotation},{attenuation},{seed},{speed}).yz)",
    "attenuation": "maker_gafn2_fractal({position},u_time+{time_offset},{frequency},{amplitude},{octaves},{lacunarity},{persistence},{rotation},{attenuation},{seed},{speed}).w",
    "gradient": "maker_gafn2_fractal({position},u_time+{time_offset},{frequency},{amplitude},{octaves},{lacunarity},{persistence},{rotation},{attenuation},{seed},{speed}).yz"
  }
}
